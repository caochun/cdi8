{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdi8.cn/contracts/shot-run.schema.json",
  "title": "GXLF shot run",
  "description": "One experiment run context, evidence and result. It does not describe facility topology or device state machines.",
  "type": "object",
  "required": ["schema_version", "run_id", "shot_id", "facility_definition", "facility_binding", "state_projection", "stage", "resource_selection", "evidence"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "recipe": {"type": "object", "required": ["ref", "version"], "properties": {"ref": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameters_ref": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "facility_definition": {"const": "gxlf-facility"},
    "facility_binding": {"const": "gxlf-facility-binding"},
    "state_projection": {"const": "gxlf-facility-state"},
    "stage": {"enum": ["created", "resources_reserved", "initializing", "initialized", "parameters_receiving", "parameters_received", "preparing", "prepared", "charging", "triggering", "emission_confirmed", "postprocessing", "completed", "failed", "cancelled"]},
    "resource_selection": {"type": "object", "required": ["beamlines", "source_selection"], "properties": {"beamlines": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 60}, "minItems": 1, "uniqueItems": true}, "source_selection": {"type": "object", "required": ["default_source", "shg_beamlines"], "properties": {"default_source": {"const": "seed"}, "shg_beamlines": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 8}, "uniqueItems": true}}, "additionalProperties": false}}, "additionalProperties": false},
    "reservation": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["requested", "held", "released", "lost"]}, "lease_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["kind", "ref", "created_at"], "properties": {"kind": {"enum": ["parameters", "device-data", "diagnostic-data", "measurement-data", "trigger-result", "postprocess-result"]}, "ref": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "additionalProperties": false}},
    "failure": {"type": ["object", "null"], "properties": {"code": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "detected_at": {"type": "string", "format": "date-time"}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "$defs": {"evidence": {"type": "object", "required": ["id", "kind", "status", "observed_at"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}, "kind": {"enum": ["facility-fact", "guard", "command-accepted", "command-result", "device-observation", "service-health", "interlock", "timing", "manual-confirmation"]}, "status": {"enum": ["accepted", "succeeded", "failed", "unknown", "stale", "invalidated"]}, "operation": {"type": "string", "minLength": 1}, "fact": {"type": "string", "minLength": 1}, "guard": {"type": "string", "minLength": 1}, "device_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "state_revision": {"type": "integer", "minimum": 0}, "observed_at": {"type": "string", "format": "date-time"}, "details": {"type": "object"}}, "additionalProperties": false}},
  "allOf": [{"if": {"properties": {"stage": {"enum": ["failed", "cancelled"]}}}, "then": {"required": ["failure"]}}, {"if": {"properties": {"reservation": {"type": "object"}}}, "then": {"properties": {"reservation": {"if": {"properties": {"status": {"const": "held"}}}, "then": {"required": ["lease_id", "owner", "expires_at"]}}}}}],
  "additionalProperties": false
}
