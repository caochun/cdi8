          <bpmn:documentation>只消费最终结果；accepted/executing 不结束等待。实例局部变量隔离；runId/nodeId/instanceId/taskId 关联及幂等由适配层实现。</bpmn:documentation>
        </bpmn:receiveTask>
        <bpmn:serviceTask id="compensation_validate" name="校验任务、观测状态及完成条件" />
        <bpmn:exclusiveGateway id="compensation_ok" name="本实例验证成功？" default="Flow_222" />
        <bpmn:endEvent id="compensation_done" name="本实例成功" />
        <bpmn:endEvent id="compensation_error" name="本实例失败">
          <bpmn:errorEventDefinition errorRef="ActionFailed" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_217" sourceRef="compensation_start" targetRef="compensation_send" />
        <bpmn:sequenceFlow id="Flow_218" sourceRef="compensation_send" targetRef="compensation_wait" />
        <bpmn:sequenceFlow id="Flow_219" sourceRef="compensation_wait" targetRef="compensation_validate" />
        <bpmn:sequenceFlow id="Flow_220" sourceRef="compensation_validate" targetRef="compensation_ok" />
        <bpmn:sequenceFlow id="Flow_221" sourceRef="compensation_ok" targetRef="compensation_done" name="是">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resultValid = true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_222" sourceRef="compensation_ok" targetRef="compensation_error" name="否" />
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">4</bpmn:loopCardinality>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:subProcess>
      <bpmn:serviceTask id="clear_compensation_flag" name="清除待补偿标记，保留实验失败及联锁记录" />
      <bpmn:endEvent id="interlock_end" name="安全回退完成；实验仍失败" />
      <bpmn:boundaryEvent id="compensation_boundary_error" name="补偿失败" attachedToRef="compensate_serial" cancelActivity="true">
        <bpmn:errorEventDefinition errorRef="ActionFailed" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="retain_compensation" name="保留待补偿标记及已完成记录" />
      <bpmn:userTask id="compensation_attention" name="人工处理并决定再次补偿" />
      <bpmn:sequenceFlow id="Flow_223" sourceRef="interlock_received" targetRef="latch_interlock" />
      <bpmn:sequenceFlow id="Flow_224" sourceRef="latch_interlock" targetRef="request_compensation" />
      <bpmn:sequenceFlow id="Flow_225" sourceRef="request_compensation" targetRef="compensate_serial" />
      <bpmn:sequenceFlow id="Flow_226" sourceRef="compensate_serial" targetRef="clear_compensation_flag" />
      <bpmn:sequenceFlow id="Flow_227" sourceRef="clear_compensation_flag" targetRef="interlock_end" />
      <bpmn:sequenceFlow id="Flow_228" sourceRef="compensation_boundary_error" targetRef="retain_compensation" />
      <bpmn:sequenceFlow id="Flow_229" sourceRef="retain_compensation" targetRef="compensation_attention" />
      <bpmn:sequenceFlow id="Flow_230" sourceRef="compensation_attention" targetRef="request_compensation" />
    </bpmn:subProcess>
  </bpmn:process>
