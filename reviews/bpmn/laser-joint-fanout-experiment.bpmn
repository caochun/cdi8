      <bpmn:errorEventDefinition errorRef="ActionFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_216" sourceRef="gate_error" targetRef="record_failure" />
    <bpmn:subProcess id="interlock_handler" name="全局联锁：中断当前实验并等待补偿" triggeredByEvent="true">
      <bpmn:documentation>仅覆盖 BPMN 流程存活期间的联锁。Python 在 failed/succeeded 后也可触发联锁；部署时需要独立设备安全管理流程承接，不应复活已结束流程。</bpmn:documentation>
      <bpmn:startEvent id="interlock_received" name="收到本 runId 联锁消息" isInterrupting="true">
        <bpmn:messageEventDefinition messageRef="InterlockMessage" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="latch_interlock" name="锁定联锁、记录实验失败并中止活动任务" />
      <bpmn:userTask id="request_compensation" name="操作员确认原因解除与复位证据，发起补偿" />
      <bpmn:subProcess id="compensate_serial" name="按优先级逐实例执行安全复位">
        <bpmn:documentation>按 priority 稳定排序：seed_01、seed_02、seed_03、shg_01，当前两个策略 priority 均为 1。每个动作等待并校验安全复位证据，失败停止后续补偿；不采用 BPMN 自动补偿事件。</bpmn:documentation>
        <bpmn:startEvent id="compensation_start" name="开始" />
        <bpmn:serviceTask id="compensation_send" name="下发 Tango Command，登记 taskId">
          <bpmn:documentation>检查并发送 abort_reset；命令拒绝映射为 ACTION_FAILED。接收成功只代表 accepted。adapter 必须先登记关联并缓存早到反馈。</bpmn:documentation>
