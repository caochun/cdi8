  </dependencies>
  <build>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><workingDirectory>${project.basedir}/..</workingDirectory></configuration></plugin></plugins>
