<?xml version="1.0" encoding="UTF-8"?>
<!--
  泵浦分系统：父状态严格映射状态表 E 列，子状态映射 D 列。
  单一活动叶状态；内部确认事件驱动；保留失败重试、自环、资格撤销、异常恢复和关机闭环。
  请求不会直接当作设备已完成；外部业务条件在流程层检查。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="notReady">
  <state id="notReady" initial="unchecked">
    <state id="unchecked">
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="powerOnOk">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="checkFailed">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="shutdownNormal">
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="power-check.invalidated" target="unchecked" type="internal" />
  </state>
  <state id="ready" initial="functionReady">
    <state id="functionReady">
      <transition event="configuration.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="parameterOk">
      <transition event="configuration.requested" target="functionReady" />
      <transition event="pump.emission-prepare.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="configuration.reconfiguration-accepted" target="functionReady" />
      <transition event="pump.emission-prepare.completed" target="emissionPrepared" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="resetReady">
      <transition event="function-check.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="emissionPrepared">
      <transition event="pump.charge-prepare.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.charge-prepare.completed" target="chargePrepared" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="dataCollected">
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="standbyReady">
      <transition event="function-check.requested" />
      <transition event="configuration.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" type="internal" />
  </state>
  <state id="chargeCapable" initial="chargePrepared">
    <state id="chargePrepared">
      <transition event="pump.charge.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.charge.started" target="chargingActive" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" />
  </state>
  <state id="charging" initial="chargingActive">
    <state id="chargingActive">
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.charge.completed" target="chargeComplete" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="pump.protection.completed" target="resetReady" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="faultLock" />
    <transition event="power-check.invalidated" target="faultLock" />
    <transition event="configuration.invalidated" target="faultLock" />
  </state>
  <state id="charged" initial="chargeComplete">
    <state id="chargeComplete">
      <transition event="pump.trigger-prepare.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.trigger-prepare.completed" target="triggerReady" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="pump.protection.completed" target="resetReady" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="faultLock" />
    <transition event="power-check.invalidated" target="faultLock" />
    <transition event="configuration.invalidated" target="faultLock" />
  </state>
  <state id="armed" initial="triggerReady">
    <state id="triggerReady">
      <transition event="pump.data-collection.requested" />
      <transition event="pump.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="pump.data-collection.completed" target="dataCollected" />
      <transition event="pump.standby.completed" target="standbyReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="pump.protection.completed" target="resetReady" />
      <transition event="pump.trigger-window.invalidated" target="chargeComplete" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="faultLock" />
    <transition event="power-check.invalidated" target="faultLock" />
    <transition event="configuration.invalidated" target="faultLock" />
  </state>
  <state id="fault" initial="faultLock">
    <state id="faultLock">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="faultLock" />
    </state>
    <state id="commFault">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="commFault" />
    </state>
    <state id="timeoutFault">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="timeoutFault" />
    </state>
    <state id="runTerminated">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="runTerminated" />
    </state>
    <transition event="fault.confirmed" target="faultLock" type="internal" />
    <transition event="communication.failure-confirmed" target="commFault" type="internal" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" type="internal" />
    <transition event="run.terminated" target="runTerminated" type="internal" />
  </state>
  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "fault_codes": {
    "fault_confirmed": "faultLock",
    "communication_fault_confirmed": "commFault",
    "timeout_confirmed": "timeoutFault",
    "qualification_invalidated_1": "faultLock",
    "configuration_invalidated_1": "faultLock",
    "power_check_invalidated_1": "faultLock"
  },
  "model_id": "pump-hierarchical-v4",
  "model_version": 4,
  "display_name": "泵浦分系统",
  "execution_model": "hierarchical-single-active-state",
  "configuration_valid_states": [
    "parameterOk",
    "emissionPrepared",
    "chargePrepared",
    "chargingActive",
    "chargeComplete",
    "triggerReady",
    "dataCollected"
  ],
  "outer_labels": {
    "notReady": "未就绪",
    "ready": "就绪",
    "chargeCapable": "具备充电条件",
    "charging": "泵浦充电中",
    "charged": "泵浦充电完成",
    "armed": "泵浦待触发",
    "fault": "异常"
  },
  "inner_labels": {
    "unchecked": "未上电/离线",
    "powerOnOk": "上电检查通过，待功能检查",
    "checkFailed": "功能检查未通过/业务资格撤销",
    "shutdownNormal": "关机正常",
    "functionReady": "业务就绪（具备安全充电与触发准备能力）",
    "parameterOk": "参数配置正常",
    "resetReady": "复位/待机完成",
    "emissionPrepared": "发射准备完成",
    "chargePrepared": "充电准备完成",
    "chargingActive": "泵浦充电中",
    "chargeComplete": "泵浦充电中/达标/完成",
    "triggerReady": "泵浦触发窗口已就绪",
    "dataCollected": "泵浦发射数据已采集",
    "faultLock": "故障锁定",
    "commFault": "通信异常",
    "timeoutFault": "执行超时",
    "runTerminated": "本发终止，待内部安全复位",
    "standbyReady": "泵浦回到待机安全位"
  },
  "context_defaults": {
    "fault_origin": null,
    "faults": [],
    "power_status": "unknown",
