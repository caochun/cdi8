      "source_outer": [
        "fault"
      ],
      "machine_event": "shutdown.confirmed",
      "observation": "异常"
    },
    "fault_confirmed": {
      "label": "设备故障确认",
      "source_outer": [
        "notReady",
        "ready",
        "wakeup",
        "fault"
      ],
      "machine_event": "fault.confirmed",
      "observation": "异常"
    },
    "communication_fault_confirmed": {
