      "success_events": {
        "powerOnOk": "qualification.confirmed",
        "checkFailed": "qualification.confirmed"
      },
      "failure_events": {
        "powerOnOk": "qualification.failed",
        "checkFailed": "qualification.failed"
      },
      "success_key": "功能检查通过",
      "failure_key": "功能检查未通过",
      "success_observation": "就绪",
      "request_event": "function-check.requested"
    },
    "parameter_dispatch": {
      "label": "参数下发",
      "success_events": {
        "functionReady": "configuration.validated",
        "parameterOk": "configuration.validated",
        "standbyReady": "configuration.validated"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "standbyReady": null
      },
      "success_key": "参数配置正常",
      "failure_key": "参数下发失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "configuration.requested"
    },
    "preamp_wakeup": {
      "label": "预放唤醒",
      "success_events": {
        "parameterOk": "preamp.wakeup.completed"
      },
      "failure_events": {
        "parameterOk": "preamp.wakeup.failed"
      },
      "success_key": "预放完成唤醒并具备闭环条件",
      "failure_key": "预放唤醒失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "preamp.wakeup.requested"
    },
    "coarse_loop": {
      "label": "预放能量粗闭环",
      "success_events": {
        "wakeupReady": "energy.coarse-loop.completed"
      },
      "failure_events": {
        "wakeupReady": null
      },
      "success_key": "粗闭环达标",
      "failure_key": "粗闭环失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "energy.coarse-loop.requested"
    },
    "fine_loop": {
      "label": "预放能量精闭环",
      "success_events": {
        "coarseLoopOk": "energy.fine-loop.completed",
        "fineLoopOk": "energy.fine-loop.second-completed"
      },
      "failure_events": {
        "coarseLoopOk": null,
        "fineLoopOk": null
      },
      "success_key": "精闭环达标",
      "failure_key": "精闭环失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "energy.fine-loop.requested"
    },
    "energy_meter_clear": {
      "label": "能量计清零",
      "success_events": {
        "fineLoopOk": "energy-meter.cleared"
      },
      "failure_events": {
        "fineLoopOk": null
      },
      "success_key": "能量计已清零",
      "failure_key": "能量计清零失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "energy-meter.clear-requested"
    },
    "energy_collect": {
      "label": "能量数据采集",
      "success_events": {
        "energyMeterCleared": "energy.collection.completed"
      },
      "failure_events": {
        "energyMeterCleared": null
      },
      "success_key": "能量数据采集完成",
      "failure_key": "能量数据采集失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "energy.collection.requested"
    },
    "standby_reset": {
      "label": "预放待机/复位",
      "success_events": {
        "functionReady": "standby.completed",
        "parameterOk": "standby.completed",
        "standbyReady": "standby.completed",
        "wakeupReady": "standby.completed",
        "coarseLoopOk": "standby.completed",
        "fineLoopOk": "standby.completed",
        "energyMeterCleared": "standby.completed",
        "energyDataCollected": "standby.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "standbyReady": null,
        "wakeupReady": null,
        "coarseLoopOk": null,
        "fineLoopOk": null,
        "energyMeterCleared": null,
        "energyDataCollected": null
      },
      "success_key": "复位/待机完成",
      "failure_key": "复位/待机失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "standby.requested"
    },
    "shutdown": {
      "label": "关机",
      "success_events": {
        "unchecked": "shutdown.confirmed",
        "powerOnOk": "shutdown.confirmed",
        "checkFailed": "shutdown.confirmed",
        "shutdownNormal": "shutdown.confirmed",
        "functionReady": "shutdown.confirmed",
        "parameterOk": "shutdown.confirmed",
        "standbyReady": "shutdown.confirmed",
        "wakeupReady": "shutdown.confirmed",
        "coarseLoopOk": "shutdown.confirmed",
        "fineLoopOk": "shutdown.confirmed",
        "energyMeterCleared": "shutdown.confirmed",
        "energyDataCollected": "shutdown.confirmed",
        "wakeupFailed": "shutdown.confirmed",
        "commFault": "shutdown.confirmed",
        "timeoutFault": "shutdown.confirmed",
        "faultLock": "shutdown.confirmed"
      },
      "failure_events": {
        "unchecked": null,
        "powerOnOk": null,
        "checkFailed": null,
        "shutdownNormal": null,
        "functionReady": null,
        "parameterOk": null,
        "standbyReady": null,
        "wakeupReady": null,
        "coarseLoopOk": null,
        "fineLoopOk": null,
        "energyMeterCleared": null,
        "energyDataCollected": null,
        "wakeupFailed": null,
        "commFault": null,
        "timeoutFault": null,
        "faultLock": null
      },
      "success_key": "关机正常",
      "failure_key": "关机失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "shutdown.requested"
    },
    "abort_reset": {
      "label": "异常中止复位",
      "success_events": {
        "functionReady": "abort.completed",
        "parameterOk": "abort.completed",
        "standbyReady": "abort.completed",
        "wakeupReady": "abort.completed",
        "coarseLoopOk": "abort.completed",
        "fineLoopOk": "abort.completed",
        "energyMeterCleared": "abort.completed",
        "energyDataCollected": "abort.completed",
        "wakeupFailed": "recovery.completed",
        "commFault": "recovery.completed",
        "timeoutFault": "recovery.completed",
        "faultLock": "recovery.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "standbyReady": null,
        "wakeupReady": null,
        "coarseLoopOk": null,
        "fineLoopOk": null,
        "energyMeterCleared": null,
        "energyDataCollected": null,
        "wakeupFailed": null,
        "commFault": null,
        "timeoutFault": null,
        "faultLock": null
      },
      "success_key": "安全复位完成",
      "failure_key": "安全复位失败",
      "success_observation": null,
      "failure_observation": null,
      "request_event": "abort.requested"
    }
  },
  "confirmations": {
    "qualification_confirmed": {
      "label": "业务资格确认",
      "source_outer": [
        "notReady"
      ],
      "machine_event": "qualification.confirmed",
      "observation": "就绪"
    },
    "qualification_invalidated": {
      "label": "业务资格失效确认",
      "source_outer": [
        "ready",
        "wakeup"
      ],
      "machine_event": "qualification.invalidated",
      "observation": "未就绪"
    },
    "configuration_invalidated": {
      "label": "参数配置失效确认",
      "source_outer": [
        "ready",
        "wakeup"
      ],
      "machine_event": "configuration.invalidated",
      "observation": "就绪"
    },
    "shutdown_confirmed": {
      "label": "安全下电完成",
      "source_outer": [
        "notReady",
        "ready",
        "wakeup"
      ],
      "machine_event": "shutdown.confirmed",
      "observation": "未就绪"
    },
    "shutdown_while_fault_confirmed": {
