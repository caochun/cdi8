      "observation": "异常"
    },
    "timeout_confirmed": {
      "label": "执行超时确认",
      "source_outer": [
        "notReady",
        "ready",
        "wakeup",
        "fault"
      ],
      "machine_event": "execution.timeout-confirmed",
      "observation": "异常"
    },
    "recovery_confirmed": {
      "label": "异常恢复并完成安全复位",
      "source_outer": [
        "fault"
      ],
      "machine_event": "recovery.completed",
      "observation": "未就绪"
    }
  },
  "annotations": {
    "context_policy": {
      "fault_origin": "进入异常前的有效运行状态，由反馈适配层记录",
      "power_status": "unknown、on 或 off；上电检查成功后为 on，关机确认后为 off",
      "configuration": "参数资格的上下文记录，不替代当前状态",
      "data_qualification": "能量数据采集结果，不替代当前唤醒状态"
    }
  }
}
]]></data>
  </datamodel>
</scxml>
