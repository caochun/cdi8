<?xml version="1.0" encoding="UTF-8"?>
<!--
  再生与双程放大组件状态机模型。
  依据《集中管控系统与分系统状态梳理清单》及 2026-10-15 用户确认口径：
  上电检查只确认本系统所辖设备是否均已上电，不执行上电操作；
  功能检查测试设备功能是否正常。上电检查通过仍处于未就绪，
  功能检查通过才进入业务就绪；业务参数配置生效后才放行专有动作。
  四组件共同资格：notReady/unchecked → notReady/powerOnOk
  → ready/functionReady → ready/parameterOk。
  动作请求、执行进度、结果及超时保存在独立任务记录中。
  datamodel 保存动作绑定、标签、确认事件和上下文；GUI 直接加载本文件绘制状态图。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="notReady">
  <state id="notReady" initial="unchecked">
    <state id="unchecked" >
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
    </state>
    <state id="powerOnOk">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
    </state>
    <state id="checkFailed">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
    </state>
    <state id="shutdownNormal" >
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="power-check.passed" target="powerOnOk" />
    <transition event="power-check.failed" target="unchecked" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="qualification.confirmed" target="functionReady" />
    <transition event="qualification.failed" target="checkFailed" />
    <transition event="shutdown.confirmed" target="shutdownNormal" type="internal" />
  </state>
  <state id="ready" initial="functionReady">
    <state id="functionReady">
      <transition event="configuration.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="configuration.validated" target="parameterOk" />
    </state>
    <state id="parameterOk">
      <transition event="configuration.requested" target="functionReady" />
      <transition event="preamp.wakeup.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="configuration.invalidated" target="functionReady" />
      <transition event="configuration.reconfiguration-accepted" target="functionReady" />
      <transition event="preamp.wakeup.completed" target="wakeup" />
    </state>
    <state id="standbyReady">
      <transition event="configuration.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="configuration.validated" target="parameterOk" />
    </state>
    <transition event="standby.completed" target="standbyReady" type="internal" />
    <transition event="abort.completed" target="standbyReady" type="internal" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="configuration.invalidated" target="functionReady" />
    <transition event="preamp.wakeup.failed" target="wakeupFailed" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>
  <state id="wakeup" initial="wakeupReady">
    <state id="wakeupReady">
      <transition event="energy.coarse-loop.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="energy.coarse-loop.completed" target="coarseLoopOk" />
      <transition event="preamp.wakeup.failed" target="wakeupFailed" />
    </state>
    <state id="coarseLoopOk">
      <transition event="energy.fine-loop.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="energy.coarse-loop.invalidated" target="wakeupReady" />
      <transition event="energy.fine-loop.completed" target="fineLoopOk" />
    </state>
    <state id="fineLoopOk">
      <transition event="energy.fine-loop.requested" />
      <transition event="energy-meter.clear-requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="energy.fine-loop.invalidated" target="wakeupReady" />
      <transition event="energy.fine-loop.second-completed" target="fineLoopOk" />
      <transition event="energy-meter.cleared" target="energyMeterCleared" />
    </state>
    <state id="energyMeterCleared">
      <transition event="energy.collection.requested" />
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
      <transition event="energy-meter.invalidated" target="fineLoopOk" />
      <transition event="energy.collection.completed" target="energyDataCollected" />
    </state>
    <state id="energyDataCollected">
      <transition event="standby.requested" />
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
    </state>
    <transition event="standby.completed" target="standbyReady" />
    <transition event="abort.completed" target="standbyReady" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="configuration.invalidated" target="functionReady" />
    <transition event="preamp.wakeup.failed" target="wakeupFailed" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>
  <state id="fault" initial="faultLock">
    <state id="wakeupFailed" >
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
    </state>
    <state id="commFault" >
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
    </state>
    <state id="timeoutFault" >
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
    </state>
    <state id="faultLock" >
      <transition event="shutdown.requested" />
      <transition event="abort.requested" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="shutdown.confirmed" target="faultLock" />
    <transition event="recovery.completed" target="notReady" />
  </state>
  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "model_id": "preamp-hierarchical-v3",
  "model_version": 3,
  "execution_model": "hierarchical-single-active-state",
  "configuration_valid_states": [
    "parameterOk",
    "wakeupReady",
    "coarseLoopOk",
    "fineLoopOk",
    "energyMeterCleared",
    "energyDataCollected"
  ],
  "display_name": "再生与双程放大组件",
  "outer_labels": {
    "notReady": "未就绪",
    "ready": "就绪",
    "wakeup": "唤醒",
    "fault": "异常"
  },
  "inner_labels": {
    "unchecked": "未上电/离线",
    "functionReady": "业务就绪完成（具备能量闭环能力）",
    "parameterOk": "参数配置生效",
    "standbyReady": "复位/待机完成",
    "wakeupReady": "预放完成唤醒并具备闭环条件",
    "coarseLoopOk": "预放能量粗闭环达标",
    "fineLoopOk": "预放能量精闭环达标",
    "energyMeterCleared": "能量计已清零可触发",
    "energyDataCollected": "能量数据采集完成",
    "wakeupFailed": "预放唤醒失败",
    "commFault": "通信异常",
    "timeoutFault": "执行超时",
    "faultLock": "故障锁定",
    "powerOnOk": "上电检查通过，待功能检查",
    "checkFailed": "功能检查未通过",
    "shutdownNormal": "关机正常"
  },
  "context_defaults": {
    "fault_origin": null,
    "power_status": "unknown",
    "configuration": {
      "status": "unknown",
      "version": null
    },
    "faults": [],
    "data_qualification": "unknown"
  },
  "actions": {
    "power_on_check": {
      "label": "上电检查",
      "success_events": {
        "unchecked": "power-check.passed",
        "powerOnOk": "power-check.passed",
        "checkFailed": "power-check.passed",
        "shutdownNormal": "power-check.passed"
      },
      "failure_events": {
        "unchecked": "power-check.failed",
        "powerOnOk": "power-check.failed",
        "checkFailed": "power-check.failed",
        "shutdownNormal": "power-check.failed"
      },
      "success_key": "上电检查通过",
      "failure_key": "上电检查未通过",
      "request_event": "power-check.requested"
    },
    "function_check": {
