<?xml version="1.0" encoding="UTF-8"?>
<!--
  靶瞄准定位系统：父状态严格映射状态表 E 列，子状态映射 D 列。
  单一活动叶状态；内部确认事件驱动；保留失败重试、自环、资格撤销、异常恢复和关机闭环。
  请求不会直接当作设备已完成；外部业务条件在流程层检查。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="notReady">
  <state id="notReady" initial="unchecked">
    <state id="unchecked">
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="powerOnOk">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="checkFailed">
      <transition event="power-check.requested" />
      <transition event="function-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="shutdownNormal">
      <transition event="power-check.requested" />
      <transition event="shutdown.requested" />
      <transition event="power-check.passed" target="powerOnOk" />
      <transition event="power-check.failed" target="unchecked" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="power-check.invalidated" target="unchecked" type="internal" />
  </state>
  <state id="ready" initial="functionReady">
    <state id="functionReady">
      <transition event="configuration.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="parameterOk">
      <transition event="configuration.requested" target="functionReady" />
      <transition event="target.preposition.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="configuration.reconfiguration-accepted" target="functionReady" />
      <transition event="target.preposition.completed" target="targetPrepositioned" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="resetReady">
      <transition event="function-check.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="qualification.confirmed" target="functionReady" />
      <transition event="qualification.failed" target="checkFailed" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="targetRetracted">
      <transition event="target.analysis.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.analysis.completed" target="analysisComplete" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <state id="analysisComplete">
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" type="internal" />
  </state>
  <state id="aimCapable" initial="targetPrepositioned">
    <state id="targetPrepositioned">
      <transition event="target.simulation-position.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.simulation-position.completed" target="simulationPositioned" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="target.alignment.failed" target="alignmentFault" />
      <transition event="target.position.invalidated" target="parameterOk" />
    </state>
    <state id="simulationPositioned">
      <transition event="target.beam-guide.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.beam-guide.completed" target="beamGuideComplete" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="target.alignment.failed" target="alignmentFault" />
      <transition event="target.position.invalidated" target="parameterOk" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" />
  </state>
  <state id="beamGuided" initial="beamGuideComplete">
    <state id="beamGuideComplete">
      <transition event="target.reset.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.reset.completed" target="targetReset" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="target.alignment.failed" target="alignmentFault" />
      <transition event="target.position.invalidated" target="parameterOk" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" />
  </state>
  <state id="targetPositioned" initial="targetReset">
    <state id="targetReset">
      <transition event="target.enter-shot.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.enter-shot.completed" target="shotReady" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="target.alignment.failed" target="alignmentFault" />
      <transition event="target.position.invalidated" target="parameterOk" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" />
  </state>
  <state id="shotCapable" initial="shotReady">
    <state id="shotReady">
      <transition event="target.retract.requested" />
      <transition event="target-alignment.standby.requested" />
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="target.retract.completed" target="targetRetracted" />
      <transition event="target-alignment.standby.completed" target="resetReady" />
      <transition event="abort.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="shutdownNormal" />
      <transition event="target.alignment.failed" target="alignmentFault" />
      <transition event="target.position.invalidated" target="parameterOk" />
      <transition event="target.shot-state.invalidated" target="targetReset" />
    </state>
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="run.terminated" target="runTerminated" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="power-check.invalidated" target="unchecked" />
    <transition event="configuration.invalidated" target="functionReady" />
  </state>
  <state id="fault" initial="faultLock">
    <state id="faultLock">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="faultLock" />
    </state>
    <state id="commFault">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="commFault" />
    </state>
    <state id="timeoutFault">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="timeoutFault" />
    </state>
    <state id="runTerminated">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="runTerminated" />
    </state>
    <state id="alignmentFault">
      <transition event="abort.requested" />
      <transition event="shutdown.requested" />
      <transition event="recovery.completed" target="resetReady" />
      <transition event="shutdown.confirmed" target="alignmentFault" />
    </state>
    <transition event="fault.confirmed" target="faultLock" type="internal" />
    <transition event="communication.failure-confirmed" target="commFault" type="internal" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" type="internal" />
    <transition event="run.terminated" target="runTerminated" type="internal" />
  </state>
  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "fault_codes": {
    "fault_confirmed": "faultLock",
    "communication_fault_confirmed": "commFault",
    "timeout_confirmed": "timeoutFault",
    "alignment_fault_confirmed": "alignmentFault"
  },
  "model_id": "target-alignment-hierarchical-v4",
  "model_version": 4,
  "display_name": "靶瞄准定位系统",
  "execution_model": "hierarchical-single-active-state",
  "configuration_valid_states": [
    "parameterOk",
    "targetPrepositioned",
    "simulationPositioned",
    "beamGuideComplete",
    "targetReset",
    "shotReady",
    "targetRetracted",
    "analysisComplete"
  ],
  "outer_labels": {
    "notReady": "未就绪",
    "ready": "就绪",
    "aimCapable": "具备瞄靶条件",
    "beamGuided": "瞄靶（光束引导）完成",
    "targetPositioned": "实验靶就位",
    "shotCapable": "具备打靶状态",
    "fault": "异常"
  },
  "inner_labels": {
    "unchecked": "未上电/离线",
    "powerOnOk": "上电检查通过，待功能检查",
    "checkFailed": "功能检查未通过/业务资格撤销",
    "shutdownNormal": "关机正常",
    "functionReady": "业务就绪完成（具备定位锁定能力）",
    "parameterOk": "参数配置正常",
    "resetReady": "复位/待机完成",
    "targetPrepositioned": "实验靶预定位到位并锁定",
    "simulationPositioned": "模拟靶定位到位",
    "beamGuideComplete": "光束引导完成",
    "targetReset": "实验靶复位到位并锁定",
    "shotReady": "靶瞄进入打靶状态",
    "targetRetracted": "靶瞄收靶",
    "analysisComplete": "靶瞄数据分析完成",
    "faultLock": "故障锁定",
    "commFault": "通信异常",
    "timeoutFault": "执行超时",
    "runTerminated": "本发终止，待内部安全复位",
    "alignmentFault": "靶瞄偏差超限"
  },
  "context_defaults": {
    "fault_origin": null,
    "faults": [],
    "power_status": "unknown",
