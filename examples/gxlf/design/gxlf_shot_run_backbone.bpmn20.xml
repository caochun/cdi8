<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:fac="https://cdi8.cn/facility/v1" xmlns:run="https://cdi8.cn/shot-run/v1" id="gxlf_shot_run_definitions" targetNamespace="https://cdi8.cn/gxlf/process">
  <bpmn:process id="gxlf_shot_run_backbone" name="GXLF 发次主干（新模型设计）" isExecutable="false">
    <bpmn:documentation>只表达一次发次的操作编排、设施放行条件和本发证据边界。设施结构来自 gxlf-facility.system-definition.xml，设施事实来自 gxlf-facility-state-projection.xml，本发上下文来自 contracts/shot-run.schema.json。当前不直接下发设备动作。</bpmn:documentation>
    <bpmn:startEvent id="run_start" name="创建发次" />
    <bpmn:serviceTask id="open_run" name="建立发次运行记录" flowable:expression="${shotRuns.open(execution)}"><bpmn:extensionElements><run:stage value="created" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="reserve_resources" name="预约实验资源" flowable:expression="${shotRuns.stage(execution, 'resources_reserved')}"><bpmn:extensionElements><run:stage value="resources_reserved" /><fac:capability ref="central-control.reserve-services" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="initialize_components" name="组件初始化：上电与功能检查" flowable:expression="${shotRuns.stage(execution, 'initializing')}"><bpmn:extensionElements><run:stage value="initializing" /><fac:requires guard="functionCheckAllowed" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="record_initialized" name="记录组件初始化证据" flowable:expression="${shotRuns.record(execution, 'facility-fact', 'allFunctionReady', 'succeeded')}"><bpmn:extensionElements><run:stage value="initialized" /><run:records kind="facility-fact" fact="allFunctionReady" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="receive_parameters" name="接收本发参数" flowable:expression="${shotRuns.stage(execution, 'parameters_receiving')}"><bpmn:extensionElements><run:stage value="parameters_receiving" /><fac:requires guard="parameterDispatchAllowed" /><fac:capability ref="central-control.dispatch-commands" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="record_parameters" name="记录参数接收证据" flowable:expression="${shotRuns.record(execution, 'command-result', 'parameters-received', 'succeeded')}"><bpmn:extensionElements><run:stage value="parameters_received" /><run:records kind="command-result" operation="parameter_dispatch" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="preparation_split" name="展开发射准备" />
    <bpmn:serviceTask id="prepare_optical" name="光源、预放和光路准备" flowable:expression="${shotRuns.record(execution, 'command-result', 'optical-preparation', 'succeeded')}"><bpmn:extensionElements><run:records kind="command-result" operation="optical_preparation" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="prepare_target" name="靶瞄、测量和诊断准备" flowable:expression="${shotRuns.record(execution, 'command-result', 'target-preparation', 'succeeded')}"><bpmn:extensionElements><run:records kind="command-result" operation="target_preparation" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="prepare_safety" name="建立安全联锁" flowable:expression="${shotRuns.record(execution, 'interlock', 'interlock-established', 'succeeded')}"><bpmn:extensionElements><fac:requires guard="preparationAllowed" /><run:records kind="interlock" fact="interlockEstablished" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="preparation_join" name="发射准备汇合" />
    <bpmn:serviceTask id="prepared_gate" name="核验发射准备完成" flowable:expression="${facilityStates.requireGuard('preparationAllowed')}"><bpmn:extensionElements><fac:requires guard="preparationAllowed" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="stage_prepared" name="进入 prepared 阶段" flowable:expression="${shotRuns.stage(execution, 'prepared')}" />
    <bpmn:serviceTask id="charge" name="发射充电" flowable:expression="${shotRuns.stage(execution, 'charging')}"><bpmn:extensionElements><fac:requires guard="preparationAllowed" /><run:records kind="command-result" operation="charge" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="trigger_gate" name="核验同步触发窗口" flowable:expression="${facilityStates.requireGuard('triggerAllowed')}"><bpmn:extensionElements><fac:requires guard="triggerAllowed" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="trigger" name="T0/T+3/T+5 同步触发" flowable:expression="${shotRuns.record(execution, 'timing', 'formal-trigger', 'succeeded')}"><bpmn:extensionElements><run:stage value="triggering" /><run:records kind="timing" operation="synchronous_trigger" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="record_emission" name="记录正式发射结果" flowable:expression="${shotRuns.record(execution, 'trigger-result', 'emission', 'succeeded')}"><bpmn:extensionElements><run:stage value="emission_confirmed" /><run:records kind="trigger-result" operation="emission" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="postprocess" name="发射后处理与数据归档" flowable:expression="${shotRuns.stage(execution, 'postprocessing')}"><bpmn:extensionElements><run:records kind="postprocess-result" operation="postprocessing" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="complete_run" name="完成发次运行记录" flowable:expression="${shotRuns.stage(execution, 'completed')}" />
    <bpmn:endEvent id="run_end" name="发次完成" />
    <bpmn:sequenceFlow id="flow_start_open" sourceRef="run_start" targetRef="open_run" />
    <bpmn:sequenceFlow id="flow_open_reserve" sourceRef="open_run" targetRef="reserve_resources" />
    <bpmn:sequenceFlow id="flow_reserve_init" sourceRef="reserve_resources" targetRef="initialize_components" />
    <bpmn:sequenceFlow id="flow_init_record" sourceRef="initialize_components" targetRef="record_initialized" />
    <bpmn:sequenceFlow id="flow_record_receive" sourceRef="record_initialized" targetRef="receive_parameters" />
    <bpmn:sequenceFlow id="flow_receive_record" sourceRef="receive_parameters" targetRef="record_parameters" />
    <bpmn:sequenceFlow id="flow_record_split" sourceRef="record_parameters" targetRef="preparation_split" />
    <bpmn:sequenceFlow id="flow_split_optical" sourceRef="preparation_split" targetRef="prepare_optical" />
    <bpmn:sequenceFlow id="flow_split_target" sourceRef="preparation_split" targetRef="prepare_target" />
    <bpmn:sequenceFlow id="flow_split_safety" sourceRef="preparation_split" targetRef="prepare_safety" />
    <bpmn:sequenceFlow id="flow_optical_join" sourceRef="prepare_optical" targetRef="preparation_join" />
    <bpmn:sequenceFlow id="flow_target_join" sourceRef="prepare_target" targetRef="preparation_join" />
    <bpmn:sequenceFlow id="flow_safety_join" sourceRef="prepare_safety" targetRef="preparation_join" />
    <bpmn:sequenceFlow id="flow_join_gate" sourceRef="preparation_join" targetRef="prepared_gate" />
    <bpmn:sequenceFlow id="flow_gate_stage" sourceRef="prepared_gate" targetRef="stage_prepared" />
    <bpmn:sequenceFlow id="flow_stage_charge" sourceRef="stage_prepared" targetRef="charge" />
    <bpmn:sequenceFlow id="flow_charge_trigger_gate" sourceRef="charge" targetRef="trigger_gate" />
    <bpmn:sequenceFlow id="flow_trigger_gate" sourceRef="trigger_gate" targetRef="trigger" />
    <bpmn:sequenceFlow id="flow_trigger_result" sourceRef="trigger" targetRef="record_emission" />
    <bpmn:sequenceFlow id="flow_result_post" sourceRef="record_emission" targetRef="postprocess" />
    <bpmn:sequenceFlow id="flow_post_complete" sourceRef="postprocess" targetRef="complete_run" />
    <bpmn:sequenceFlow id="flow_complete_end" sourceRef="complete_run" targetRef="run_end" />
  </bpmn:process>
</bpmn:definitions>
