    <bpmn:receiveTask id="switch_safe" name="确认开关实际储能已消除"><bpmn:documentation>设施事实 switchEnergyAbsent 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:receiveTask id="optical_safe" name="确认光源与预放均退出受保护工作状态"><bpmn:documentation>设施事实 opticalOperationReleased 必须为valid；取消流程、发出待机请求及故障状态均不能替代退出观测。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:task id="release_interlock" name="协调联锁控制器进入正常解除序列"><bpmn:documentation>开门会使锁门输入失效，必须由控制器提供明确的解除状态转换；解除顺序与释放门槛待现场协议确认，不能直接清掉软件规则。</bpmn:documentation></bpmn:task>
    <bpmn:task id="unlock_door" name="按确认策略解锁并打开中子屏蔽门"><bpmn:documentation>正常解除与人员遇险时的紧急解锁分别处理。</bpmn:documentation></bpmn:task>
    <bpmn:serviceTask id="light_off" name="关闭警灯和报警"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:capability ownerRef="control-environment" capabilityRef="warning-light-off" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:task id="announce_end" name="广播本发实验结束"><bpmn:documentation>取得门状态、灯/报警关闭及结束广播证据。</bpmn:documentation></bpmn:task>
    <bpmn:receiveTask id="released" name="取得联锁控制器解除完成确认"><bpmn:documentation>设施事实 interlockReleased 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:endEvent id="exp_end" name="实验操作完成"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_vacuum_parameters" sourceRef="vacuum_parameters" targetRef="parameters_complete" />
    <bpmn:sequenceFlow id="flow_optical_safe" sourceRef="optical_safe" targetRef="release_interlock" />
    <bpmn:sequenceFlow id="flow_112" sourceRef="exp_start" targetRef="power_checks" />

    <bpmn:sequenceFlow id="flow_113" sourceRef="power_checks" targetRef="power_complete" />
    <bpmn:sequenceFlow id="flow_114" sourceRef="power_complete" targetRef="function_checks" />
    <bpmn:sequenceFlow id="flow_115" sourceRef="function_checks" targetRef="function_complete" />
    <bpmn:sequenceFlow id="flow_116" sourceRef="function_complete" targetRef="parameters" />
    <bpmn:sequenceFlow id="flow_117" sourceRef="parameters" targetRef="vacuum_parameters" />
    <bpmn:sequenceFlow id="flow_118" sourceRef="parameters_complete" targetRef="establish_safety" />
    <bpmn:sequenceFlow id="flow_119" sourceRef="establish_safety" targetRef="prepare" />
    <bpmn:sequenceFlow id="flow_120" sourceRef="prepare" targetRef="before_charge" />
    <bpmn:sequenceFlow id="flow_121" sourceRef="before_charge" targetRef="warning_light" />
    <bpmn:sequenceFlow id="flow_122" sourceRef="warning_light" targetRef="warning_sound" />
    <bpmn:sequenceFlow id="flow_123" sourceRef="warning_sound" targetRef="pump_charge" />
    <bpmn:sequenceFlow id="flow_124" sourceRef="pump_charge" targetRef="charged" />
    <bpmn:sequenceFlow id="flow_125" sourceRef="charged" targetRef="stop_sound" />
    <bpmn:sequenceFlow id="flow_126" sourceRef="stop_sound" targetRef="trigger_ready" />
    <bpmn:sequenceFlow id="flow_127" sourceRef="trigger_ready" targetRef="timing_window" />
    <bpmn:sequenceFlow id="flow_128" sourceRef="timing_window" targetRef="emission_result" />
    <bpmn:sequenceFlow id="flow_129" sourceRef="emission_result" targetRef="postprocess" />
    <bpmn:sequenceFlow id="flow_130" sourceRef="postprocess" targetRef="release_policy" />
    <bpmn:sequenceFlow id="flow_131" sourceRef="release_policy" targetRef="pump_safe" />
    <bpmn:sequenceFlow id="flow_132" sourceRef="pump_safe" targetRef="switch_safe" />
    <bpmn:sequenceFlow id="flow_133" sourceRef="switch_safe" targetRef="optical_safe" />
    <bpmn:sequenceFlow id="flow_134" sourceRef="release_interlock" targetRef="unlock_door" />
    <bpmn:sequenceFlow id="flow_135" sourceRef="unlock_door" targetRef="light_off" />
    <bpmn:sequenceFlow id="flow_136" sourceRef="light_off" targetRef="announce_end" />
    <bpmn:sequenceFlow id="flow_137" sourceRef="announce_end" targetRef="released" />
    <bpmn:sequenceFlow id="flow_138" sourceRef="released" targetRef="exp_end" /></bpmn:subProcess>
    <bpmn:boundaryEvent id="system_failure" name="系统监督报告失效或观测不可信" attachedToRef="experiment" cancelActivity="true"><bpmn:errorEventDefinition errorRef="systemError" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timing_failure" name="触发准备超出 T+3" attachedToRef="experiment" cancelActivity="true"><bpmn:errorEventDefinition errorRef="timingError" /></bpmn:boundaryEvent>
    <bpmn:task id="classify_failure" name="冻结正常推进，按实际风险分类"><bpmn:documentation>保留本发失败、未决命令和监督证据。流程中断不证明设备已停止；下列物理处置接口须取得真实回执。</bpmn:documentation></bpmn:task>
    <bpmn:exclusiveGateway id="failure_kind" name="识别异常类别"></bpmn:exclusiveGateway>
    <bpmn:task id="interlock_emergency" name="联锁触发：广播终止、紧急解锁并启动声光报警"><bpmn:documentation>业务第4节：人员急停、真空异常、重大音视频险情。紧急解锁与普通安全释放不同，不能等待普通后处理汇合。具体联锁控制器协调顺序待现场确认。</bpmn:documentation></bpmn:task>
    <bpmn:task id="stop_charge" name="充电中：紧急停充"><bpmn:documentation>仅适用实际正在充电。等待停充和储能状态观测，不据回执推断能量消失。</bpmn:documentation></bpmn:task>
    <bpmn:task id="discharge" name="已充电未触发：紧急泄放"><bpmn:documentation>由真实储能和触发结果确定适用性，不用 BPMN 所在节点猜测。</bpmn:documentation></bpmn:task>
    <bpmn:task id="service_abort" name="其他服务或设备故障：停止实验推进"><bpmn:documentation>按风险请求物理安全处置；通信断开意味着安全状态未知。</bpmn:documentation></bpmn:task>
    <bpmn:exclusiveGateway id="failure_join" name="汇合异常处理"></bpmn:exclusiveGateway>
    <bpmn:task id="observe_safe_exit" name="等待物理处置、储能消除和联锁状态确认"><bpmn:documentation>不能用清除告警、取消流程或执行 standby 请求替代物理退出证据。</bpmn:documentation></bpmn:task>
    <bpmn:userTask id="recovery_review" name="人工审查中断后的恢复或结束"><bpmn:documentation>恢复须重新核验现场状态、服务与租约，明确哪些参数和结果失效；禁止自动重试发射/充电。</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="recovery_decision" name="是否重新建发并初始化"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="recovery_end" name="本发中断，允许重新建发和初始化"></bpmn:endEvent>
    <bpmn:endEvent id="failed_end" name="本发中断并结束"></bpmn:endEvent>
    <bpmn:task id="archive" name="归档本发命令、时序和安全退出证据"><bpmn:documentation>只使用关联回执与观测，禁止表达式直接写 succeeded。</bpmn:documentation></bpmn:task>
    <bpmn:task id="release_resources" name="释放资源租约"><bpmn:documentation>实验结束和物理约束释放分别确认。</bpmn:documentation></bpmn:task>
    <bpmn:endEvent id="run_end" name="本发完成"></bpmn:endEvent>
    <bpmn:subProcess id="emergency_trigger_handler" name="独立紧急触发请求" triggeredByEvent="true">    <bpmn:startEvent id="emergency_trigger_requested" name="收到紧急触发/紧急停车请求" isInterrupting="true"><bpmn:messageEventDefinition messageRef="emergencyTriggerMessage" /></bpmn:startEvent>
    <bpmn:serviceTask id="emergency_trigger" name="按经确认的现场策略请求同步紧急触发"><bpmn:documentation>业务说明将紧急触发、紧急停车都指向同步紧急触发；不能误译为一般停机。策略未确认、接口未接入时禁止执行。</bpmn:documentation><bpmn:extensionElements><fac:capability ownerRef="synchronization" capabilityRef="emergency-trigger" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:task id="emergency_result" name="核验实际结果并进入人工安全处置"><bpmn:documentation>不得写入正常正式发射成功。</bpmn:documentation></bpmn:task>
    <bpmn:endEvent id="emergency_end" name="本发异常结束，系统监督继续"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_161" sourceRef="emergency_trigger_requested" targetRef="emergency_trigger" />
    <bpmn:sequenceFlow id="flow_162" sourceRef="emergency_trigger" targetRef="emergency_result" />
    <bpmn:sequenceFlow id="flow_163" sourceRef="emergency_result" targetRef="emergency_end" /></bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_139" sourceRef="run_start" targetRef="open_run" />
    <bpmn:sequenceFlow id="flow_140" sourceRef="open_run" targetRef="reserve_resources" />
    <bpmn:sequenceFlow id="flow_141" sourceRef="reserve_resources" targetRef="experiment" />
    <bpmn:sequenceFlow id="flow_142" sourceRef="experiment" targetRef="archive" />
    <bpmn:sequenceFlow id="flow_143" sourceRef="archive" targetRef="release_resources" />
    <bpmn:sequenceFlow id="flow_144" sourceRef="release_resources" targetRef="run_end" />
    <bpmn:sequenceFlow id="flow_145" sourceRef="system_failure" targetRef="classify_failure" />
    <bpmn:sequenceFlow id="flow_146" sourceRef="timing_failure" targetRef="classify_failure" />
    <bpmn:sequenceFlow id="flow_147" sourceRef="classify_failure" targetRef="failure_kind" />
    <bpmn:sequenceFlow id="flow_148" name="联锁触发" sourceRef="failure_kind" targetRef="interlock_emergency"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">failureKind == interlockTrip</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_149" sourceRef="interlock_emergency" targetRef="failure_join" />
    <bpmn:sequenceFlow id="flow_150" name="充电中且需停充" sourceRef="failure_kind" targetRef="stop_charge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">failureKind == charging</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_151" sourceRef="stop_charge" targetRef="failure_join" />
    <bpmn:sequenceFlow id="flow_152" name="储能且尚未触发" sourceRef="failure_kind" targetRef="discharge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">failureKind == storedEnergy</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_153" sourceRef="discharge" targetRef="failure_join" />
    <bpmn:sequenceFlow id="flow_154" name="其他故障/状态未知" sourceRef="failure_kind" targetRef="service_abort"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">failureKind == other</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_155" sourceRef="service_abort" targetRef="failure_join" />
    <bpmn:sequenceFlow id="flow_156" sourceRef="failure_join" targetRef="observe_safe_exit" />
    <bpmn:sequenceFlow id="flow_157" sourceRef="observe_safe_exit" targetRef="recovery_review" />
    <bpmn:sequenceFlow id="flow_158" sourceRef="recovery_review" targetRef="recovery_decision" />
    <bpmn:sequenceFlow id="flow_159" name="重新建发" sourceRef="recovery_decision" targetRef="recovery_end"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recoveryDecision == restart</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_160" name="结束" sourceRef="recovery_decision" targetRef="failed_end"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recoveryDecision == end</bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
