<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:fac="https://cdi8.cn/facility/v1" id="gxlf_shot_run_definitions" targetNamespace="https://cdi8.cn/gxlf/process">
  <bpmn:error id="systemError" name="系统约束失效" errorCode="SYSTEM_CONSTRAINT_VIOLATION" />
  <bpmn:error id="timingError" name="触发时序失效" errorCode="TRIGGER_WINDOW_MISSED" />
  <bpmn:message id="emergencyTriggerMessage" name="人工紧急触发请求（现场策略待确认）" />
  <bpmn:process id="gxlf_shot_run_backbone" name="GXLF 实验操作与异常处理（业务设计）" isExecutable="false">
    <bpmn:documentation>依据集中管控系统控制流程业务说明修订。系统定义拥有结构依赖及工作状态约束，状态投影/监督提供真实状态与异常，BPMN 驱动状态转换和实验步骤。本文件明确保持不可执行：外部安全、独立同步配方、实时触发、正式结果和正常开门策略未完成，不以占位表达式写成功。详见 docs/architecture/system-supervision-review.md。</bpmn:documentation>
    <bpmn:startEvent id="run_start" name="创建本发实验上下文"></bpmn:startEvent>
    <bpmn:task id="open_run" name="建立发次、配方和所选束线记录"><bpmn:documentation>设备历史状态不能替代本发命令结果；模型运行时使用当前模型集。</bpmn:documentation></bpmn:task>
    <bpmn:serviceTask id="reserve_resources" name="预约服务并取得资源租约"><bpmn:documentation>所有实验节点持续观测租约/服务健康，丢失后进入中断处置。接口待实现。</bpmn:documentation><bpmn:extensionElements><fac:capability ownerRef="central-control" capabilityRef="reserve-services" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:subProcess id="experiment" name="受系统监督的实验操作"><bpmn:documentation>这是不可执行的业务设计。运行中任何服务/安全失效交由系统监督识别；BPMN 组织异常处理。当前 Java 已阻断流程并留存未决物理动作，真实广播、恢复和事件路由尚未接入。系统义务不由此子流程的结束释放。</bpmn:documentation>
    <bpmn:startEvent id="exp_start" name="开始实验操作"></bpmn:startEvent>
    <bpmn:serviceTask id="power_checks" name="全部参与设备上电检查"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="seed" capabilityRef="power-on-check" collectionVar="seedTargets" /><fac:action typeRef="shg" capabilityRef="power-on-check" collectionVar="shgTargets" /><fac:action typeRef="preamp" capabilityRef="power-on-check" collectionVar="preampTargets" /><fac:action typeRef="multipass" capabilityRef="power-on-check" collectionVar="multipassTargets" /><fac:action typeRef="pump" capabilityRef="power-on-check" collectionVar="pumpTargets" /><fac:action typeRef="measurement" capabilityRef="power-on-check" collectionVar="measurementTargets" /><fac:action typeRef="frequency-conversion" capabilityRef="power-on-check" collectionVar="frequencyConversionTargets" /><fac:action typeRef="target-alignment" capabilityRef="power-on-check" collectionVar="targetAlignmentTargets" /><fac:action typeRef="vacuum" capabilityRef="power-on-check" collectionVar="vacuumTargets" /><fac:action typeRef="diagnostics" capabilityRef="power-on-check" collectionVar="diagnosticsTargets" /><fac:action typeRef="synchronization" capabilityRef="power-on-check" collectionVar="synchronizationTargets" /><fac:action typeRef="switch-driver" capabilityRef="power-on-check" collectionVar="switchDriverTargets" /><fac:action typeRef="cooling" capabilityRef="power-on-check" collectionVar="coolingTargets" /><fac:action typeRef="control-environment" capabilityRef="power-on-check" collectionVar="controlEnvironmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:receiveTask id="power_complete" name="确认全部上电检查完成"><bpmn:documentation>设施事实 allPowerChecked 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:serviceTask id="function_checks" name="全部参与设备功能检查"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="seed" capabilityRef="function-check" collectionVar="seedTargets" /><fac:action typeRef="shg" capabilityRef="function-check" collectionVar="shgTargets" /><fac:action typeRef="preamp" capabilityRef="function-check" collectionVar="preampTargets" /><fac:action typeRef="multipass" capabilityRef="function-check" collectionVar="multipassTargets" /><fac:action typeRef="pump" capabilityRef="function-check" collectionVar="pumpTargets" /><fac:action typeRef="measurement" capabilityRef="function-check" collectionVar="measurementTargets" /><fac:action typeRef="frequency-conversion" capabilityRef="function-check" collectionVar="frequencyConversionTargets" /><fac:action typeRef="target-alignment" capabilityRef="function-check" collectionVar="targetAlignmentTargets" /><fac:action typeRef="vacuum" capabilityRef="function-check" collectionVar="vacuumTargets" /><fac:action typeRef="diagnostics" capabilityRef="function-check" collectionVar="diagnosticsTargets" /><fac:action typeRef="synchronization" capabilityRef="function-check" collectionVar="synchronizationTargets" /><fac:action typeRef="switch-driver" capabilityRef="function-check" collectionVar="switchDriverTargets" /><fac:action typeRef="cooling" capabilityRef="function-check" collectionVar="coolingTargets" /><fac:action typeRef="control-environment" capabilityRef="function-check" collectionVar="controlEnvironmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:receiveTask id="function_complete" name="确认全部功能检查完成"><bpmn:documentation>设施事实 allFunctionReady 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:serviceTask id="parameters" name="加载配方并下发本发参数"><bpmn:documentation>真空参数接口尚未建成；不能以缺少 SCXML action 为理由省略真实业务需求。参数服务取值和关联证据待接入。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="seed" capabilityRef="parameter-receive" collectionVar="seedTargets" /><fac:action typeRef="shg" capabilityRef="parameter-receive" collectionVar="shgTargets" /><fac:action typeRef="preamp" capabilityRef="parameter-receive" collectionVar="preampTargets" /><fac:action typeRef="multipass" capabilityRef="parameter-receive" collectionVar="multipassTargets" /><fac:action typeRef="pump" capabilityRef="parameter-receive" collectionVar="pumpTargets" /><fac:action typeRef="measurement" capabilityRef="parameter-receive" collectionVar="measurementTargets" /><fac:action typeRef="frequency-conversion" capabilityRef="parameter-receive" collectionVar="frequencyConversionTargets" /><fac:action typeRef="target-alignment" capabilityRef="parameter-receive" collectionVar="targetAlignmentTargets" /><fac:action typeRef="diagnostics" capabilityRef="parameter-receive" collectionVar="diagnosticsTargets" /><fac:action typeRef="synchronization" capabilityRef="parameter-receive" collectionVar="synchronizationTargets" /><fac:action typeRef="switch-driver" capabilityRef="parameter-receive" collectionVar="switchDriverTargets" /><fac:action typeRef="cooling" capabilityRef="parameter-receive" collectionVar="coolingTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:task id="vacuum_parameters" name="真空系统参数初始化（接口待接入）"><bpmn:documentation>业务6.1包含真空系统参数；独立保留未实现节点，不以现有SCXML缺少参数动作作为省略理由。</bpmn:documentation></bpmn:task>
    <bpmn:receiveTask id="parameters_complete" name="确认本发参数初始化完成"><bpmn:documentation>设施事实 allParametersReceived 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:subProcess id="establish_safety" name="清场、锁门与启用安全联锁"><bpmn:documentation>6.2—6.7 已要求联锁正常，因此原型按严格前置先完成清场/锁门/联锁。图中原并行位置与 card 存在冲突，需现场确认。联锁义务由系统控制器观测保持，离开此子流程不解除。</bpmn:documentation>
    <bpmn:startEvent id="safety_start" name="进入安全准备"></bpmn:startEvent>
    <bpmn:serviceTask id="clearance" name="清场语音定时喊话"><bpmn:documentation>6.8 清场时长待确认，不作为已清场的证明。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="control-environment" capabilityRef="clearance" collectionVar="controlEnvironmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:receiveTask id="personnel_zero" name="核验人员计数归零"><bpmn:documentation>设施事实 personnelCountZero 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:task id="close_lock_door" name="关闭并锁定中子屏蔽门"><bpmn:documentation>6.9 门控接口待接入。风淋门是否参加联锁为未决项，不能静默视为通过。</bpmn:documentation></bpmn:task>
    <bpmn:receiveTask id="interlock_inputs" name="核验门禁、人员与两类真空输入"><bpmn:documentation>设施事实 interlockEstablished 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:task id="arm_interlock" name="请求控制器启用安全联锁"><bpmn:documentation>必须取得独立的控制器 armed 确认；输入正常本身不等于联锁启用。</bpmn:documentation></bpmn:task>
    <bpmn:receiveTask id="interlock_confirm" name="确认联锁实际启用且无触发"><bpmn:documentation>设施事实 interlockOperational 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:endEvent id="safety_end" name="允许受保护操作"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="safety_start" targetRef="clearance" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="clearance" targetRef="personnel_zero" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="personnel_zero" targetRef="close_lock_door" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="close_lock_door" targetRef="interlock_inputs" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="interlock_inputs" targetRef="arm_interlock" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="arm_interlock" targetRef="interlock_confirm" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="interlock_confirm" targetRef="safety_end" /></bpmn:subProcess>
    <bpmn:subProcess id="prepare" name="发射准备"><bpmn:documentation></bpmn:documentation>
    <bpmn:startEvent id="prep_start" name="开始并行准备"></bpmn:startEvent>
    <bpmn:parallelGateway id="prep_split" name="展开光学、靶瞄及泵浦准备"></bpmn:parallelGateway>
    <bpmn:subProcess id="optical" name="光源、预放与准直"><bpmn:documentation></bpmn:documentation>
    <bpmn:startEvent id="opt_start" name="准备光学链"></bpmn:startEvent>
    <bpmn:parallelGateway id="opt_split" name="光源与预放并行"></bpmn:parallelGateway>
    <bpmn:serviceTask id="emit_selected" name="所选束线光源出光"><bpmn:documentation>按实际 sourceSelections 分派，不能同时命令未选中的光源。集合及现场选通证据尚待完整接入。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="seed" capabilityRef="emit" collectionVar="selectedSeedTargets" /><fac:action typeRef="shg" capabilityRef="emit" collectionVar="selectedShgTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="preamp_repeat" name="同步预放重频配方"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="synchronization" capabilityRef="preamp-repeat-recipe" collectionVar="synchronizationTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="wakeup" name="预放唤醒"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="preamp" capabilityRef="wakeup" collectionVar="preampTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="opt_join" name="所选光源出光且预放唤醒"></bpmn:parallelGateway>
    <bpmn:endEvent id="opt_end" name="所选光源出光且预放唤醒"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_8" sourceRef="opt_start" targetRef="opt_split" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="opt_split" targetRef="emit_selected" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="emit_selected" targetRef="opt_join" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="opt_split" targetRef="preamp_repeat" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="preamp_repeat" targetRef="wakeup" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="wakeup" targetRef="opt_join" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="opt_join" targetRef="opt_end" /></bpmn:subProcess>
    <bpmn:subProcess id="aiming" name="测量靶瞄与模拟靶定位"><bpmn:documentation></bpmn:documentation>
    <bpmn:startEvent id="aim_start" name="进入靶瞄准备"></bpmn:startEvent>
    <bpmn:serviceTask id="measurement_repeat" name="同步测量重频配方"><bpmn:documentation>与预放重频是独立配置通道；现有统一 repeat_mode 仅为原型，不证明两个通道同时配置。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="synchronization" capabilityRef="measurement-repeat-recipe" collectionVar="synchronizationTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="aim_split" name="并行准备"></bpmn:parallelGateway>
    <bpmn:serviceTask id="aim_prepare" name="测量靶瞄准备"><bpmn:documentation>暂时把测量控制权交给靶瞄；需授权交接证据。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="measurement" capabilityRef="aim-prepare" collectionVar="measurementTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="target_preposition" name="实验靶预定位"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="target-alignment" capabilityRef="target-preposition" collectionVar="targetAlignmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="aim_join" name="准备完成"></bpmn:parallelGateway>
    <bpmn:serviceTask id="simulation_position" name="模拟靶定位"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="target-alignment" capabilityRef="simulation-position" collectionVar="targetAlignmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:endEvent id="aim_end" name="模拟靶已定位"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_15" sourceRef="aim_start" targetRef="measurement_repeat" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="measurement_repeat" targetRef="aim_split" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="aim_split" targetRef="aim_prepare" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="aim_prepare" targetRef="aim_join" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="aim_split" targetRef="target_preposition" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="target_preposition" targetRef="aim_join" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="aim_join" targetRef="simulation_position" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="simulation_position" targetRef="aim_end" /></bpmn:subProcess>
    <bpmn:serviceTask id="pump_prepare" name="泵浦发射准备"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="pump" capabilityRef="emission-prepare" collectionVar="pumpTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="optical_ready_split" name="光学输入就绪后并行进行闭环与准直"></bpmn:parallelGateway>
    <bpmn:serviceTask id="coarse" name="能量粗闭环"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="preamp" capabilityRef="coarse-loop" collectionVar="preampTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="fine_first" name="第一次能量精闭环"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="preamp" capabilityRef="fine-loop" collectionVar="preampTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:receiveTask id="purge_stopped" name="等待上一轮吹扫实际停止"><bpmn:documentation>设施事实 purgeStopped 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。允许下一发准备与吹扫尾段重叠，但准直必须等待实际停吹扫。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:serviceTask id="collimation" name="执行光路准直"><bpmn:documentation>准直执行期间要求系统输入有效；准直达标是结果，不代表持续准直。</bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="multipass" capabilityRef="collimation" collectionVar="multipassTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="position_split" name="模拟靶定位后的两条结果链"></bpmn:parallelGateway>
    <bpmn:serviceTask id="diagnostic_prepare" name="诊断设备发射准备"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="diagnostics" capabilityRef="emission-prepare" collectionVar="diagnosticsTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="guide_join" name="准直达标且模拟靶已定位"></bpmn:parallelGateway>
    <bpmn:serviceTask id="beam_guide" name="光束引导"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="target-alignment" capabilityRef="beam-guide" collectionVar="targetAlignmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:parallelGateway id="guide_split" name="引导后的三条独立结果链"></bpmn:parallelGateway>
    <bpmn:serviceTask id="target_reset" name="实验靶复位"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="target-alignment" capabilityRef="target-reset" collectionVar="targetAlignmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="target_enter_shot" name="靶瞄进入打靶状态"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="target-alignment" capabilityRef="enter-shot" collectionVar="targetAlignmentTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="measurement_motion" name="测量打靶运动准备"><bpmn:documentation></bpmn:documentation><bpmn:extensionElements><fac:actions><fac:action typeRef="measurement" capabilityRef="motion-prepare" collectionVar="measurementTargets" /></fac:actions></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:task id="independent_motion" name="独立打靶运动准备"><bpmn:documentation>6.19 与测量运动准备保留为独立链路；设备归属和接口待确认。</bpmn:documentation></bpmn:task>
    <bpmn:parallelGateway id="prep_join" name="等待各准备操作结束"></bpmn:parallelGateway>
    <bpmn:receiveTask id="prepared" name="核验发射准备全部完成"><bpmn:documentation>设施事实 emissionPreparationReady 必须为 valid，并关联当前操作的真实完成证据；unknown 不放行。6.22 AND 里程碑，不下发“准备完成”命令。同步状态与每次命令成功证据均需核验。</bpmn:documentation></bpmn:receiveTask>
    <bpmn:endEvent id="prep_end" name="发射准备就绪"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_23" sourceRef="prep_start" targetRef="prep_split" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="prep_split" targetRef="optical" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="optical" targetRef="optical_ready_split" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="optical_ready_split" targetRef="coarse" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="coarse" targetRef="fine_first" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="fine_first" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="optical_ready_split" targetRef="purge_stopped" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="purge_stopped" targetRef="collimation" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="collimation" targetRef="guide_join" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="prep_split" targetRef="aiming" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="aiming" targetRef="position_split" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="position_split" targetRef="guide_join" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="position_split" targetRef="diagnostic_prepare" />
    <bpmn:sequenceFlow id="flow_36" sourceRef="diagnostic_prepare" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_37" sourceRef="prep_split" targetRef="pump_prepare" />
    <bpmn:sequenceFlow id="flow_38" sourceRef="pump_prepare" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_39" sourceRef="guide_join" targetRef="beam_guide" />
    <bpmn:sequenceFlow id="flow_40" sourceRef="beam_guide" targetRef="guide_split" />
    <bpmn:sequenceFlow id="flow_41" sourceRef="guide_split" targetRef="target_reset" />
    <bpmn:sequenceFlow id="flow_42" sourceRef="target_reset" targetRef="target_enter_shot" />
    <bpmn:sequenceFlow id="flow_43" sourceRef="target_enter_shot" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_44" sourceRef="guide_split" targetRef="measurement_motion" />
    <bpmn:sequenceFlow id="flow_45" sourceRef="measurement_motion" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_46" sourceRef="guide_split" targetRef="independent_motion" />
    <bpmn:sequenceFlow id="flow_47" sourceRef="independent_motion" targetRef="prep_join" />
    <bpmn:sequenceFlow id="flow_48" sourceRef="prep_join" targetRef="prepared" />
    <bpmn:sequenceFlow id="flow_49" sourceRef="prepared" targetRef="prep_end" /></bpmn:subProcess>
    <bpmn:subProcess id="before_charge" name="发射充电前准备"><bpmn:documentation></bpmn:documentation>
    <bpmn:startEvent id="charge_prep_start" name="准备已全部就绪"></bpmn:startEvent>
    <bpmn:parallelGateway id="charge_prep_split" name="六条准备链"></bpmn:parallelGateway>
