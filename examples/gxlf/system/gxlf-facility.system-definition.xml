      <capability id="emergency-stop-charge" implementationStatus="declared-not-yet-modeled" label="紧急停充" kind="safety" />
    </componentType>

    <componentType id="measurement" label="测量取样组件" role="measurement" quantity="60"
                   interfaceRef="tango-control" stateModelRef="components/measurement-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="sample-in" direction="in" interfaceRef="sample-link" />
      <port id="data-out" direction="out" interfaceRef="experiment-data-store" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="aim-prepare" label="测量靶瞄准备" kind="control" actionRef="aim_prepare" />
      <capability id="motion-prepare" label="测量打靶运动准备" kind="control" actionRef="motion_prepare" />
      <capability id="measurement-prepare" label="打靶测量准备" kind="control" actionRef="measurement_prepare" />
      <capability id="collect-laser-parameters" label="激光参数采集" kind="observe" actionRef="collect" />
    </componentType>

    <componentType id="frequency-conversion" label="频率转换分系统" role="conversion" quantity="60"
                   interfaceRef="tango-control" stateModelRef="components/frequency-conversion-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-in" direction="in" interfaceRef="optical-link" />
      <port id="optical-out" direction="out" interfaceRef="optical-link" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="pose-set" label="晶体位姿设置" kind="control" actionRef="set_pose" />
    </componentType>

    <componentType id="target-alignment" label="靶瞄准定位系统" role="target" quantity="1"
                   interfaceRef="tango-control" stateModelRef="components/target-alignment-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-in" direction="in" interfaceRef="optical-link" />
      <port id="data-out" direction="out" interfaceRef="experiment-data-store" />
      <port id="safety-in" direction="in" interfaceRef="interlock-bus" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="target-preposition" label="实验靶预定位" kind="control" actionRef="target_preposition" />
      <capability id="simulation-position" label="模拟靶定位" kind="control" actionRef="simulation_position" />
      <capability id="beam-guide" label="光束引导" kind="control" actionRef="beam_guide" />
      <capability id="target-reset" label="实验靶复位" kind="control" actionRef="target_reset" />
      <capability id="enter-shot" label="进入打靶状态" kind="control" actionRef="enter_shot" />
      <capability id="analysis" label="靶瞄数据分析" kind="observe" actionRef="analyze" />
      <capability id="retract" label="靶瞄收靶" kind="control" actionRef="retract" />
    </componentType>

    <componentType id="vacuum" label="真空靶室分系统" role="vacuum" quantity="1"
                   interfaceRef="tango-control" stateModelRef="components/vacuum-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="safety-out" direction="out" interfaceRef="interlock-bus" />
