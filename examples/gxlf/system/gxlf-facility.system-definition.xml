<?xml version="1.0" encoding="UTF-8"?>
<!--
  GXLF 设施系统定义。

  这里描述设施的组成、能力、接口、拓扑和不变量，不描述设备当前状态，
  也不描述某一次发射的阶段、参数或结果。设备的动态行为由 components/ 下
  的 SCXML 定义；发次语义由后续独立的运行模型定义。
-->
<system-definition
    xmlns="https://cdi8.cn/system-definition/v1"
    id="gxlf-facility"
    name="GXLF 激光发射实验设施"
    version="1">

  <scope id="laser-emission-facility" label="激光发射设施控制范围">
    <description>由集中管控系统管理的 60 束线激光发射设施及其安全、同步、诊断和基础设施接口。</description>
    <excludes>发次编号、实验配方、本发阶段、本发采集历史、正式发射结果和后处理结果。</excludes>
  </scope>

  <resources>
    <resource id="beamline" label="激光束线" quantity="60" unit="条" />
    <resource id="preamp-group" label="预放服务组" quantity="10" unit="组" />
    <resource id="shot-reservation" label="实验资源预约" quantity="1" unit="项" />
  </resources>

  <interfaces>
    <interface id="tango-control" label="Tango 控制接口" protocol="TANGO" direction="bidirectional" />
    <interface id="environment-http" label="控制环境 HTTP 接口" protocol="HTTP" direction="bidirectional" />
    <interface id="building-safety" label="建安工程安防接口" protocol="UNRESOLVED" direction="bidirectional" status="unresolved" />
    <interface id="interlock-bus" label="安全联锁观测接口" protocol="EVENT" direction="inbound" />
    <interface id="timing-bus" label="同步时序接口" protocol="EVENT" direction="bidirectional" />
    <interface id="optical-link" label="束线光路连接" protocol="PHYSICAL" direction="bidirectional" />
    <interface id="sample-link" label="测量取样连接" protocol="PHYSICAL" direction="bidirectional" />
    <interface id="control-command-bus" label="集中控制命令总线" protocol="INTERNAL" direction="bidirectional" />
    <interface id="parameter-store" label="发次参数服务" protocol="DATABASE/EVENT" direction="bidirectional" status="contract-unresolved" />
    <interface id="experiment-data-store" label="实验数据存储服务" protocol="DATABASE/EVENT" direction="outbound" status="contract-unresolved" />
    <interface id="reservation-service" label="分系统服务预约接口" protocol="INTERNAL" direction="bidirectional" />
    <interface id="health-events" label="服务健康与心跳事件" protocol="EVENT" direction="inbound" />
  </interfaces>

  <controlNodes>
    <controlNode id="central-control" label="集中管控系统" role="orchestrator">
      <port id="command-out" direction="out" interfaceRef="control-command-bus" />
      <port id="state-in" direction="in" interfaceRef="health-events" />
      <port id="parameter-in" direction="in" interfaceRef="parameter-store" />
      <port id="data-in" direction="in" interfaceRef="experiment-data-store" />
      <port id="data-out" direction="out" interfaceRef="experiment-data-store" />
      <port id="reservation" direction="bidirectional" interfaceRef="reservation-service" />
      <capability id="reserve-services" label="预约分系统服务" kind="coordination" />
      <capability id="dispatch-commands" label="下发控制命令" kind="coordination" />
      <capability id="monitor-health" label="监控服务健康和心跳" kind="observe" />
      <capability id="coordinate-interlock" label="协调安全联锁处置" kind="safety" />
    </controlNode>
  </controlNodes>

  <componentTypes>
    <componentType id="seed" label="光纤种子源组件" role="source" quantity="1"
                   interfaceRef="tango-control" stateModelRef="components/seed-source-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-out" direction="out" interfaceRef="optical-link" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="emit" label="种子源出光" kind="control" actionRef="seed_source_emit" />
      <capability id="collect-laser-parameters" label="激光参数采集" kind="observe" actionRef="laser_parameter_collect" />
      <capability id="standby" label="待机" kind="control" actionRef="standby_reset" />
    </componentType>

    <componentType id="shg" label="二倍频宽带激光注入组件" role="source" quantity="1"
                   interfaceRef="tango-control" stateModelRef="components/shg-injection-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-out" direction="out" interfaceRef="optical-link" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="emit" label="二倍频出光" kind="control" actionRef="frequency_doubled_emit" />
      <capability id="collect-laser-parameters" label="激光参数采集" kind="observe" actionRef="laser_parameter_collect" />
      <capability id="standby-reset" label="待机复位" kind="control" actionRef="standby_reset" />
    </componentType>

    <componentType id="preamp" label="再生与双程放大组件" role="amplifier" quantity="10"
                   interfaceRef="tango-control" stateModelRef="components/preamp-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-in" direction="in" interfaceRef="optical-link" />
      <port id="optical-out" direction="out" interfaceRef="optical-link" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="wakeup" label="预放唤醒" kind="control" actionRef="preamp_wakeup" />
      <capability id="coarse-loop" label="能量粗闭环" kind="control" actionRef="coarse_loop" />
      <capability id="fine-loop" label="能量精闭环" kind="control" actionRef="fine_loop" />
      <capability id="single-recipe" implementationStatus="declared-not-yet-modeled" label="预放单次配方" kind="control" />
      <capability id="clear-energy-meter" label="能量计清零" kind="control" actionRef="energy_meter_clear" />
      <capability id="collect-energy-data" label="能量数据采集" kind="observe" actionRef="energy_collect" />
      <capability id="standby" label="预放待机" kind="control" actionRef="standby_reset" />
    </componentType>

    <componentType id="multipass" label="多程放大系统" role="amplifier" quantity="60"
                   interfaceRef="tango-control" stateModelRef="components/multipass-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="optical-in" direction="in" interfaceRef="optical-link" />
      <port id="optical-out" direction="out" interfaceRef="optical-link" />
      <port id="sample-out" direction="out" interfaceRef="sample-link" />
      <port id="safety-out" direction="out" interfaceRef="interlock-bus" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="collimation" label="光路准直" kind="control" actionRef="collimation" />
      <capability id="enter-shot" label="进入打靶状态" kind="control" actionRef="enter_shot" />
    </componentType>

    <componentType id="pump" label="泵浦分系统" role="pump" quantity="1"
                   interfaceRef="tango-control" stateModelRef="components/pump-state-machine.scxml">
      <port id="command-in" direction="in" interfaceRef="tango-control" />
      <port id="state-out" direction="out" interfaceRef="tango-control" />
      <port id="health-out" direction="out" interfaceRef="health-events" />
      <port id="trigger-in" direction="in" interfaceRef="timing-bus" />
      <port id="data-out" direction="out" interfaceRef="experiment-data-store" />
      <port id="safety-in" direction="in" interfaceRef="interlock-bus" />
      <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
      <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
      <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
      <capability id="emission-prepare" label="泵浦发射准备" kind="control" actionRef="emission_prepare" />
      <capability id="charge-prepare" label="发射充电准备" kind="control" actionRef="charge_prepare" />
      <capability id="charge" label="发射充电" kind="control" actionRef="charge" />
      <capability id="trigger-prepare" label="泵浦触发准备" kind="control" actionRef="trigger_prepare" />
      <capability id="collect-data" label="泵浦数据采集" kind="observe" actionRef="collect" />
      <capability id="standby" label="泵浦待机" kind="control" actionRef="standby_reset" />
      <capability id="preionization" implementationStatus="declared-not-yet-modeled" label="预电离发射链路" kind="control" />
