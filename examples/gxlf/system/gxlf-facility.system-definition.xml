    <externalInterface id="personnel-counter" label="人员进出计数接口" interfaceRef="building-safety" status="protocol-unresolved" />
    <externalInterface id="wind-shower-door" label="风淋门状态接口" interfaceRef="building-safety" status="scope-unresolved" />
    <externalInterface id="parameter-service" label="发次参数服务端点" interfaceRef="parameter-store" status="contract-unresolved" />
    <externalInterface id="data-service" label="实验数据存储端点" interfaceRef="experiment-data-store" status="contract-unresolved" />
    <externalInterface id="reservation-service" label="服务预约端点" interfaceRef="reservation-service" />
    <externalInterface id="interlock-controller" label="安全联锁控制器" interfaceRef="interlock-bus" status="controller-unresolved" />
  </externalInterfaces>

  <topology>
    <path id="optical-path" label="束线光路" resourceRef="beamline">
      <endpoint ref="seed" role="source" selection="all" />
      <endpoint ref="shg" role="alternate-source" selection="beamline-01..beamline-08" />
      <endpoint ref="preamp" role="amplifier" mapping="preamp-group" />
      <endpoint ref="multipass" role="amplifier" mapping="one-per-beamline" />
      <endpoint ref="frequency-conversion" role="conversion" mapping="one-per-beamline" />
      <endpoint ref="target-alignment" role="target" />
      <connection id="seed-to-preamp" source="seed.optical-out" target="preamp.optical-in" relation="optical-feed" allocation="beamline" />
      <connection id="shg-to-preamp" source="shg.optical-out" target="preamp.optical-in" relation="alternate-optical-feed" allocation="beamline-01..beamline-08" />
      <connection id="preamp-to-multipass" source="preamp.optical-out" target="multipass.optical-in" relation="optical-feed" allocation="preamp-group" />
      <connection id="multipass-to-frequency-conversion" source="multipass.optical-out" target="frequency-conversion.optical-in" relation="optical-feed" allocation="one-per-beamline" />
      <connection id="frequency-conversion-to-target" source="frequency-conversion.optical-out" target="target-alignment.optical-in" relation="optical-feed" allocation="beamline" />
    </path>
    <path id="measurement-path" label="测量取样路径" resourceRef="beamline">
      <endpoint ref="multipass" role="sample-source" mapping="one-per-beamline" />
      <endpoint ref="measurement" role="sample" mapping="one-per-beamline" />
      <endpoint ref="diagnostics" role="diagnostics" />
      <connection id="multipass-to-measurement" source="multipass.sample-out" target="measurement.sample-in" relation="sample-feed" allocation="one-per-beamline" />
      <connection id="measurement-to-data-service" source="measurement.data-out" target="data-service.ingest" relation="measurement-data" />
      <connection id="diagnostics-to-data-service" source="diagnostics.data-out" target="data-service.ingest" relation="diagnostic-data" />
    </path>
    <path id="trigger-path" label="同步触发路径" resourceRef="beamline">
      <endpoint ref="synchronization" role="clock" mapping="one-per-beamline" />
      <endpoint ref="pump" role="pump-trigger" />
      <endpoint ref="switch-driver" role="switch-trigger" />
      <connection id="synchronization-to-pump" source="synchronization.timing-out" target="pump.trigger-in" relation="trigger" allocation="one-per-beamline" />
      <connection id="synchronization-to-switch" source="synchronization.timing-out" target="switch-driver.trigger-in" relation="trigger" allocation="one-per-beamline" />
      <connection id="synchronization-to-preamp" source="synchronization.timing-out" target="preamp.command-in" relation="recipe-control" allocation="preamp-group" />
      <connection id="synchronization-to-measurement" source="synchronization.timing-out" target="measurement.command-in" relation="recipe-control" allocation="one-per-beamline" />
    </path>
    <path id="interlock-path" label="安全联锁路径">
      <endpoint ref="control-environment" role="environment-observer" />
      <endpoint ref="vacuum" role="vacuum-observer" />
      <endpoint ref="multipass" role="titanium-pump-vacuum-observer" />
      <endpoint ref="shield-door" role="door-observer" />
      <endpoint ref="personnel-counter" role="personnel-observer" />
      <endpoint ref="wind-shower-door" role="unresolved-door-observer" />
      <endpoint ref="interlock-controller" role="interlock-controller" />
      <connection id="control-environment-to-interlock" source="control-environment.safety-out" target="interlock-controller.environment-in" relation="safety-observation" />
      <connection id="vacuum-to-interlock" source="vacuum.safety-out" target="interlock-controller.target-chamber-vacuum-in" relation="safety-observation" />
      <connection id="multipass-titanium-pump-to-interlock" source="multipass.safety-out" target="interlock-controller.titanium-pump-vacuum-in" relation="safety-observation" />
      <connection id="shield-door-to-interlock" source="shield-door.status-out" target="interlock-controller.door-in" relation="safety-observation" />
      <connection id="personnel-to-interlock" source="personnel-counter.count-out" target="interlock-controller.personnel-in" relation="safety-observation" />
      <connection id="interlock-to-central-control" source="interlock-controller.event-out" target="central-control.state-in" relation="interlock-event" />
      <connection id="interlock-broadcast-termination" source="interlock-controller.stop-out" target="all-components.command-in" relation="emergency-termination" cardinality="broadcast" />
    </path>
    <path id="control-path" label="集中控制与服务连接">
      <endpoint ref="central-control" role="orchestrator" />
      <endpoint ref="parameter-service" role="parameter-provider" />
      <endpoint ref="reservation-service" role="reservation-provider" />
      <endpoint ref="data-service" role="data-provider" />
      <connection id="parameter-service-to-central-control" source="parameter-service.parameter-out" target="central-control.parameter-in" relation="parameter-read" />
      <connection id="central-control-to-components" source="central-control.command-out" target="all-components.command-in" relation="command" cardinality="fan-out" />
      <connection id="components-to-health-events" source="all-components.health-out" target="central-control.state-in" relation="health-and-heartbeat" cardinality="fan-in" />
      <connection id="central-control-to-reservation" source="central-control.reservation" target="reservation-service.lease" relation="resource-reservation" />
      <connection id="components-to-data-service" source="all-components.data-out" target="data-service.ingest" relation="experiment-data" cardinality="fan-in" />
    </path>
  </topology>

  <mappings>
    <mapping id="preamp-to-beamline" source="preamp" target="beamline" sourceQuantity="10" targetQuantity="60" membersPerSource="6" />
    <mapping id="source-selection" source="seed shg" target="beamline" alternateCount="8" defaultSource="seed" />
    <mapping id="beamline-components" source="multipass measurement frequency-conversion synchronization" target="beamline" cardinality="one-to-one" />
  </mappings>

  <invariants>
    <invariant id="single-pump" severity="error" label="设施只有一套泵浦分系统">
      <require type="pump" quantity="1" />
    </invariant>
    <invariant id="beamline-source-selection" severity="error" label="束线光源选择受固定拓扑约束">
      <require resource="beamline-01..beamline-08" sources="seed shg" />
      <require resource="beamline-09..beamline-60" sources="seed" />
    </invariant>
    <invariant id="preamp-coverage" severity="error" label="十套预放覆盖六十条束线">
      <require mapping="preamp-to-beamline" />
    </invariant>
    <invariant id="one-to-one-beamline-services" severity="error" label="束线级设备按束线一一绑定">
      <require mapping="beamline-components" />
    </invariant>
    <invariant id="safety-interlock-inputs" severity="error" label="安全联锁必须具备环境、人员和真空输入">
      <require ref="shield-door" state="locked" />
      <require ref="personnel-counter" fact="zero" />
      <require ref="vacuum" fact="vacuumStable" />
    </invariant>
    <invariant id="synchronous-trigger-window" severity="error" label="同步触发具有固定时间窗口">
      <event connection="synchronization-to-pump" name="triggerAccepted" time="T0" />
      <event connection="synchronization-to-pump synchronization-to-switch" name="triggerReady" deadline="T+3s" />
      <event connection="synchronization-to-pump" name="formalTrigger" deadline="T+5s" />
    </invariant>
    <invariant id="exclusive-shot-reservation" severity="error" label="同一实验资源不能被多个发次同时占用">
      <require resource="shot-reservation" cardinality="exclusive" />
    </invariant>
  </invariants>

  <openIssues>
    <issue id="wind-shower-scope" status="open" impact="safety" summary="风淋门是否属于安全联锁和光路准直前置条件尚未确认" />
    <issue id="building-interface-contract" status="open" impact="interface" summary="屏蔽门和人员计数接口的协议、响应状态和执行时长尚未确认" />
    <issue id="emission-success-criterion" status="open" impact="operation" summary="正式发射完成以同步总体结果还是泵浦触发结果为硬判据尚未确认" />
    <issue id="postprocess-release-gate" status="open" impact="safety" summary="屏蔽门打开是否等待全部后处理或仅等待最终泵浦待机尚未确认" />
    <issue id="preionization-pump-count" status="assumed" impact="topology" summary="预电离链路按一套泵浦分系统建模，图纸中的第二套标注待修正" />
    <issue id="beamline-readiness-split" status="assumed" impact="operation" summary="测量打靶运动准备和打靶运动准备保留为两个独立就绪事实" />
  </openIssues>
</system-definition>
