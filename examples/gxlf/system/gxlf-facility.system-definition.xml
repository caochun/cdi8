          <outputs>
            <output signalRef="alignment-light" factRef="preampAwake" id="alignment-light">
              <requirements>
                <inputRequirement id="incident-light" pathRef="optical-path" inputPortRef="optical-in" signalRef="alignment-light" />
                <inputRequirement id="repeat-clock" pathRef="trigger-path" inputPortRef="command-in" signalRef="preamp-repeat" />
              </requirements>
            </output>
          </outputs>
        </port>
      </ports>
      <capabilities>
        <capability id="power-on-check" label="上电检查" kind="diagnostic" actionRef="power_on_check" />
        <capability id="function-check" label="功能检查" kind="diagnostic" actionRef="function_check" />
        <capability id="parameter-receive" label="参数接收" kind="control" actionRef="parameter_dispatch" />
        <capability id="wakeup" label="预放唤醒" kind="control" actionRef="preamp_wakeup">
          <requirements>
            <inputRequirement id="repeat-clock" maintain="execution" pathRef="trigger-path" inputPortRef="command-in" signalRef="preamp-repeat" />
          </requirements>
        </capability>
        <capability id="coarse-loop" label="能量粗闭环" kind="control" actionRef="coarse_loop">
          <requirements>
            <inputRequirement id="incident-light" maintain="execution" pathRef="optical-path" inputPortRef="optical-in" signalRef="alignment-light" />
            <inputRequirement id="repeat-clock" maintain="execution" pathRef="trigger-path" inputPortRef="command-in" signalRef="preamp-repeat" />
          </requirements>
        </capability>
        <capability id="fine-loop" label="能量精闭环" kind="control" actionRef="fine_loop">
          <requirements>
            <inputRequirement id="incident-light" maintain="execution" pathRef="optical-path" inputPortRef="optical-in" signalRef="alignment-light" />
            <inputRequirement id="repeat-clock" maintain="execution" pathRef="trigger-path" inputPortRef="command-in" signalRef="preamp-repeat" />
          </requirements>
        </capability>
        <capability id="single-recipe" label="预放单次配方" kind="control">
          <annotations>
            <notes>
              <note id="implementation" kind="implementation">
                <description>仅声明业务能力，尚未映射设备动作。</description>
              </note>
            </notes>
          </annotations>
        </capability>
        <capability id="clear-energy-meter" label="能量计清零" kind="control" actionRef="energy_meter_clear" />
        <capability id="collect-energy-data" label="能量数据采集" kind="observe" actionRef="energy_collect" />
        <capability id="standby" label="预放待机" kind="control" actionRef="standby_reset" />
      </capabilities>
    </componentType>
