<?xml version="1.0" encoding="UTF-8"?>
<system-definition id="gxlf-facility" version="1" label="GXLF 激光发射实验设施" xmlns="https://cdi8.cn/system-definition/v1">
  <scope id="laser-emission-facility" label="激光发射设施控制范围">
    <description>由集中管控系统管理的 60 束线激光发射设施及其安全、同步、诊断和基础设施接口。</description>
    <exclusions>发次编号、实验配方、本发阶段、本发采集历史、正式发射结果和后处理结果。</exclusions>
  </scope>
  <resources>
    <resource id="beamline" label="激光束线" quantity="60" unit="条" />
    <resource id="shot-reservation" label="实验资源预约" quantity="1" unit="项" />
  </resources>
  <interfaces>
    <interface id="tango-control" label="Tango 控制接口" category="software" interaction="request-response" protocol="TANGO" />
    <interface id="environment-http" label="控制环境 HTTP 接口" category="software" interaction="request-response" protocol="HTTP" />
    <interface id="building-safety" label="建安工程安防接口" status="unresolved" category="software" interaction="request-response" />
    <interface id="interlock-bus" label="安全联锁观测接口" category="software" interaction="event" />
    <interface id="timing-bus" label="同步时序接口" category="software" interaction="event" />
    <interface id="optical-link" label="束线光路连接" category="physical" interaction="flow" />
    <interface id="sample-link" label="测量取样连接" category="physical" interaction="flow" />
    <interface id="control-command-bus" label="集中控制命令总线" category="software" interaction="request-response" />
    <interface id="parameter-store" label="发次参数服务" status="contract-unresolved" category="software" interaction="event" />
    <interface id="experiment-data-store" label="实验数据存储服务" status="contract-unresolved" category="software" interaction="event" />
    <interface id="reservation-service" label="分系统服务预约接口" category="software" interaction="request-response" />
    <interface id="health-events" label="服务健康与心跳事件" category="software" interaction="event" />
  </interfaces>
  <signals>
    <signal id="alignment-light" label="准直光" interfaceRef="optical-link" />
    <signal id="preamp-repeat" label="预放重频许可" interfaceRef="timing-bus" />
  </signals>
  <controlNodes>
    <controlNode id="central-control" label="集中管控系统" role="orchestrator">
      <ports>
        <port id="command-out" direction="out" interfaceRef="control-command-bus" />
        <port id="state-in" direction="in" interfaceRef="health-events" />
        <port id="parameter-in" direction="in" interfaceRef="parameter-store" />
        <port id="data-in" direction="in" interfaceRef="experiment-data-store" />
        <port id="data-out" direction="out" interfaceRef="experiment-data-store" />
        <port id="reservation" direction="inout" interfaceRef="reservation-service" />
      </ports>
      <capabilities>
        <capability id="reserve-services" label="预约分系统服务" kind="coordination" />
        <capability id="dispatch-commands" label="下发控制命令" kind="coordination" />
        <capability id="monitor-health" label="监控服务健康和心跳" kind="observe" />
        <capability id="coordinate-interlock" label="协调安全联锁处置" kind="safety" />
      </capabilities>
    </controlNode>
  </controlNodes>
  <componentTypes>
    <componentType id="seed" label="光纤种子源组件" role="source" interfaceRef="tango-control" stateModelHref="components/seed-source-state-machine.scxml">
