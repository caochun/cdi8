      <capability id="maintain-vacuum" implementationStatus="declared-not-yet-modeled" label="真空保持" kind="observe" />
      <capability id="observe-pressure-restoration" implementationStatus="declared-not-yet-modeled" label="复压观测" kind="observe" />
    </componentType>

