<?xml version="1.0" encoding="UTF-8"?>
<facility-binding id="gxlf-facility-binding" definitionRef="gxlf-facility" version="1" xmlns="https://cdi8.cn/facility-binding/v1">
  <instanceBindings resolution="runtime-configuration">
    <instanceBinding runtimeKey="seed" runtimePattern="seed_{index}" instanceSetRef="seed" />
    <instanceBinding runtimeKey="shg" runtimePattern="shg_{index}" instanceSetRef="shg" />
    <instanceBinding runtimeKey="preamp" runtimePattern="preamp_{index}" instanceSetRef="preamp" />
    <instanceBinding runtimeKey="multipass" runtimePattern="multipass_{index}" instanceSetRef="multipass" />
    <instanceBinding runtimeKey="pump" runtimePattern="pump_{index}" instanceSetRef="pump" />
    <instanceBinding runtimeKey="measurement" runtimePattern="measurement_{index}" instanceSetRef="measurement" />
    <instanceBinding runtimeKey="frequency-conversion" runtimePattern="frequency-conversion_{index}" instanceSetRef="frequency-conversion" />
    <instanceBinding runtimeKey="target-alignment" runtimePattern="target-alignment_{index}" instanceSetRef="target-alignment" />
    <instanceBinding runtimeKey="vacuum" runtimePattern="vacuum_{index}" instanceSetRef="vacuum" />
    <instanceBinding runtimeKey="diagnostics" runtimePattern="diagnostics_{index}" instanceSetRef="diagnostics" />
    <instanceBinding runtimeKey="synchronization" runtimePattern="synchronization_{index}" instanceSetRef="synchronization" />
    <instanceBinding runtimeKey="switch-driver" runtimePattern="switch-driver_{index}" instanceSetRef="switch-driver" />
    <instanceBinding runtimeKey="cooling" runtimePattern="cooling_{index}" instanceSetRef="cooling" />
    <instanceBinding runtimeKey="control-environment" runtimePattern="control-environment_{index}" instanceSetRef="control-environment" />
  </instanceBindings>
  <beamlineBindings resolution="runtime-configuration">
    <beamlineBinding id="beamlines" resourceRef="beamline">
      <mappingBindings>
        <mappingBinding mappingRef="preamp-to-beamline" />
        <mappingBinding mappingRef="beamline-components" />
        <mappingBinding mappingRef="source-selection" />
      </mappingBindings>
    </beamlineBinding>
  </beamlineBindings>
  <externalBindings resolution="runtime-configuration">
    <externalBinding runtimeKey="shield-door" status="endpoint-unresolved" externalEndpointRef="shield-door" />
    <externalBinding runtimeKey="personnel-counter" status="endpoint-unresolved" externalEndpointRef="personnel-counter" />
    <externalBinding runtimeKey="wind-shower-door" status="scope-unresolved" externalEndpointRef="wind-shower-door" />
    <externalBinding runtimeKey="parameter-service" status="contract-unresolved" externalEndpointRef="parameter-service" />
    <externalBinding runtimeKey="data-service" status="contract-unresolved" externalEndpointRef="data-service" />
    <externalBinding runtimeKey="reservation-service" externalEndpointRef="reservation-service" />
    <externalBinding runtimeKey="interlock-controller" status="controller-unresolved" externalEndpointRef="interlock-controller" />
  </externalBindings>
</facility-binding>
