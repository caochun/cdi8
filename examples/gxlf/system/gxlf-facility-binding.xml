<?xml version="1.0" encoding="UTF-8"?>
<facility-binding id="gxlf-facility-binding" definitionRef="gxlf-facility" version="1" xmlns="https://cdi8.cn/facility-binding/v1">
  <instanceBindings resolution="runtime-configuration">
    <instanceBinding deviceBindingKey="seed" deviceIdPattern="seed_{index}" instanceSetRef="seed" />
    <instanceBinding deviceBindingKey="shg" deviceIdPattern="shg_{index}" instanceSetRef="shg" />
    <instanceBinding deviceBindingKey="preamp" deviceIdPattern="preamp_{index}" instanceSetRef="preamp" />
    <instanceBinding deviceBindingKey="multipass" deviceIdPattern="multipass_{index}" instanceSetRef="multipass" />
    <instanceBinding deviceBindingKey="pump" deviceIdPattern="pump_{index}" instanceSetRef="pump" />
    <instanceBinding deviceBindingKey="measurement" deviceIdPattern="measurement_{index}" instanceSetRef="measurement" />
    <instanceBinding deviceBindingKey="frequency-conversion" deviceIdPattern="frequency-conversion_{index}" instanceSetRef="frequency-conversion" />
    <instanceBinding deviceBindingKey="target-alignment" deviceIdPattern="target-alignment_{index}" instanceSetRef="target-alignment" />
    <instanceBinding deviceBindingKey="vacuum" deviceIdPattern="vacuum_{index}" instanceSetRef="vacuum" />
    <instanceBinding deviceBindingKey="diagnostics" deviceIdPattern="diagnostics_{index}" instanceSetRef="diagnostics" />
    <instanceBinding deviceBindingKey="synchronization" deviceIdPattern="synchronization_{index}" instanceSetRef="synchronization" />
    <instanceBinding deviceBindingKey="switch-driver" deviceIdPattern="switch-driver_{index}" instanceSetRef="switch-driver" />
    <instanceBinding deviceBindingKey="cooling" deviceIdPattern="cooling_{index}" instanceSetRef="cooling" />
    <instanceBinding deviceBindingKey="control-environment" deviceIdPattern="control-environment_{index}" instanceSetRef="control-environment" />
  </instanceBindings>
  <beamlineBindings resolution="runtime-configuration">
    <beamlineBinding id="beamlines" resourceRef="beamline">
      <mappingBindings>
        <mappingBinding mappingRef="preamp-to-beamline" />
        <mappingBinding mappingRef="beamline-components" />
        <mappingBinding mappingRef="source-selection" />
      </mappingBindings>
    </beamlineBinding>
  </beamlineBindings>
  <externalBindings resolution="runtime-configuration">
    <externalBinding deviceBindingKey="shield-door" status="endpoint-unresolved" externalEndpointRef="shield-door" />
    <externalBinding deviceBindingKey="personnel-counter" status="endpoint-unresolved" externalEndpointRef="personnel-counter" />
    <externalBinding deviceBindingKey="wind-shower-door" status="scope-unresolved" externalEndpointRef="wind-shower-door" />
    <externalBinding deviceBindingKey="parameter-service" status="contract-unresolved" externalEndpointRef="parameter-service" />
    <externalBinding deviceBindingKey="data-service" status="contract-unresolved" externalEndpointRef="data-service" />
    <externalBinding deviceBindingKey="reservation-service" externalEndpointRef="reservation-service" />
    <externalBinding deviceBindingKey="interlock-controller" status="controller-unresolved" externalEndpointRef="interlock-controller" />
  </externalBindings>
</facility-binding>
