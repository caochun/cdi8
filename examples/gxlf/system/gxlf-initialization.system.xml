<?xml version="1.0" encoding="UTF-8"?>
<system-state-model xmlns="https://cdi8.cn/system-state/v1" id="gxlf-initialization" initial="uninitialized" evidenceMaxAgeMs="2000">
  <state id="uninitialized" label="未初始化">
    <require collection="allComponents" component="seed" states="statusUnknown powerOnChecked" />
    <require collection="allComponents" component="shg" states="unchecked powerOnOk" />
    <require collection="allComponents" component="preamp" states="unchecked powerOnOk" />
    <require collection="allComponents" component="multipass" states="unchecked powerOnOk" />
  </state>
  <state id="powered" label="已上电">
    <require collection="allComponents" component="seed" states="powerOnChecked" outerStates="ready" />
    <require collection="allComponents" component="shg" states="powerOnOk" outerStates="ready" />
    <require collection="allComponents" component="preamp" states="powerOnOk" outerStates="ready" />
    <require collection="allComponents" component="multipass" states="powerOnOk" outerStates="ready" />
  </state>
  <state id="initialized" label="已初始化">
    <require collection="allComponents" component="seed" states="qualified" />
    <require collection="allComponents" component="shg" states="functionReady" />
    <require collection="allComponents" component="preamp" states="functionReady" />
    <require collection="allComponents" component="multipass" states="functionReady" />
  </state>
  <transition id="powerChecksVerified" from="uninitialized" to="powered" />
  <transition id="functionChecksVerified" from="powered" to="initialized" />
</system-state-model>
