<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
 xmlns:sys="https://cdi8.cn/system-state/v1" xmlns:act="https://cdi8.cn/control/action-contract/v1"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="https://cdi8.cn/control/v2">
  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:process id="gxlf_system_initialization" name="GXLF 十四类设备初始化" isExecutable="true">
    <bpmn:documentation>全体参与实例先上电检查、再功能检查；不执行设备上电。系统状态模型要求十四类组件均有绑定。该流程仅完成全生命周期的初始化段，不执行发射。</bpmn:documentation>
    <bpmn:extensionElements><sys:systemModel ref="gxlf-experiment" /></bpmn:extensionElements>
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="全体设备两阶段检查">
      <bpmn:startEvent id="scope_start" />
      <bpmn:serviceTask id="system_state_open" name="建立系统状态观察" flowable:expression="${systemStates.open(execution)}" />
      <bpmn:serviceTask id="power_checks" name="全部设备·上电检查" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="power_on_check" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;powerOnChecked&quot;,&quot;shg&quot;:&quot;powerOnOk&quot;,&quot;preamp&quot;:&quot;powerOnOk&quot;,&quot;multipass&quot;:&quot;powerOnOk&quot;,&quot;pump&quot;:&quot;powerOnOk&quot;,&quot;measurement&quot;:&quot;powerOnOk&quot;,&quot;frequency-conversion&quot;:&quot;powerOnOk&quot;,&quot;target-alignment&quot;:&quot;powerOnOk&quot;,&quot;vacuum&quot;:&quot;powerOnOk&quot;,&quot;diagnostics&quot;:&quot;powerOnOk&quot;,&quot;synchronization&quot;:&quot;powerOnOk&quot;,&quot;switch-driver&quot;:&quot;powerOnOk&quot;,&quot;cooling&quot;:&quot;powerOnOk&quot;,&quot;control-environment&quot;:&quot;powerOnOk&quot;}" />
          <act:actionContract /><sys:requires state="uninitialized" />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${allComponents}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="power_timeout" attachedToRef="power_checks" cancelActivity="true" name="检查超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:serviceTask id="function_checks" name="全部设备·功能检查" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="function_check" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;qualified&quot;,&quot;shg&quot;:&quot;functionReady&quot;,&quot;preamp&quot;:&quot;functionReady&quot;,&quot;multipass&quot;:&quot;functionReady&quot;,&quot;pump&quot;:&quot;functionReady&quot;,&quot;measurement&quot;:&quot;functionReady&quot;,&quot;frequency-conversion&quot;:&quot;functionReady&quot;,&quot;target-alignment&quot;:&quot;functionReady&quot;,&quot;vacuum&quot;:&quot;functionReady&quot;,&quot;diagnostics&quot;:&quot;functionReady&quot;,&quot;synchronization&quot;:&quot;functionReady&quot;,&quot;switch-driver&quot;:&quot;functionReady&quot;,&quot;cooling&quot;:&quot;functionReady&quot;,&quot;control-environment&quot;:&quot;functionReady&quot;}" />
          <act:actionContract /><sys:requires state="powered" />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${allComponents}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="function_timeout" attachedToRef="function_checks" cancelActivity="true" name="检查超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:serviceTask id="report_powered" name="核验全体上电完成" flowable:expression="${systemStates.report(execution, 'powerChecksVerified')}" />
      <bpmn:serviceTask id="report_initialized" name="核验全体功能完成" flowable:expression="${systemStates.report(execution, 'functionChecksVerified')}" />
      <bpmn:serviceTask id="finish" name="记录初始化成功" flowable:expression="${componentTasks.succeeded(execution)}" />
      <bpmn:endEvent id="scope_end" name="初始化完成" />
      <bpmn:endEvent id="raise_timeout" name="检查失败"><bpmn:errorEventDefinition errorRef="device_error" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="scope_start__system_state_open" sourceRef="scope_start" targetRef="system_state_open" />
      <bpmn:sequenceFlow id="system_state_open__power_checks" sourceRef="system_state_open" targetRef="power_checks" />
      <bpmn:sequenceFlow id="power_checks__report_powered" sourceRef="power_checks" targetRef="report_powered" />
      <bpmn:sequenceFlow id="report_powered__function_checks" sourceRef="report_powered" targetRef="function_checks" />
      <bpmn:sequenceFlow id="function_checks__report_initialized" sourceRef="function_checks" targetRef="report_initialized" />
      <bpmn:sequenceFlow id="report_initialized__finish" sourceRef="report_initialized" targetRef="finish" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
      <bpmn:sequenceFlow id="power_timeout__raise_timeout" sourceRef="power_timeout" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="function_timeout__raise_timeout" sourceRef="function_timeout" targetRef="raise_timeout" />
    </bpmn:subProcess>
    <bpmn:endEvent id="success" name="完成" />
    <bpmn:serviceTask id="failure" name="记录失败与未决设备动作" flowable:expression="${componentTasks.failed(execution)}" />
    <bpmn:endEvent id="failed_end" name="流程停止"><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="normal" cancelActivity="true" name="动作失败"><bpmn:errorEventDefinition errorRef="device_error" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="stop_boundary" attachedToRef="normal" cancelActivity="true" name="停止流程"><bpmn:messageEventDefinition messageRef="stop_message" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="workflow_timeout" attachedToRef="normal" cancelActivity="true" name="流程超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${workflowTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="start__normal" sourceRef="start" targetRef="normal" />
    <bpmn:sequenceFlow id="normal__success" sourceRef="normal" targetRef="success" />
    <bpmn:sequenceFlow id="error_boundary__failure" sourceRef="error_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="stop_boundary__failure" sourceRef="stop_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="workflow_timeout__failure" sourceRef="workflow_timeout" targetRef="failure" />
    <bpmn:sequenceFlow id="failure__failed_end" sourceRef="failure" targetRef="failed_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_gxlf_system_initialization"><bpmndi:BPMNPlane id="plane_gxlf_system_initialization" bpmnElement="gxlf_system_initialization">
    <bpmndi:BPMNShape id="shape_start" bpmnElement="start"><dc:Bounds x="20" y="120" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_normal" bpmnElement="normal" isExpanded="true"><dc:Bounds x="90" y="30" width="1580" height="300" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_success" bpmnElement="success"><dc:Bounds x="1710" y="120" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_failure" bpmnElement="failure"><dc:Bounds x="1090" y="430" width="220" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_failed_end" bpmnElement="failed_end"><dc:Bounds x="1400" y="452" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_error_boundary" bpmnElement="error_boundary"><dc:Bounds x="440" y="312" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_stop_boundary" bpmnElement="stop_boundary"><dc:Bounds x="700" y="312" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_workflow_timeout" bpmnElement="workflow_timeout"><dc:Bounds x="960" y="312" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_raise_timeout" bpmnElement="raise_timeout"><dc:Bounds x="750" y="260" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_power_timeout" bpmnElement="power_timeout"><dc:Bounds x="604" y="172" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_function_timeout" bpmnElement="function_timeout"><dc:Bounds x="1034" y="172" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_scope_start" bpmnElement="scope_start"><dc:Bounds x="120" y="120" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_system_state_open" bpmnElement="system_state_open"><dc:Bounds x="190" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_power_checks" bpmnElement="power_checks"><dc:Bounds x="420" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_report_powered" bpmnElement="report_powered"><dc:Bounds x="650" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_function_checks" bpmnElement="function_checks"><dc:Bounds x="880" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_report_initialized" bpmnElement="report_initialized"><dc:Bounds x="1110" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_finish" bpmnElement="finish"><dc:Bounds x="1340" y="98" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_scope_end" bpmnElement="scope_end"><dc:Bounds x="1590" y="120" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="edge_scope_start__system_state_open" bpmnElement="scope_start__system_state_open"><di:waypoint x="156" y="138" /><di:waypoint x="190" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_system_state_open__power_checks" bpmnElement="system_state_open__power_checks"><di:waypoint x="380" y="138" /><di:waypoint x="420" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_power_checks__report_powered" bpmnElement="power_checks__report_powered"><di:waypoint x="610" y="138" /><di:waypoint x="650" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_report_powered__function_checks" bpmnElement="report_powered__function_checks"><di:waypoint x="840" y="138" /><di:waypoint x="880" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_function_checks__report_initialized" bpmnElement="function_checks__report_initialized"><di:waypoint x="1070" y="138" /><di:waypoint x="1110" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_report_initialized__finish" bpmnElement="report_initialized__finish"><di:waypoint x="1300" y="138" /><di:waypoint x="1340" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_finish__scope_end" bpmnElement="finish__scope_end"><di:waypoint x="1530" y="138" /><di:waypoint x="1590" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_power_timeout__raise_timeout" bpmnElement="power_timeout__raise_timeout"><di:waypoint x="622" y="208" /><di:waypoint x="622" y="278" /><di:waypoint x="750" y="278" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_function_timeout__raise_timeout" bpmnElement="function_timeout__raise_timeout"><di:waypoint x="1052" y="208" /><di:waypoint x="1052" y="278" /><di:waypoint x="750" y="278" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_start__normal" bpmnElement="start__normal"><di:waypoint x="56" y="138" /><di:waypoint x="90" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_normal__success" bpmnElement="normal__success"><di:waypoint x="1670" y="180" /><di:waypoint x="1710" y="138" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_error_boundary__failure" bpmnElement="error_boundary__failure"><di:waypoint x="458" y="348" /><di:waypoint x="458" y="470" /><di:waypoint x="1090" y="470" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_stop_boundary__failure" bpmnElement="stop_boundary__failure"><di:waypoint x="718" y="348" /><di:waypoint x="718" y="470" /><di:waypoint x="1090" y="470" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_workflow_timeout__failure" bpmnElement="workflow_timeout__failure"><di:waypoint x="978" y="348" /><di:waypoint x="978" y="470" /><di:waypoint x="1090" y="470" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="edge_failure__failed_end" bpmnElement="failure__failed_end"><di:waypoint x="1310" y="470" /><di:waypoint x="1400" y="470" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
