<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:act="https://cdi8.cn/control/action-contract/v1" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns6="http://www.omg.org/spec/DD/20100524/DI" xmlns:sys="https://cdi8.cn/system-state/v1" targetNamespace="https://cdi8.cn/control/v2">
  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:process id="gxlf_initialization_parameter_dispatch" name="GXLF 初始化与参数下发（技术验证切片）" isExecutable="true">
    <bpmn:documentation>全体参与实例先上电检查、再功能检查，随后对十二类可参数化设备执行本发参数下发；不执行设备上电。真空靶室和控制环境作为当前状态观测对象。该流程用于验证 initialized → configuring → configured 的系统状态驱动路径。</bpmn:documentation>
    <bpmn:extensionElements>
      <sys:systemModel ref="gxlf-experiment" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="全体设备两阶段检查">
      <bpmn:startEvent id="scope_start" />
      <bpmn:serviceTask id="system_state_open" name="建立系统状态观察" flowable:expression="${systemStates.open(execution)}" />
      <bpmn:serviceTask id="power_checks" name="全部设备·上电检查" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="power_on_check" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;powerOnChecked&quot;,&quot;shg&quot;:&quot;powerOnOk&quot;,&quot;preamp&quot;:&quot;powerOnOk&quot;,&quot;multipass&quot;:&quot;powerOnOk&quot;,&quot;pump&quot;:&quot;powerOnOk&quot;,&quot;measurement&quot;:&quot;powerOnOk&quot;,&quot;frequency-conversion&quot;:&quot;powerOnOk&quot;,&quot;target-alignment&quot;:&quot;powerOnOk&quot;,&quot;vacuum&quot;:&quot;powerOnOk&quot;,&quot;diagnostics&quot;:&quot;powerOnOk&quot;,&quot;synchronization&quot;:&quot;powerOnOk&quot;,&quot;switch-driver&quot;:&quot;powerOnOk&quot;,&quot;cooling&quot;:&quot;powerOnOk&quot;,&quot;control-environment&quot;:&quot;powerOnOk&quot;}" />
          <act:actionContract />
          <sys:requires state="uninitialized" />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${allComponents}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="power_timeout" attachedToRef="power_checks" cancelActivity="true" name="检查超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="function_checks" name="全部设备·功能检查" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="function_check" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;qualified&quot;,&quot;shg&quot;:&quot;functionReady&quot;,&quot;preamp&quot;:&quot;functionReady&quot;,&quot;multipass&quot;:&quot;functionReady&quot;,&quot;pump&quot;:&quot;functionReady&quot;,&quot;measurement&quot;:&quot;functionReady&quot;,&quot;frequency-conversion&quot;:&quot;functionReady&quot;,&quot;target-alignment&quot;:&quot;functionReady&quot;,&quot;vacuum&quot;:&quot;functionReady&quot;,&quot;diagnostics&quot;:&quot;functionReady&quot;,&quot;synchronization&quot;:&quot;functionReady&quot;,&quot;switch-driver&quot;:&quot;functionReady&quot;,&quot;cooling&quot;:&quot;functionReady&quot;,&quot;control-environment&quot;:&quot;functionReady&quot;}" />
          <act:actionContract />
          <sys:requires state="powered" />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${allComponents}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="function_timeout" attachedToRef="function_checks" cancelActivity="true" name="检查超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="report_powered" name="核验全体上电完成" flowable:expression="${systemStates.report(execution, 'powerChecksVerified')}" />
      <bpmn:serviceTask id="report_initialized" name="核验全体功能完成" flowable:expression="${systemStates.report(execution, 'functionChecksVerified')}" />
      <bpmn:serviceTask id="begin_configuration" name="进入本发参数接收" flowable:expression="${systemStates.report(execution, 'beginConfiguration')}">
        <bpmn:extensionElements>
          <sys:report transition="beginConfiguration" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="parameter_checks" name="十二类设备·参数下发" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="parameter_dispatch" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;configured&quot;,&quot;shg&quot;:&quot;parameterOk&quot;,&quot;preamp&quot;:&quot;parameterOk&quot;,&quot;multipass&quot;:&quot;parameterOk&quot;,&quot;pump&quot;:&quot;parameterOk&quot;,&quot;measurement&quot;:&quot;parameterOk&quot;,&quot;frequency-conversion&quot;:&quot;parameterOk&quot;,&quot;target-alignment&quot;:&quot;parameterOk&quot;,&quot;diagnostics&quot;:&quot;parameterOk&quot;,&quot;synchronization&quot;:&quot;parameterOk&quot;,&quot;switch-driver&quot;:&quot;parameterOk&quot;,&quot;cooling&quot;:&quot;parameterOk&quot;}" />
          <act:actionContract />
          <sys:requires state="configuring" />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${parameterTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="parameter_timeout" attachedToRef="parameter_checks" cancelActivity="true" name="参数下发超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="report_configured" name="核验本发参数已接收" flowable:expression="${systemStates.report(execution, 'configurationVerified')}">
        <bpmn:extensionElements>
          <sys:report transition="configurationVerified" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="finish" name="记录参数下发成功" flowable:expression="${componentTasks.succeeded(execution)}" />
      <bpmn:endEvent id="scope_end" name="初始化完成" />
      <bpmn:endEvent id="raise_timeout" name="检查失败">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="scope_start__system_state_open" sourceRef="scope_start" targetRef="system_state_open" />
      <bpmn:sequenceFlow id="system_state_open__power_checks" sourceRef="system_state_open" targetRef="power_checks" />
      <bpmn:sequenceFlow id="power_checks__report_powered" sourceRef="power_checks" targetRef="report_powered" />
      <bpmn:sequenceFlow id="report_powered__function_checks" sourceRef="report_powered" targetRef="function_checks" />
      <bpmn:sequenceFlow id="function_checks__report_initialized" sourceRef="function_checks" targetRef="report_initialized" />
      <bpmn:sequenceFlow id="report_initialized__begin_configuration" sourceRef="report_initialized" targetRef="begin_configuration" />
      <bpmn:sequenceFlow id="begin_configuration__parameter_checks" sourceRef="begin_configuration" targetRef="parameter_checks" />
      <bpmn:sequenceFlow id="parameter_checks__report_configured" sourceRef="parameter_checks" targetRef="report_configured" />
      <bpmn:sequenceFlow id="parameter_timeout__raise_timeout" sourceRef="parameter_timeout" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
      <bpmn:sequenceFlow id="power_timeout__raise_timeout" sourceRef="power_timeout" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="function_timeout__raise_timeout" sourceRef="function_timeout" targetRef="raise_timeout" />
      <bpmn:serviceTask id="begin_preparation" name="进入发射准备" flowable:expression="${systemStates.report(execution, 'beginPreparation')}">
        <bpmn:extensionElements>
          <sys:report transition="beginPreparation" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="clear_area" name="控制环境·清场完成" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="{&quot;control-environment&quot;:&quot;clear_area&quot;}" />
          <flowable:field name="expectedState" stringValue="{&quot;control-environment&quot;:&quot;clearanceComplete&quot;}" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${controlEnvironmentTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="lock_door" name="控制环境·建立联锁" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="{&quot;control-environment&quot;:&quot;lock_door&quot;}" />
          <flowable:field name="expectedState" stringValue="{&quot;control-environment&quot;:&quot;interlockEstablished&quot;}" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${controlEnvironmentTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="report_interlocked" name="确认安全联锁（技术验证）" flowable:expression="${systemStates.report(execution, 'safetyVerified')}">
        <bpmn:extensionElements>
          <sys:report transition="safetyVerified" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="source_emit" name="所选光源·稳定出光" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="{&quot;seed&quot;:&quot;seed_source_emit&quot;,&quot;shg&quot;:&quot;frequency_doubled_emit&quot;}" />
          <flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;stableEmission&quot;,&quot;shg&quot;:&quot;stableEmission&quot;}" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${sourceTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="preamp_wakeup" name="预放·唤醒" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="preamp_wakeup" />
          <flowable:field name="expectedState" stringValue="wakeupReady" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="preamp_coarse" name="预放·能量粗闭环" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="coarse_loop" />
          <flowable:field name="expectedState" stringValue="coarseLoopOk" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="preamp_fine" name="预放·能量精闭环" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="fine_loop" />
          <flowable:field name="expectedState" stringValue="fineLoopOk" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="multipass_collimation" name="多程·光路准直" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="collimation" />
          <flowable:field name="expectedState" stringValue="collimationReady" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${multipassTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="multipass_shot" name="多程·进入打靶状态" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="enter_shot" />
          <flowable:field name="expectedState" stringValue="shotReady" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${multipassTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="measurement_aim" name="测量·靶瞄准备" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="componentCommand" stringValue="true" /><flowable:field name="action" stringValue="aim_prepare" /><flowable:field name="expectedState" stringValue="aimPrepared" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${measurementTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
  <bpmn:serviceTask id="measurement_motion" name="测量·打靶运动准备" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="motion_prepare" />
          <flowable:field name="expectedState" stringValue="motionPrepared" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${measurementTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="target_preposition" name="靶瞄·实验靶预定位" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="componentCommand" stringValue="true" /><flowable:field name="action" stringValue="target_preposition" /><flowable:field name="expectedState" stringValue="targetPrepositioned" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${targetAlignmentTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
  <bpmn:serviceTask id="target_simulation" name="靶瞄·模拟靶定位" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="componentCommand" stringValue="true" /><flowable:field name="action" stringValue="simulation_position" /><flowable:field name="expectedState" stringValue="simulationPositioned" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${targetAlignmentTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
  <bpmn:serviceTask id="target_guide" name="靶瞄·光束引导" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="componentCommand" stringValue="true" /><flowable:field name="action" stringValue="beam_guide" /><flowable:field name="expectedState" stringValue="beamGuideComplete" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${targetAlignmentTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
  <bpmn:serviceTask id="target_reset" name="靶瞄·实验靶复位" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="componentCommand" stringValue="true" /><flowable:field name="action" stringValue="target_reset" /><flowable:field name="expectedState" stringValue="targetReset" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${targetAlignmentTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
  <bpmn:serviceTask id="target_shot" name="靶瞄·进入打靶状态" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="enter_shot" />
          <flowable:field name="expectedState" stringValue="shotReady" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${targetAlignmentTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="diagnostics_ready" name="诊断·设备发射准备" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="device_confirm" />
          <flowable:field name="expectedState" stringValue="deviceConfirmed" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${diagnosticsTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="pump_prepare" name="泵浦·发射准备" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="emission_prepare" />
          <flowable:field name="expectedState" stringValue="emissionPrepared" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${pumpTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="sync_repeat" name="同步·预放重频配方" flowable:delegateExpression="${componentCommand}">
        <bpmn:extensionElements>
          <flowable:field name="componentCommand" stringValue="true" />
          <flowable:field name="action" stringValue="repeat_mode" />
          <flowable:field name="expectedState" stringValue="repeatConfigured" />
          <act:actionContract />
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${synchronizationTargets}" flowable:elementVariable="target" />
      </bpmn:serviceTask>
      <bpmn:serviceTask id="report_prepared" name="确认发射准备完成（技术验证）" flowable:expression="${systemStates.report(execution, 'preparationVerified')}">
        <bpmn:extensionElements>
          <sys:report transition="preparationVerified" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="report_configured__begin_preparation" sourceRef="report_configured" targetRef="begin_preparation" />
      <bpmn:sequenceFlow id="begin_preparation__clear_area" sourceRef="begin_preparation" targetRef="clear_area" />
      <bpmn:sequenceFlow id="clear_area__lock_door" sourceRef="clear_area" targetRef="lock_door" />
      <bpmn:sequenceFlow id="lock_door__report_interlocked" sourceRef="lock_door" targetRef="report_interlocked" />
      <bpmn:sequenceFlow id="report_interlocked__source_emit" sourceRef="report_interlocked" targetRef="source_emit" />
      <bpmn:sequenceFlow id="source_emit__preamp_wakeup" sourceRef="source_emit" targetRef="preamp_wakeup" />
      <bpmn:sequenceFlow id="preamp_wakeup__preamp_coarse" sourceRef="preamp_wakeup" targetRef="preamp_coarse" />
      <bpmn:sequenceFlow id="preamp_coarse__preamp_fine" sourceRef="preamp_coarse" targetRef="preamp_fine" />
      <bpmn:sequenceFlow id="preamp_fine__multipass_collimation" sourceRef="preamp_fine" targetRef="multipass_collimation" />
      <bpmn:sequenceFlow id="multipass_collimation__multipass_shot" sourceRef="multipass_collimation" targetRef="multipass_shot" />
      <bpmn:sequenceFlow id="multipass_shot__measurement_aim" sourceRef="multipass_shot" targetRef="measurement_aim" />
      <bpmn:sequenceFlow id="measurement_aim__measurement_motion" sourceRef="measurement_aim" targetRef="measurement_motion" />
      <bpmn:sequenceFlow id="measurement_motion__target_preposition" sourceRef="measurement_motion" targetRef="target_preposition" />
      <bpmn:sequenceFlow id="target_preposition__target_simulation" sourceRef="target_preposition" targetRef="target_simulation" />
      <bpmn:sequenceFlow id="target_simulation__target_guide" sourceRef="target_simulation" targetRef="target_guide" />
      <bpmn:sequenceFlow id="target_guide__target_reset" sourceRef="target_guide" targetRef="target_reset" />
      <bpmn:sequenceFlow id="target_reset__target_shot" sourceRef="target_reset" targetRef="target_shot" />
      <bpmn:sequenceFlow id="target_shot__diagnostics_ready" sourceRef="target_shot" targetRef="diagnostics_ready" />
      <bpmn:sequenceFlow id="diagnostics_ready__pump_prepare" sourceRef="diagnostics_ready" targetRef="pump_prepare" />
      <bpmn:sequenceFlow id="pump_prepare__sync_repeat" sourceRef="pump_prepare" targetRef="sync_repeat" />
      <bpmn:sequenceFlow id="sync_repeat__report_prepared" sourceRef="sync_repeat" targetRef="report_prepared" />
      <bpmn:sequenceFlow id="report_prepared__finish" sourceRef="report_prepared" targetRef="finish" />
    </bpmn:subProcess>
    <bpmn:endEvent id="success" name="完成" />
    <bpmn:serviceTask id="failure" name="记录失败与未决设备动作" flowable:expression="${componentTasks.failed(execution)}" />
    <bpmn:endEvent id="failed_end" name="流程停止">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="normal" cancelActivity="true" name="动作失败">
      <bpmn:errorEventDefinition errorRef="device_error" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="stop_boundary" attachedToRef="normal" cancelActivity="true" name="停止流程">
      <bpmn:messageEventDefinition messageRef="stop_message" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="workflow_timeout" attachedToRef="normal" cancelActivity="true" name="流程超时">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>${workflowTimeout}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="start__normal" sourceRef="start" targetRef="normal" />
    <bpmn:sequenceFlow id="normal__success" sourceRef="normal" targetRef="success" />
    <bpmn:sequenceFlow id="error_boundary__failure" sourceRef="error_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="stop_boundary__failure" sourceRef="stop_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="workflow_timeout__failure" sourceRef="workflow_timeout" targetRef="failure" />
    <bpmn:sequenceFlow id="failure__failed_end" sourceRef="failure" targetRef="failed_end" />
  </bpmn:process>
  <ns4:BPMNDiagram id="diagram_gxlf_system_initialization">
    <ns4:BPMNPlane id="plane_gxlf_system_initialization" bpmnElement="gxlf_system_initialization">
      <ns4:BPMNShape id="shape_start" bpmnElement="start">
        <ns5:Bounds x="20" y="120" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="shape_normal" bpmnElement="normal" isExpanded="true">
        <ns5:Bounds x="90" y="30" width="1580" height="300" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="shape_success" bpmnElement="success">
        <ns5:Bounds x="1710" y="120" width="36" height="36" />
