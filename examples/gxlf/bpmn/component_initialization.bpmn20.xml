      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="shg_power_timeout__raise_timeout" sourceRef="shg_power_timeout" targetRef="raise_timeout" />
      <bpmn:boundaryEvent id="preamp_power_timeout" attachedToRef="preamp_power_wait" cancelActivity="true" name="检查超时">
