      <bpmn:serviceTask id="preamp_function_wait" name="再生与双程放大·功能检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;function_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;functionReady&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /><sys:requires state="powered" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
