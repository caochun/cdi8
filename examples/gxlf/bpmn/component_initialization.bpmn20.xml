  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:process id="component_initialization" isExecutable="true" name="四类组件初始化">
    <bpmn:documentation>本流程使用标准 BPMN 显式建模当前四类组件及其实例。四个组件分支并行执行上电检查，全部分支完成后再并行执行功能检查。每个组件分支内部使用非串行多实例，分别绑定 seedTargets、shgTargets、preampTargets、multipassTargets。上电检查只确认设备已上电，不执行上电。</bpmn:documentation>
    <bpmn:extensionElements><sys:systemModel ref="gxlf-initialization" /></bpmn:extensionElements>
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="四类组件初始化">
      <bpmn:extensionElements>
      </bpmn:extensionElements>
      <bpmn:startEvent id="scope_start" name="开始" />
      <bpmn:endEvent id="scope_end" name="初始化完成" />
      <bpmn:endEvent id="raise_timeout" name="检查超时">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:parallelGateway id="power_split" name="四类组件并行上电检查" />
      <bpmn:parallelGateway id="power_join" name="全部上电检查完成" />
      <bpmn:parallelGateway id="function_split" name="四类组件并行功能检查" />
      <bpmn:parallelGateway id="function_join" name="全部功能检查完成" />
      <bpmn:serviceTask id="finish" name="确认四类组件初始化完成" flowable:expression="${tango.initializationFinish(execution)}">
        <bpmn:extensionElements>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="system_state_open" name="初始化系统状态" flowable:expression="${systemStates.open(execution)}" />
      <bpmn:serviceTask id="seed_power_wait" name="光纤种子源·上电检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;seed&quot;:&quot;power_on_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;powerOnChecked&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${seedTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:serviceTask id="shg_power_wait" name="二倍频宽带激光注入·上电检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;shg&quot;:&quot;power_on_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;shg&quot;:&quot;powerOnOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${shgTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:serviceTask id="preamp_power_wait" name="再生与双程放大·上电检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;power_on_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;powerOnOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:serviceTask id="multipass_power_wait" name="多程放大·上电检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;multipass&quot;:&quot;power_on_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;multipass&quot;:&quot;powerOnOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${multipassTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:serviceTask id="seed_function_wait" name="光纤种子源·功能检查" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;seed&quot;:&quot;function_check&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;qualified&quot;}" /><flowable:field name="componentCommand" stringValue="true" /><act:actionContract /><sys:requires state="powered" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${seedTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
