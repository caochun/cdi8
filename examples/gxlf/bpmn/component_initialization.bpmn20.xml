      <bpmn:boundaryEvent id="seed_power_timeout" attachedToRef="seed_power_wait" cancelActivity="true" name="检查超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="seed_power_timeout__raise_timeout" sourceRef="seed_power_timeout" targetRef="raise_timeout" />
      <bpmn:boundaryEvent id="shg_power_timeout" attachedToRef="shg_power_wait" cancelActivity="true" name="检查超时">
        <bpmn:timerEventDefinition>
