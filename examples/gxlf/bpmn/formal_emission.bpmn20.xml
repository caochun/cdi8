<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:lab="https://cdi8.cn/workbench" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="https://cdi8.cn/control/v2">
  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:process id="formal_emission" isExecutable="true" name="正式发射（四类组件验证范围）">
    <bpmn:documentation>本阶段从发射准备完成状态开始。当前验证版直接使用已有四类组件中的再生与双程放大组件执行第二次能量精闭环和能量计清零；诊断采集、晶体位姿、充电、测量单次配方、开关充电以及泵浦/开关/同步触发由演示同步与环境设备提供显式条件证据。正式触发严格按倒计时语义建模：倒计时开始后，T+3s 前泵浦和开关触发准备必须完成，T+5s 前同步触发结果必须完成。</bpmn:documentation>
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="正式发射">
      <bpmn:startEvent id="scope_start" name="发射准备已完成" />
      <bpmn:endEvent id="scope_end" name="正式发射完成" />
      <bpmn:endEvent id="raise_timeout" name="动作超时"><bpmn:errorEventDefinition errorRef="device_error" /></bpmn:endEvent>
      <bpmn:receiveTask id="wait_safety" lab:condition="safety_permit" lab:collection="contextTargets" lab:maintain="true" name="确认正式发射安全许可" />
      <bpmn:parallelGateway id="precharge_split" name="发射充电前置并行" />
      <bpmn:parallelGateway id="precharge_join" name="充电前置全部完成" />
      <bpmn:receiveTask id="wait_diagnosis" lab:condition="diagnosis_acquisition_ready" lab:collection="contextTargets" name="诊断设备采集设置完成" />
      <bpmn:receiveTask id="wait_crystal" lab:condition="crystal_pose_ready" lab:collection="contextTargets" name="晶体位姿设置完成" />
      <bpmn:receiveTask id="wait_charge_prepare" lab:condition="charge_preparation_ready" lab:collection="contextTargets" name="发射充电准备完成" />
      <bpmn:receiveTask id="wait_preamp_single" lab:condition="preamp_single_recipe_ready" lab:collection="contextTargets" name="预放单次配方完成" />
      <bpmn:receiveTask id="wait_measure_single" lab:condition="measurement_single_recipe_ready" lab:collection="contextTargets" name="测量单次配方完成" />
      <bpmn:receiveTask id="wait_target_measure" lab:condition="target_measurement_ready" lab:collection="contextTargets" name="打靶测量准备完成" />
      <bpmn:receiveTask id="wait_switch_charge" lab:condition="switch_charge_ready" lab:collection="contextTargets" name="开关充电完成" />
      <bpmn:serviceTask id="second_fine_wait" name="第二次能量精闭环" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;fine_loop&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;fineLoopOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:serviceTask id="clear_meter_wait" name="能量计清零" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;energy_meter_clear&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;energyMeterCleared&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:boundaryEvent id="second_fine_timeout" attachedToRef="second_fine_wait" cancelActivity="true" name="动作超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="clear_meter_timeout" attachedToRef="clear_meter_wait" cancelActivity="true" name="动作超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:receiveTask id="wait_charge_complete" lab:condition="charge_complete" lab:collection="contextTargets" name="发射充电完成" />
      <bpmn:receiveTask id="wait_music_stop" lab:condition="warning_music_stopped" lab:collection="contextTargets" name="警示音乐停止" />
      <bpmn:receiveTask id="wait_countdown" lab:condition="trigger_countdown_started" lab:collection="contextTargets" name="同步触发倒计时开始" />
      <bpmn:parallelGateway id="trigger_split" name="T+3 秒触发准备并行" />
      <bpmn:parallelGateway id="trigger_join" name="触发准备完成" />
      <bpmn:receiveTask id="wait_pump_trigger" lab:condition="pump_trigger_ready" lab:collection="contextTargets" name="泵浦触发准备完成（T+3s）" />
      <bpmn:receiveTask id="wait_switch_trigger" lab:condition="switch_trigger_ready" lab:collection="contextTargets" name="开关触发准备完成（T+3s）" />
      <bpmn:receiveTask id="wait_sync_trigger" lab:condition="synchronized_triggered" lab:collection="contextTargets" name="同步正式触发完成（T+5s）" />
      <bpmn:boundaryEvent id="pump_trigger_deadline" attachedToRef="wait_pump_trigger" cancelActivity="true" name="泵浦触发准备超时"><bpmn:timerEventDefinition><bpmn:timeDuration>PT3S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="switch_trigger_deadline" attachedToRef="wait_switch_trigger" cancelActivity="true" name="开关触发准备超时"><bpmn:timerEventDefinition><bpmn:timeDuration>PT3S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="sync_trigger_deadline" attachedToRef="wait_sync_trigger" cancelActivity="true" name="同步正式触发超时"><bpmn:timerEventDefinition><bpmn:timeDuration>PT5S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:serviceTask id="finish" name="确认正式发射完成" flowable:expression="${tango.formalEmissionFinish(execution)}" />
      <bpmn:sequenceFlow id="scope_start__wait_safety" sourceRef="scope_start" targetRef="wait_safety" />
      <bpmn:sequenceFlow id="wait_safety__precharge_split" sourceRef="wait_safety" targetRef="precharge_split" />
      <bpmn:sequenceFlow id="precharge_split__diagnosis" sourceRef="precharge_split" targetRef="wait_diagnosis" />
      <bpmn:sequenceFlow id="precharge_split__crystal" sourceRef="precharge_split" targetRef="wait_crystal" />
      <bpmn:sequenceFlow id="precharge_split__charge_prepare" sourceRef="precharge_split" targetRef="wait_charge_prepare" />
      <bpmn:sequenceFlow id="precharge_split__second_fine" sourceRef="precharge_split" targetRef="second_fine_wait" />
      <bpmn:sequenceFlow id="second_fine__preamp_single" sourceRef="second_fine_wait" targetRef="wait_preamp_single" />
      <bpmn:sequenceFlow id="wait_preamp_single__clear_meter" sourceRef="wait_preamp_single" targetRef="clear_meter_wait" />
      <bpmn:sequenceFlow id="clear_meter__precharge_join" sourceRef="clear_meter_wait" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="precharge_split__measure_single" sourceRef="precharge_split" targetRef="wait_measure_single" />
      <bpmn:sequenceFlow id="wait_measure_single__target_measure" sourceRef="wait_measure_single" targetRef="wait_target_measure" />
      <bpmn:sequenceFlow id="wait_target_measure__precharge_join" sourceRef="wait_target_measure" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="wait_diagnosis__precharge_join" sourceRef="wait_diagnosis" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="wait_crystal__precharge_join" sourceRef="wait_crystal" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="wait_charge_prepare__precharge_join" sourceRef="wait_charge_prepare" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="precharge_split__switch_charge" sourceRef="precharge_split" targetRef="wait_switch_charge" />
      <bpmn:sequenceFlow id="wait_switch_charge__precharge_join" sourceRef="wait_switch_charge" targetRef="precharge_join" />
      <bpmn:sequenceFlow id="precharge_join__charge_complete" sourceRef="precharge_join" targetRef="wait_charge_complete" />
      <bpmn:sequenceFlow id="wait_charge_complete__music_stop" sourceRef="wait_charge_complete" targetRef="wait_music_stop" />
      <bpmn:sequenceFlow id="wait_music_stop__countdown" sourceRef="wait_music_stop" targetRef="wait_countdown" />
      <bpmn:sequenceFlow id="wait_countdown__trigger_split" sourceRef="wait_countdown" targetRef="trigger_split" />
      <bpmn:sequenceFlow id="trigger_split__pump" sourceRef="trigger_split" targetRef="wait_pump_trigger" />
      <bpmn:sequenceFlow id="trigger_split__switch" sourceRef="trigger_split" targetRef="wait_switch_trigger" />
      <bpmn:sequenceFlow id="trigger_split__sync" sourceRef="trigger_split" targetRef="wait_sync_trigger" />
      <bpmn:sequenceFlow id="wait_pump_trigger__trigger_join" sourceRef="wait_pump_trigger" targetRef="trigger_join" />
      <bpmn:sequenceFlow id="wait_switch_trigger__trigger_join" sourceRef="wait_switch_trigger" targetRef="trigger_join" />
      <bpmn:sequenceFlow id="wait_sync_trigger__trigger_join" sourceRef="wait_sync_trigger" targetRef="trigger_join" />
      <bpmn:sequenceFlow id="trigger_join__finish" sourceRef="trigger_join" targetRef="finish" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
      <bpmn:sequenceFlow id="second_fine_timeout__raise_timeout" sourceRef="second_fine_timeout" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="clear_meter_timeout__raise_timeout" sourceRef="clear_meter_timeout" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="pump_trigger_deadline__raise_timeout" sourceRef="pump_trigger_deadline" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="switch_trigger_deadline__raise_timeout" sourceRef="switch_trigger_deadline" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="sync_trigger_deadline__raise_timeout" sourceRef="sync_trigger_deadline" targetRef="raise_timeout" />
    </bpmn:subProcess>
    <bpmn:endEvent id="success" name="流程成功" />
    <bpmn:endEvent id="success_end" name="流程完成" />
    <bpmn:serviceTask id="failure" name="记录流程失败" flowable:expression="${tango.failed(execution)}" />
    <bpmn:endEvent id="failed_end" name="流程停止"><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="normal" cancelActivity="true" name="设备或动作失败"><bpmn:errorEventDefinition errorRef="device_error" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="stop_boundary" attachedToRef="normal" cancelActivity="true" name="停止流程"><bpmn:messageEventDefinition messageRef="stop_message" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="workflow_timeout" attachedToRef="normal" cancelActivity="true" name="流程超时"><bpmn:timerEventDefinition><bpmn:timeDuration>${workflowTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="start__normal" sourceRef="start" targetRef="normal" />
    <bpmn:sequenceFlow id="normal__success" sourceRef="normal" targetRef="success" />
    <bpmn:sequenceFlow id="success__end" sourceRef="success" targetRef="success_end" />
    <bpmn:sequenceFlow id="error_boundary__failure" sourceRef="error_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="stop_boundary__failure" sourceRef="stop_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="workflow_timeout__failure" sourceRef="workflow_timeout" targetRef="failure" />
    <bpmn:sequenceFlow id="failure__failed_end" sourceRef="failure" targetRef="failed_end" />
  </bpmn:process>
