<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="https://cdi8.cn/control/v2">
  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:process id="parameter_dispatch" isExecutable="true" name="参数下发（四类组件验证范围）">
    <bpmn:documentation>参数下发是发射主流程的起点。本验证版只向已有 SCXML 模型的四类组件实例下发参数；各实例完成参数初始化并达到可进入发射准备的状态后，流程才完成。组件初始化是本流程的前置条件。</bpmn:documentation>
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="参数下发">
      <bpmn:startEvent id="scope_start" name="开始" />
      <bpmn:endEvent id="scope_end" name="参数下发完成" />
      <bpmn:endEvent id="raise_timeout" name="动作超时">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="dispatch_wait" name="向四类组件实例下发参数" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;seed&quot;:&quot;parameter_dispatch&quot;,&quot;shg&quot;:&quot;parameter_dispatch&quot;,&quot;preamp&quot;:&quot;parameter_dispatch&quot;,&quot;multipass&quot;:&quot;parameter_dispatch&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;seed&quot;:&quot;configured&quot;,&quot;shg&quot;:&quot;parameterOk&quot;,&quot;preamp&quot;:&quot;parameterOk&quot;,&quot;multipass&quot;:&quot;parameterOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${allComponents}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:boundaryEvent id="dispatch_timeout" attachedToRef="dispatch_wait" cancelActivity="true" name="动作超时">
        <bpmn:timerEventDefinition><bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="finish" name="确认参数下发完成" flowable:expression="${tango.parameterDispatchFinish(execution)}" />
      <bpmn:sequenceFlow id="scope_start__dispatch" sourceRef="scope_start" targetRef="dispatch_wait" />
      <bpmn:sequenceFlow id="dispatch__finish" sourceRef="dispatch_wait" targetRef="finish" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
      <bpmn:sequenceFlow id="dispatch_timeout__raise_timeout" sourceRef="dispatch_timeout" targetRef="raise_timeout" />
    </bpmn:subProcess>
    <bpmn:endEvent id="success" name="流程成功" />
    <bpmn:serviceTask id="failure" name="记录流程失败" flowable:expression="${tango.failed(execution)}" />
    <bpmn:endEvent id="failed_end" name="流程停止"><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="normal" cancelActivity="true" name="设备或动作失败">
      <bpmn:errorEventDefinition errorRef="device_error" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="stop_boundary" attachedToRef="normal" cancelActivity="true" name="停止流程">
      <bpmn:messageEventDefinition messageRef="stop_message" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="workflow_timeout" attachedToRef="normal" cancelActivity="true" name="流程超时">
      <bpmn:timerEventDefinition><bpmn:timeDuration>${workflowTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="error_boundary__failure" sourceRef="error_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="stop_boundary__failure" sourceRef="stop_boundary" targetRef="failure" />
    <bpmn:sequenceFlow id="workflow_timeout__failure" sourceRef="workflow_timeout" targetRef="failure" />
    <bpmn:sequenceFlow id="start__normal" sourceRef="start" targetRef="normal" />
    <bpmn:sequenceFlow id="normal__success" sourceRef="normal" targetRef="success" />
    <bpmn:sequenceFlow id="failure__failed_end" sourceRef="failure" targetRef="failed_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_parameter_dispatch">
    <bpmndi:BPMNPlane id="plane_parameter_dispatch" bpmnElement="parameter_dispatch">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start"><ns3:Bounds x="50" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_normal" bpmnElement="normal" isExpanded="false"><ns3:Bounds x="160" y="70" width="220" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_success" bpmnElement="success"><ns3:Bounds x="450" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_failure" bpmnElement="failure"><ns3:Bounds x="430" y="300" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_failed_end" bpmnElement="failed_end"><ns3:Bounds x="650" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_error_boundary" bpmnElement="error_boundary"><ns3:Bounds x="245" y="152" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_stop_boundary" bpmnElement="stop_boundary"><ns3:Bounds x="285" y="152" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_workflow_timeout" bpmnElement="workflow_timeout"><ns3:Bounds x="325" y="152" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_start__normal" bpmnElement="start__normal"><ns4:waypoint x="86" y="118" /><ns4:waypoint x="160" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_normal__success" bpmnElement="normal__success"><ns4:waypoint x="380" y="118" /><ns4:waypoint x="450" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_error_boundary__failure" bpmnElement="error_boundary__failure"><ns4:waypoint x="260" y="182" /><ns4:waypoint x="260" y="260" /><ns4:waypoint x="505" y="260" /><ns4:waypoint x="505" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_stop_boundary__failure" bpmnElement="stop_boundary__failure"><ns4:waypoint x="300" y="182" /><ns4:waypoint x="300" y="260" /><ns4:waypoint x="505" y="260" /><ns4:waypoint x="505" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_workflow_timeout__failure" bpmnElement="workflow_timeout__failure"><ns4:waypoint x="340" y="182" /><ns4:waypoint x="340" y="260" /><ns4:waypoint x="505" y="260" /><ns4:waypoint x="505" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_failure__failed_end" bpmnElement="failure__failed_end"><ns4:waypoint x="580" y="340" /><ns4:waypoint x="650" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="diagram_normal">
    <bpmndi:BPMNPlane id="plane_normal" bpmnElement="normal">
      <bpmndi:BPMNShape id="shape_scope_start" bpmnElement="scope_start"><ns3:Bounds x="70" y="230" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_scope_end" bpmnElement="scope_end"><ns3:Bounds x="900" y="230" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_raise_timeout" bpmnElement="raise_timeout"><ns3:Bounds x="570" y="430" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_dispatch" bpmnElement="dispatch_wait"><ns3:Bounds x="230" y="210" width="220" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_dispatch_timeout" bpmnElement="dispatch_timeout"><ns3:Bounds x="390" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_finish" bpmnElement="finish"><ns3:Bounds x="570" y="210" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_scope_start__dispatch" bpmnElement="scope_start__dispatch"><ns4:waypoint x="106" y="248" /><ns4:waypoint x="230" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_dispatch__finish" bpmnElement="dispatch__finish"><ns4:waypoint x="450" y="250" /><ns4:waypoint x="570" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_finish__scope_end" bpmnElement="finish__scope_end"><ns4:waypoint x="750" y="250" /><ns4:waypoint x="900" y="248" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_dispatch_timeout__raise_timeout" bpmnElement="dispatch_timeout__raise_timeout"><ns4:waypoint x="408" y="308" /><ns4:waypoint x="408" y="448" /><ns4:waypoint x="570" y="448" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn:definitions>