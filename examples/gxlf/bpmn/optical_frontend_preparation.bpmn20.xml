      <bpmn:parallelGateway id="join_light" name="供光与唤醒均完成" />
      <bpmn:parallelGateway id="split_loop" name="并行闭环与准直" />
      <bpmn:parallelGateway id="join_loop" name="闭环与准直均完成" />
