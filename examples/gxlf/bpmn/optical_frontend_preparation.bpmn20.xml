        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="wake_timeout__raise_timeout" sourceRef="wake_timeout" targetRef="raise_timeout" />
      <bpmn:serviceTask id="wake_guard" flowable:expression="${tango.mark(execution,'wakeupRequired')}" name="保持预放唤醒" />
      <bpmn:serviceTask id="coarse_wait" name="预放能量粗闭环" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;coarse_loop&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;coarseLoopOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:boundaryEvent id="coarse_timeout" attachedToRef="coarse_wait" cancelActivity="true" name="动作超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="coarse_timeout__raise_timeout" sourceRef="coarse_timeout" targetRef="raise_timeout" />
      <bpmn:serviceTask id="fine_wait" name="第一次能量精闭环" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;fine_loop&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;fineLoopOk&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:boundaryEvent id="fine_timeout" attachedToRef="fine_wait" cancelActivity="true" name="动作超时">
