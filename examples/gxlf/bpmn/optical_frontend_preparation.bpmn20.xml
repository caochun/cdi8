      <bpmn:sequenceFlow id="wake_guard__join_light" sourceRef="wake_guard" targetRef="join_light" />
      <bpmn:sequenceFlow id="join_light__split_loop" sourceRef="join_light" targetRef="split_loop" />
      <bpmn:sequenceFlow id="split_loop__coarse" sourceRef="split_loop" targetRef="coarse_wait" />
      <bpmn:sequenceFlow id="coarse__fine" sourceRef="coarse_wait" targetRef="fine_wait" />
      <bpmn:sequenceFlow id="fine__join_loop" sourceRef="fine_wait" targetRef="join_loop" />
      <bpmn:sequenceFlow id="split_loop__wait_environment" sourceRef="split_loop" targetRef="wait_environment" />
      <bpmn:sequenceFlow id="wait_environment__collimate" sourceRef="wait_environment" targetRef="collimate_wait" />
      <bpmn:sequenceFlow id="collimate__join_loop" sourceRef="collimate_wait" targetRef="join_loop" />
      <bpmn:sequenceFlow id="join_loop__finish" sourceRef="join_loop" targetRef="finish" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
    </bpmn:subProcess>
