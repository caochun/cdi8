      <bpmn:boundaryEvent id="emit_timeout" attachedToRef="emit_wait" cancelActivity="true" name="动作超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="emit_timeout__raise_timeout" sourceRef="emit_timeout" targetRef="raise_timeout" />
      <bpmn:serviceTask id="source_guard" flowable:expression="${tango.mark(execution,'sourcesRequired')}" name="保持供光资格" />
      <bpmn:serviceTask id="repeat_wait" name="同步预放重频模式" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;context&quot;:&quot;preamp_repeat&quot;}" /><flowable:field name="expectedState" stringValue="{}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${contextTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
      <bpmn:boundaryEvent id="repeat_timeout" attachedToRef="repeat_wait" cancelActivity="true" name="动作超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${commandTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="repeat_timeout__raise_timeout" sourceRef="repeat_timeout" targetRef="raise_timeout" />
      <bpmn:serviceTask id="repeat_guard" flowable:expression="${tango.mark(execution,'repeatRequired')}" name="保持同步资格" />
      <bpmn:serviceTask id="wake_wait" name="预放唤醒" flowable:delegateExpression="${componentCommand}"><bpmn:extensionElements><flowable:field name="action" stringValue="{&quot;preamp&quot;:&quot;preamp_wakeup&quot;}" /><flowable:field name="expectedState" stringValue="{&quot;preamp&quot;:&quot;wakeupReady&quot;}" /><flowable:field name="componentCommand" stringValue="true" /></bpmn:extensionElements><bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${preampTargets}" flowable:elementVariable="target" /></bpmn:serviceTask>
