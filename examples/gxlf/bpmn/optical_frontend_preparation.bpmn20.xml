      <bpmn:endEvent id="scope_end" name="发射准备全部完成" />
      <bpmn:endEvent id="raise_timeout" name="动作超时">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:receiveTask id="wait_safety" lab:condition="safety_permit" lab:collection="contextTargets" lab:maintain="true" name="等待安全许可" />
