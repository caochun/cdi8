<?xml version="1.0" encoding="UTF-8"?>
<!--
  二倍频宽带激光注入组件状态机模型。

  组件始终只有一个有效叶子状态。四个顶层复合状态分别表示未就绪、
  就绪、出光和异常；叶子状态表示当前可供流程判断的确定状态。

  unchecked 表示软件启动、上电检查失败或异常恢复后尚未取得新的状态证据。
  checkFailed 表示功能检查未通过，二者不混用。
  异常类别由 fault 下的叶子状态表示，context.faults 可保存完整故障集合。

  actions 和 confirmations 是可执行仿真契约：动作请求先建立任务，任务反馈
  再发送 success_events/failure_events；确认事件用于注入设备主动上报的事实。
  请求事件通常是 task-only event，不改变设备状态；collection.requested 是
  一个例外，用于在采集完成后重新进入采集中对应的稳定出光状态。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       initial="notReady">

  <state id="notReady" initial="unchecked">
    <state id="unchecked" />
    <state id="powerOnOk" />
    <state id="checkFailed" />
    <state id="shutdownNormal" />

    <transition event="power-check.passed"
                target="powerOnOk"
                type="internal" />
    <transition event="power-check.failed"
                target="unchecked"
                type="internal" />
    <transition event="qualification.confirmed" target="functionReady" />
    <transition event="qualification.failed"
                target="checkFailed"
                type="internal" />
    <transition event="shutdown.confirmed"
                target="shutdownNormal"
                type="internal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>

  <state id="ready" initial="functionReady">
    <state id="functionReady" />
    <state id="parameterOk">
      <transition event="emission.stable-confirmed" target="stableEmission" />
    </state>
    <state id="standbyReset" />

    <transition event="configuration.validated"
                target="parameterOk"
                type="internal" />
    <transition event="configuration.invalidated"
                target="functionReady"
                type="internal" />
    <transition event="standby.completed"
                target="standbyReset"
                type="internal" />
    <transition event="abort.completed"
                target="standbyReset"
                type="internal" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>

  <state id="emitting" initial="stableEmission">
    <state id="stableEmission">
      <transition event="collection.completed" target="collectionOk" />
    </state>
    <state id="collectionOk">
      <transition event="collection.requested" target="stableEmission" />
    </state>

    <transition event="standby.completed" target="standbyReset" />
    <transition event="abort.completed" target="standbyReset" />
    <transition event="emission.lost-confirmed" target="parameterOk" />
    <transition event="configuration.invalidated" target="functionReady" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>

  <state id="fault" initial="faultLock">
    <state id="faultLock">
      <transition event="fault.confirmed" target="faultLock" />
      <transition event="communication.failure-confirmed" target="faultLock" />
      <transition event="execution.timeout-confirmed" target="faultLock" />
      <transition event="shutdown.confirmed" target="faultLock" />
    </state>
    <state id="commFault">
      <transition event="fault.confirmed" target="faultLock" />
      <transition event="communication.failure-confirmed" target="commFault" />
      <transition event="execution.timeout-confirmed" target="commFault" />
      <transition event="shutdown.confirmed" target="commFault" />
    </state>
    <state id="timeoutFault">
      <transition event="fault.confirmed" target="faultLock" />
      <transition event="communication.failure-confirmed" target="commFault" />
      <transition event="execution.timeout-confirmed" target="timeoutFault" />
      <transition event="shutdown.confirmed" target="timeoutFault" />
    </state>

    <transition event="recovery.completed" target="unchecked" />
  </state>

  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "model_id": "shg-injection-hierarchical-v2",
  "model_version": 2,
  "display_name": "二倍频宽带激光注入组件",
  "execution_model": "hierarchical-single-active-state",
  "configuration_valid_states": ["parameterOk", "stableEmission", "collectionOk"],
  "fault_codes": {
    "fault_confirmed": "locked",
    "communication_fault_confirmed": "communication",
    "timeout_confirmed": "timeout"
  },
  "outer_labels": {
    "notReady": "未就绪",
    "ready": "就绪",
    "emitting": "出光",
    "fault": "异常"
  },
  "inner_labels": {
    "unchecked": "未上电/离线",
    "powerOnOk": "上电检查通过，待功能检查",
    "checkFailed": "功能检查未通过",
    "shutdownNormal": "关机正常",
    "functionReady": "业务就绪完成（具备倍频注入/旁路判定能力）",
    "parameterOk": "参数配置正常",
    "standbyReset": "复位/待机完成",
    "stableEmission": "稳定出光正常",
    "collectionOk": "采集正常",
    "faultLock": "故障锁定",
    "commFault": "通信异常",
    "timeoutFault": "执行超时"
  },
  "context_defaults": {
    "fault_origin": null,
    "faults": [],
    "power_status": "unknown",
    "configuration": {
      "status": "unknown",
      "version": null
    },
    "data_qualification": "unknown"
  },
  "context_policy": {
    "fault_origin": "进入异常前的有效运行状态，由反馈适配层记录",
    "faults": "所有已确认故障原因的集合；当前显示类别由 fault 下的叶子状态决定",
    "power_status": "unknown、on 或 off；上电检查成功后为 on，关机确认后为 off",
    "configuration": "参数资格的上下文记录，不替代当前状态"
  },
  "actions": {
    "power_on_check": {
      "label": "上电检查",
      "requests": {
        "unchecked": "power-check.requested",
        "powerOnOk": "power-check.requested",
        "checkFailed": "power-check.requested",
        "shutdownNormal": "power-check.requested"
      },
      "success_events": {
        "unchecked": "power-check.passed",
        "powerOnOk": "power-check.passed",
        "checkFailed": "power-check.passed",
        "shutdownNormal": "power-check.passed"
      },
      "failure_events": {
        "unchecked": "power-check.failed",
        "powerOnOk": "power-check.failed",
        "checkFailed": "power-check.failed",
        "shutdownNormal": "power-check.failed"
      },
      "success_key": "上电检查通过",
      "failure_key": "上电检查未通过"
    },
    "function_check": {
      "label": "功能检查",
      "requests": {
        "powerOnOk": "function-check.requested",
        "checkFailed": "function-check.requested"
      },
      "success_events": {
        "powerOnOk": "qualification.confirmed",
        "checkFailed": "qualification.confirmed"
      },
      "failure_events": {
        "powerOnOk": "qualification.failed",
        "checkFailed": "qualification.failed"
      },
      "success_key": "功能检查通过",
      "failure_key": "功能检查未通过"
    },
    "parameter_dispatch": {
      "label": "参数下发",
      "requests": {
        "functionReady": "configuration.requested",
        "parameterOk": "configuration.requested",
        "standbyReset": "configuration.requested"
      },
      "success_events": {
        "functionReady": "configuration.validated",
        "parameterOk": "configuration.validated",
        "standbyReset": "configuration.validated"
      },
      "failure_events": {
        "functionReady": "configuration.invalidated",
        "parameterOk": "configuration.invalidated",
        "standbyReset": "configuration.invalidated"
      },
      "success_key": "参数配置生效",
      "failure_key": "参数配置未生效"
    },
    "frequency_doubled_emit": {
      "label": "二倍频出光",
      "requests": {"parameterOk": "emission.requested"},
      "success_events": {"parameterOk": "emission.stable-confirmed"},
      "failure_events": {"parameterOk": null},
      "success_key": "稳定出光正常",
      "failure_key": "出光未建立",
      "success_observation": "出光",
      "failure_observation": "就绪"
    },
    "laser_parameter_collect": {
      "label": "激光参数采集",
      "requests": {
        "stableEmission": "collection.requested",
        "collectionOk": "collection.requested"
      },
      "success_events": {
        "stableEmission": "collection.completed",
        "collectionOk": "collection.completed"
      },
      "failure_events": {"stableEmission": null, "collectionOk": null},
      "success_key": "采集正常",
      "failure_key": "采集失败"
    },
    "standby_reset": {
      "label": "二倍频待机/复位",
      "requests": {
        "functionReady": "standby.requested",
        "parameterOk": "standby.requested",
        "standbyReset": "standby.requested",
        "stableEmission": "standby.requested",
        "collectionOk": "standby.requested"
      },
      "success_events": {
        "functionReady": "standby.completed",
        "parameterOk": "standby.completed",
        "standbyReset": "standby.completed",
        "stableEmission": "standby.completed",
        "collectionOk": "standby.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "standbyReset": null,
        "stableEmission": null,
        "collectionOk": null
      },
      "success_key": "复位/待机完成",
      "failure_key": "复位/待机失败"
    },
    "abort_reset": {
      "label": "流程终止（异常中止）",
      "requests": {
        "functionReady": "abort.requested",
        "parameterOk": "abort.requested",
        "standbyReset": "abort.requested",
        "stableEmission": "abort.requested",
        "collectionOk": "abort.requested",
        "faultLock": "recovery.requested",
        "commFault": "recovery.requested",
        "timeoutFault": "recovery.requested"
      },
      "success_events": {
        "functionReady": "abort.completed",
        "parameterOk": "abort.completed",
        "standbyReset": "abort.completed",
        "stableEmission": "abort.completed",
        "collectionOk": "abort.completed",
        "faultLock": "recovery.completed",
        "commFault": "recovery.completed",
        "timeoutFault": "recovery.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "standbyReset": null,
        "stableEmission": null,
        "collectionOk": null,
        "faultLock": null,
        "commFault": null,
        "timeoutFault": null
      },
      "success_key": "安全复位完成",
      "failure_key": "安全复位失败"
    },
    "shutdown": {
      "label": "关机",
      "requests": {
        "unchecked": "shutdown.requested",
        "powerOnOk": "shutdown.requested",
        "checkFailed": "shutdown.requested",
        "shutdownNormal": "shutdown.requested",
        "functionReady": "shutdown.requested",
        "parameterOk": "shutdown.requested",
        "standbyReset": "shutdown.requested",
        "stableEmission": "shutdown.requested",
        "collectionOk": "shutdown.requested",
        "faultLock": "shutdown.requested",
        "commFault": "shutdown.requested",
        "timeoutFault": "shutdown.requested"
      },
      "success_events": {
        "unchecked": "shutdown.confirmed",
        "powerOnOk": "shutdown.confirmed",
        "checkFailed": "shutdown.confirmed",
        "shutdownNormal": "shutdown.confirmed",
        "functionReady": "shutdown.confirmed",
        "parameterOk": "shutdown.confirmed",
        "standbyReset": "shutdown.confirmed",
        "stableEmission": "shutdown.confirmed",
        "collectionOk": "shutdown.confirmed",
        "faultLock": "shutdown.confirmed",
        "commFault": "shutdown.confirmed",
        "timeoutFault": "shutdown.confirmed"
      },
      "failure_events": {
        "unchecked": null,
        "powerOnOk": null,
        "checkFailed": null,
        "shutdownNormal": null,
        "functionReady": null,
        "parameterOk": null,
        "standbyReset": null,
        "stableEmission": null,
        "collectionOk": null,
        "faultLock": null,
        "commFault": null,
        "timeoutFault": null
      },
      "success_key": "关机正常",
      "failure_key": "关机失败"
    }
  },
  "confirmations": {
    "qualification_confirmed": {
      "label": "业务资格确认",
      "source_outer": ["notReady"],
      "machine_event": "qualification.confirmed",
      "observation": "就绪"
    },
    "qualification_invalidated": {
      "label": "业务资格失效确认",
      "source_outer": ["ready", "emitting"],
      "machine_event": "qualification.invalidated",
      "observation": "未就绪"
    },
    "configuration_invalidated": {
      "label": "参数配置失效确认",
      "source_outer": ["ready", "emitting"],
      "machine_event": "configuration.invalidated",
      "observation": "就绪"
    },
    "emission_lost_confirmed": {
      "label": "稳定出光丢失确认",
      "source_outer": ["emitting"],
      "machine_event": "emission.lost-confirmed",
      "observation": "就绪"
    },
    "shutdown_confirmed": {
      "label": "安全下电完成",
      "source_outer": ["notReady", "ready", "emitting"],
      "machine_event": "shutdown.confirmed",
      "observation": "未就绪"
    },
    "shutdown_while_fault_confirmed": {
      "label": "异常状态下安全下电完成",
      "source_outer": ["fault"],
      "machine_event": "shutdown.confirmed",
      "observation": "异常"
    },
    "fault_confirmed": {
      "label": "设备故障确认",
      "source_outer": ["notReady", "ready", "emitting", "fault"],
      "machine_event": "fault.confirmed",
      "observation": "异常"
    },
    "communication_fault_confirmed": {
      "label": "通信异常确认",
      "source_outer": ["notReady", "ready", "emitting", "fault"],
      "machine_event": "communication.failure-confirmed",
      "observation": "异常"
    },
    "timeout_confirmed": {
      "label": "执行超时确认",
      "source_outer": ["notReady", "ready", "emitting", "fault"],
      "machine_event": "execution.timeout-confirmed",
      "observation": "异常"
    },
    "recovery_confirmed": {
      "label": "异常恢复并完成安全复位",
      "source_outer": ["fault"],
      "machine_event": "recovery.completed",
      "observation": "未就绪"
    }
  }
}
    ]]></data>
  </datamodel>
</scxml>
