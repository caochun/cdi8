<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:fac="https://cdi8.cn/facility/v1" targetNamespace="https://cdi8.cn/workbench">
  <bpmn:process id="demo_process" name="种子源上电检查" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:serviceTask id="open" name="创建本发记录" flowable:expression="${shotRuns.open(execution)}" />
    <bpmn:serviceTask id="check" name="种子源上电检查" flowable:delegateExpression="${facilityActions}">
      <bpmn:extensionElements><fac:actions><fac:action typeRef="seed" capabilityRef="power-on-check" collectionVar="seedTargets" expectedStateRef="powerOnChecked" /></fac:actions></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="complete" name="完成切片" flowable:expression="${shotRuns.complete(execution)}" />
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="open" />
    <bpmn:sequenceFlow id="f2" sourceRef="open" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="complete" />
    <bpmn:sequenceFlow id="f4" sourceRef="complete" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
