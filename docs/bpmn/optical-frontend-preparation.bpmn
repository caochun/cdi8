<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="OpticalFrontendDefinitions" targetNamespace="urn:gxlf:optical-frontend:design">
  <bpmn:error id="PreparationFailed" errorCode="PREPARATION_FAILED" name="准备动作失败、超时或资格无效" />
  <bpmn:error id="StopFailed" errorCode="STOP_FAILED" name="停止或安全核验失败" />
  <bpmn:message id="TaskResult" name="PreparationTaskResult" />
  <bpmn:message id="ExternalEvidence" name="PreparationExternalEvidence" />
  <bpmn:message id="Interlock" name="Interlock" />
  <bpmn:message id="QualificationLost" name="FrontendQualificationLost" />
  <bpmn:process id="optical_frontend_preparation" name="种子源至多程放大前期准备（设计定义）" isExecutable="false">
    <bpmn:documentation>依据 docs/process-control/种子源至多程放大前期准备流程.md。仅定义参数下发至第一次精闭环/光路准直；本段结束保持供光与唤醒，不代表全部发射准备完成。服务、消息关联、时限策略与停止策略待实现；不自动部署。所有外部条件必须提供本发次的有效证据。</bpmn:documentation>
    <bpmn:startEvent id="start" name="开始本段准备" />
    <bpmn:subProcess id="preparation_scope" name="参数、出光、预放闭环与多程准直">
      <bpmn:startEvent id="prepare_start" name="开始" />
      <bpmn:serviceTask id="validate_manifest" name="校验并冻结配方与束线拓扑">
        <bpmn:documentation>{
  "required": [
    "run_id",
    "shot_id",
    "recipe_version",
    "parameterTargets",
    "beamRoutes",
    "shgCapableBeamIds",
    "emissionTargets",
    "preampTargets",
    "multipassTargets",
    "syncTargets",
    "targetEnergy",
    "timeouts",
    "evidencePolicy"
  ],
  "rules": [
    "非空集合，按设备去重，路由覆盖参与束线，所有动作目标属于预约清单",
    "二倍频只能用于固定8条允许束线；物理映射必须来自配置",
    "超时及证据有效期无隐式默认值；缺失或冲突抛出 PREPARATION_FAILED"
  ]
}</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="reserve_and_preflight" name="预约设备并检查基础资格">
        <bpmn:documentation>检查全部服务、预约和活动任务；要求四类组件均为 ready/functionReady 或 ready/parameterOk。notReady/powerOnOk 尚需先完成功能检查。失败抛出 PREPARATION_FAILED。预约成功后持续监控至上层接管。</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="wait_safety_permit" name="等待本发次有效安全许可" messageRef="ExternalEvidence">
        <bpmn:documentation>由外部安全服务建立许可；仅由适配层在核验本发次、版本、目标及有效期后唤醒。早到证据先存储；失效/触发联锁中断整个准备作用域。</bpmn:documentation>
      </bpmn:receiveTask>
      <bpmn:parallelGateway id="source_wakeup_split" name="并行出光与唤醒" gatewayDirection="Diverging" />
      <bpmn:parallelGateway id="source_wakeup_join" name="出光与唤醒全部完成" gatewayDirection="Converging" />
      <bpmn:parallelGateway id="loop_collimation_split" name="并行闭环与准直" gatewayDirection="Diverging" />
      <bpmn:receiveTask id="wait_collimation_environment" name="等待门禁清场及吹扫停止确认" messageRef="ExternalEvidence">
        <bpmn:documentation>外部清场/门禁/人员/真空及吹扫事实确认；不在本段执行清场或关门。适配层核验后唤醒；准直发送前和段末仍需重读。风淋门策略须显式配置。</bpmn:documentation>
      </bpmn:receiveTask>
      <bpmn:parallelGateway id="loop_collimation_join" name="精闭环与准直全部完成" gatewayDirection="Converging" />
      <bpmn:serviceTask id="verify_frontend_ready" name="重读并核验本段全部持续资格">
        <bpmn:documentation>{
  "checks": [
    "所有所需光源本次命令成功、当前 outer_state=emitting、无活动任务及路由有效",
    "全部预放本次唤醒/粗闭环/第一次精闭环成功，当前 wakeup/fineLoopOk",
    "全部多程本次准直成功，当前 collimated/collimationReady",
    "本次参数成功证据、配方与清单一致，同步重频、服务、安全及准直环境仍有效",
    "未知、过期或不匹配抛出 PREPARATION_FAILED；不能只用历史成功或 AND token 放行"
  ],
  "output": "frontend_prepared及本次结果/预约/持续监测交接信息；不是全流程准备完成"
}</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="prepare_done" name="本段资格建立" />
      <bpmn:endEvent id="action_timeout_failure" name="传播节点超时失败">
        <bpmn:errorEventDefinition errorRef="PreparationFailed" />
      </bpmn:endEvent>
      <bpmn:subProcess id="configure_components" name="四类组件参数下发并校验生效">
        <bpmn:documentation>{
  "collection": "parameterTargets",
  "action_by_model": {
    "seed": "parameter_dispatch",
    "shg": "parameter_dispatch",
    "preamp": "parameter_dispatch",
    "multipass": "parameter_dispatch"
  },
  "postcondition_by_model": {
    "seed": {
      "outer_state": "ready",
      "state_id": "parameterOk"
    },
    "shg": {
      "outer_state": "ready",
      "state_id": "parameterOk"
    },
    "preamp": {
      "outer_state": "ready",
      "state_id": "parameterOk"
    },
    "multipass": {
      "outer_state": "ready",
      "state_id": "parameterOk"
    }
  },
  "guards": [
    "manifest_valid",
    "service_health",
    "reservation_valid",
    "base_qualification"
  ],
  "completion": "全部目标最终成功、关联正确、无活动命令；accepted不表示完成",
  "timeout": "parameter_dispatch",
  "configuration_status": "valid"
}</bpmn:documentation>
        <bpmn:startEvent id="configure_components_start" name="开始本节点" />
        <bpmn:serviceTask id="configure_components_preflight" name="整组预检：设备与跨系统守卫">
          <bpmn:documentation>任一不满足抛出 PREPARATION_FAILED；整组预检不承诺分发期间设备状态不变。</bpmn:documentation>
        </bpmn:serviceTask>
        <bpmn:subProcess id="configure_components_instances" name="并行多实例：全部目标成功">
          <bpmn:documentation>目标集合按物理设备去重且非空，不设提前完成条件。每台校验失败即抛出 PREPARATION_FAILED，中断整个准备作用域。</bpmn:documentation>
          <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${parameterTargets}" flowable:elementVariable="target" />
          <bpmn:startEvent id="configure_components_instance_start" name="开始本实例" />
          <bpmn:serviceTask id="configure_components_recheck" name="发送前重读本地及跨系统条件">
            <bpmn:documentation>对当前target重读守卫并验证设备占用、配方/路由及本次关联。不是仅检查本地状态机。失效抛出 PREPARATION_FAILED。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:serviceTask id="configure_components_enqueue" name="事务入队，登记命令与等待关联">
            <bpmn:documentation>沿用旧outbox模式；提交后worker发送Tango Command，同一命令重试不改编号。同步外部接口由专用适配器处理，不能假定当前ComponentDevice已实现同步模型。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:receiveTask id="configure_components_wait" name="等待本实例最终结果" messageRef="TaskResult">
            <bpmn:documentation>accepted/executing不推进。早到结果先存储，再关联唤醒；设备、命令、动作、节点、发次和配方必须匹配。</bpmn:documentation>
          </bpmn:receiveTask>
          <bpmn:serviceTask id="configure_components_verify" name="核验关联、最终结果与后状态">
            <bpmn:documentation>最终status须为succeeded，设备无活动任务，后状态与本节点文档匹配。失败、interrupted、拒绝、不匹配或证据无效抛出 PREPARATION_FAILED。同步节点还须验证模式已生效。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:endEvent id="configure_components_instance_done" name="本实例成功" />
          <bpmn:sequenceFlow id="configure_components_instance_start_to_configure_components_recheck" sourceRef="configure_components_instance_start" targetRef="configure_components_recheck" />
          <bpmn:sequenceFlow id="configure_components_recheck_to_configure_components_enqueue" sourceRef="configure_components_recheck" targetRef="configure_components_enqueue" />
          <bpmn:sequenceFlow id="configure_components_enqueue_to_configure_components_wait" sourceRef="configure_components_enqueue" targetRef="configure_components_wait" />
          <bpmn:sequenceFlow id="configure_components_wait_to_configure_components_verify" sourceRef="configure_components_wait" targetRef="configure_components_verify" />
          <bpmn:sequenceFlow id="configure_components_verify_to_configure_components_instance_done" sourceRef="configure_components_verify" targetRef="configure_components_instance_done" />
        </bpmn:subProcess>
        <bpmn:endEvent id="configure_components_done" name="全部目标成功" />
        <bpmn:sequenceFlow id="configure_components_start_to_configure_components_preflight" sourceRef="configure_components_start" targetRef="configure_components_preflight" />
        <bpmn:sequenceFlow id="configure_components_preflight_to_configure_components_instances" sourceRef="configure_components_preflight" targetRef="configure_components_instances" />
        <bpmn:sequenceFlow id="configure_components_instances_to_configure_components_done" sourceRef="configure_components_instances" targetRef="configure_components_done" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="configure_components_timeout" name="整组/等待超时" attachedToRef="configure_components" cancelActivity="true">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timeouts.parameter_dispatch}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="configure_components_timeout_to_action_timeout_failure" sourceRef="configure_components_timeout" targetRef="action_timeout_failure" />
      <bpmn:subProcess id="emit_sources" name="按路由稳定出光（所需光源）">
        <bpmn:documentation>{
  "collection": "emissionTargets",
  "action_by_model": {
    "seed": "seed_source_emit",
    "shg": "frequency_doubled_emit"
  },
  "postcondition_by_model": {
    "seed": {
      "outer_state": "emitting",
      "state_id": "collectIdle"
    },
    "shg": {
      "outer_state": "emitting",
      "state_id": "stableEmission"
    }
  },
  "guards": [
    "current_configuration",
    "service_health",
    "safety_permit",
    "routing_valid"
  ],
  "completion": "全部目标最终成功、关联正确、无活动命令；accepted不表示完成",
  "timeout": "emit_sources"
}</bpmn:documentation>
        <bpmn:startEvent id="emit_sources_start" name="开始本节点" />
        <bpmn:serviceTask id="emit_sources_preflight" name="整组预检：设备与跨系统守卫">
          <bpmn:documentation>任一不满足抛出 PREPARATION_FAILED；整组预检不承诺分发期间设备状态不变。</bpmn:documentation>
        </bpmn:serviceTask>
        <bpmn:subProcess id="emit_sources_instances" name="并行多实例：全部目标成功">
          <bpmn:documentation>目标集合按物理设备去重且非空，不设提前完成条件。每台校验失败即抛出 PREPARATION_FAILED，中断整个准备作用域。</bpmn:documentation>
          <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${emissionTargets}" flowable:elementVariable="target" />
          <bpmn:startEvent id="emit_sources_instance_start" name="开始本实例" />
          <bpmn:serviceTask id="emit_sources_recheck" name="发送前重读本地及跨系统条件">
            <bpmn:documentation>对当前target重读守卫并验证设备占用、配方/路由及本次关联。不是仅检查本地状态机。失效抛出 PREPARATION_FAILED。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:serviceTask id="emit_sources_enqueue" name="事务入队，登记命令与等待关联">
            <bpmn:documentation>沿用旧outbox模式；提交后worker发送Tango Command，同一命令重试不改编号。同步外部接口由专用适配器处理，不能假定当前ComponentDevice已实现同步模型。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:receiveTask id="emit_sources_wait" name="等待本实例最终结果" messageRef="TaskResult">
            <bpmn:documentation>accepted/executing不推进。早到结果先存储，再关联唤醒；设备、命令、动作、节点、发次和配方必须匹配。</bpmn:documentation>
          </bpmn:receiveTask>
          <bpmn:serviceTask id="emit_sources_verify" name="核验关联、最终结果与后状态">
            <bpmn:documentation>最终status须为succeeded，设备无活动任务，后状态与本节点文档匹配。失败、interrupted、拒绝、不匹配或证据无效抛出 PREPARATION_FAILED。同步节点还须验证模式已生效。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:endEvent id="emit_sources_instance_done" name="本实例成功" />
          <bpmn:sequenceFlow id="emit_sources_instance_start_to_emit_sources_recheck" sourceRef="emit_sources_instance_start" targetRef="emit_sources_recheck" />
          <bpmn:sequenceFlow id="emit_sources_recheck_to_emit_sources_enqueue" sourceRef="emit_sources_recheck" targetRef="emit_sources_enqueue" />
          <bpmn:sequenceFlow id="emit_sources_enqueue_to_emit_sources_wait" sourceRef="emit_sources_enqueue" targetRef="emit_sources_wait" />
          <bpmn:sequenceFlow id="emit_sources_wait_to_emit_sources_verify" sourceRef="emit_sources_wait" targetRef="emit_sources_verify" />
          <bpmn:sequenceFlow id="emit_sources_verify_to_emit_sources_instance_done" sourceRef="emit_sources_verify" targetRef="emit_sources_instance_done" />
        </bpmn:subProcess>
        <bpmn:endEvent id="emit_sources_done" name="全部目标成功" />
        <bpmn:sequenceFlow id="emit_sources_start_to_emit_sources_preflight" sourceRef="emit_sources_start" targetRef="emit_sources_preflight" />
        <bpmn:sequenceFlow id="emit_sources_preflight_to_emit_sources_instances" sourceRef="emit_sources_preflight" targetRef="emit_sources_instances" />
        <bpmn:sequenceFlow id="emit_sources_instances_to_emit_sources_done" sourceRef="emit_sources_instances" targetRef="emit_sources_done" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="emit_sources_timeout" name="整组/等待超时" attachedToRef="emit_sources" cancelActivity="true">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timeouts.emit_sources}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="emit_sources_timeout_to_action_timeout_failure" sourceRef="emit_sources_timeout" targetRef="action_timeout_failure" />
      <bpmn:subProcess id="sync_preamp_repeat" name="同步预放重频配方确认生效">
        <bpmn:documentation>{
  "collection": "syncTargets",
  "action_by_model": {},
  "postcondition_by_model": {},
  "guards": [
    "all_configuration_valid",
    "service_health",
    "safety_permit"
  ],
  "completion": "全部目标最终成功、关联正确、无活动命令；accepted不表示完成",
  "timeout": "sync_preamp_repeat",
  "external_action": "同步预放重频配方",
  "external_completion": "所有参与通道本发次预放重频模式已生效，非仅收到命令"
}</bpmn:documentation>
        <bpmn:startEvent id="sync_preamp_repeat_start" name="开始本节点" />
        <bpmn:serviceTask id="sync_preamp_repeat_preflight" name="整组预检：设备与跨系统守卫">
          <bpmn:documentation>任一不满足抛出 PREPARATION_FAILED；整组预检不承诺分发期间设备状态不变。</bpmn:documentation>
        </bpmn:serviceTask>
        <bpmn:subProcess id="sync_preamp_repeat_instances" name="并行多实例：全部目标成功">
          <bpmn:documentation>目标集合按物理设备去重且非空，不设提前完成条件。每台校验失败即抛出 PREPARATION_FAILED，中断整个准备作用域。</bpmn:documentation>
          <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${syncTargets}" flowable:elementVariable="target" />
          <bpmn:startEvent id="sync_preamp_repeat_instance_start" name="开始本实例" />
          <bpmn:serviceTask id="sync_preamp_repeat_recheck" name="发送前重读本地及跨系统条件">
            <bpmn:documentation>对当前target重读守卫并验证设备占用、配方/路由及本次关联。不是仅检查本地状态机。失效抛出 PREPARATION_FAILED。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:serviceTask id="sync_preamp_repeat_enqueue" name="事务入队，登记命令与等待关联">
            <bpmn:documentation>沿用旧outbox模式；提交后worker发送Tango Command，同一命令重试不改编号。同步外部接口由专用适配器处理，不能假定当前ComponentDevice已实现同步模型。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:receiveTask id="sync_preamp_repeat_wait" name="等待本实例最终结果" messageRef="TaskResult">
            <bpmn:documentation>accepted/executing不推进。早到结果先存储，再关联唤醒；设备、命令、动作、节点、发次和配方必须匹配。</bpmn:documentation>
          </bpmn:receiveTask>
          <bpmn:serviceTask id="sync_preamp_repeat_verify" name="核验关联、最终结果与后状态">
            <bpmn:documentation>最终status须为succeeded，设备无活动任务，后状态与本节点文档匹配。失败、interrupted、拒绝、不匹配或证据无效抛出 PREPARATION_FAILED。同步节点还须验证模式已生效。</bpmn:documentation>
          </bpmn:serviceTask>
          <bpmn:endEvent id="sync_preamp_repeat_instance_done" name="本实例成功" />
          <bpmn:sequenceFlow id="sync_preamp_repeat_instance_start_to_sync_preamp_repeat_recheck" sourceRef="sync_preamp_repeat_instance_start" targetRef="sync_preamp_repeat_recheck" />
          <bpmn:sequenceFlow id="sync_preamp_repeat_recheck_to_sync_preamp_repeat_enqueue" sourceRef="sync_preamp_repeat_recheck" targetRef="sync_preamp_repeat_enqueue" />
          <bpmn:sequenceFlow id="sync_preamp_repeat_enqueue_to_sync_preamp_repeat_wait" sourceRef="sync_preamp_repeat_enqueue" targetRef="sync_preamp_repeat_wait" />
          <bpmn:sequenceFlow id="sync_preamp_repeat_wait_to_sync_preamp_repeat_verify" sourceRef="sync_preamp_repeat_wait" targetRef="sync_preamp_repeat_verify" />
          <bpmn:sequenceFlow id="sync_preamp_repeat_verify_to_sync_preamp_repeat_instance_done" sourceRef="sync_preamp_repeat_verify" targetRef="sync_preamp_repeat_instance_done" />
        </bpmn:subProcess>
        <bpmn:endEvent id="sync_preamp_repeat_done" name="全部目标成功" />
        <bpmn:sequenceFlow id="sync_preamp_repeat_start_to_sync_preamp_repeat_preflight" sourceRef="sync_preamp_repeat_start" targetRef="sync_preamp_repeat_preflight" />
        <bpmn:sequenceFlow id="sync_preamp_repeat_preflight_to_sync_preamp_repeat_instances" sourceRef="sync_preamp_repeat_preflight" targetRef="sync_preamp_repeat_instances" />
        <bpmn:sequenceFlow id="sync_preamp_repeat_instances_to_sync_preamp_repeat_done" sourceRef="sync_preamp_repeat_instances" targetRef="sync_preamp_repeat_done" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="sync_preamp_repeat_timeout" name="整组/等待超时" attachedToRef="sync_preamp_repeat" cancelActivity="true">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timeouts.sync_preamp_repeat}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="sync_preamp_repeat_timeout_to_action_timeout_failure" sourceRef="sync_preamp_repeat_timeout" targetRef="action_timeout_failure" />
      <bpmn:subProcess id="wake_preamp" name="预放唤醒（全部实例）">
        <bpmn:documentation>{
  "collection": "preampTargets",
  "action_by_model": {
    "preamp": "preamp_wakeup"
  },
  "postcondition_by_model": {
    "preamp": {
      "outer_state": "wakeup",
      "state_id": "wakeupReady"
    }
  },
  "guards": [
    "current_configuration",
    "preamp_repeat_ready",
    "service_health",
    "safety_permit"
  ],
  "completion": "全部目标最终成功、关联正确、无活动命令；accepted不表示完成",
  "timeout": "wake_preamp"
}</bpmn:documentation>
        <bpmn:startEvent id="wake_preamp_start" name="开始本节点" />
        <bpmn:serviceTask id="wake_preamp_preflight" name="整组预检：设备与跨系统守卫">
          <bpmn:documentation>任一不满足抛出 PREPARATION_FAILED；整组预检不承诺分发期间设备状态不变。</bpmn:documentation>
        </bpmn:serviceTask>
        <bpmn:subProcess id="wake_preamp_instances" name="并行多实例：全部目标成功">
