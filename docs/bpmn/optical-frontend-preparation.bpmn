      <bpmn:sequenceFlow id="coarse_loop_to_first_fine_loop" sourceRef="coarse_loop" targetRef="first_fine_loop" />
      <bpmn:sequenceFlow id="first_fine_loop_to_loop_collimation_join" sourceRef="first_fine_loop" targetRef="loop_collimation_join" />
      <bpmn:sequenceFlow id="loop_collimation_split_to_wait_collimation_environment" sourceRef="loop_collimation_split" targetRef="wait_collimation_environment" />
      <bpmn:sequenceFlow id="wait_collimation_environment_to_collimate_multipass" sourceRef="wait_collimation_environment" targetRef="collimate_multipass" />
      <bpmn:sequenceFlow id="collimate_multipass_to_loop_collimation_join" sourceRef="collimate_multipass" targetRef="loop_collimation_join" />
      <bpmn:sequenceFlow id="loop_collimation_join_to_verify_frontend_ready" sourceRef="loop_collimation_join" targetRef="verify_frontend_ready" />
      <bpmn:sequenceFlow id="verify_frontend_ready_to_prepare_done" sourceRef="verify_frontend_ready" targetRef="prepare_done" />
    </bpmn:subProcess>
    <bpmn:endEvent id="frontend_prepared" name="本段准备完成，保持供光与唤醒">
      <bpmn:documentation>向上层交付本段结果、预约及持续监测；不关光、不待机、不释放给其他实验。上层接管失败应撤销资格并停止。</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="start_to_preparation_scope" sourceRef="start" targetRef="preparation_scope" />
    <bpmn:sequenceFlow id="preparation_scope_to_frontend_prepared" sourceRef="preparation_scope" targetRef="frontend_prepared" />
    <bpmn:exclusiveGateway id="failure_merge" name="统一失败入口" />
    <bpmn:serviceTask id="record_failure" name="锁存失败，撤销放行">
      <bpmn:documentation>持久化原因及本次命令清单；使所有过期反馈失去推进资格。不得将 BPMN 中断当作物理设备停止。</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="stop_and_confirm" name="请求实际停止并核验结果">
      <bpmn:startEvent id="stop_start" name="开始安全处置" />
      <bpmn:serviceTask id="request_physical_stop" name="按停止策略请求设备实际停止">
        <bpmn:documentation>待实现的停止协调器：先处理活动任务抢占/中断，再按物理依赖停止或复位。当前 ComponentDevice 无 Cancel，不能直接向活动任务设备发送 abort_reset，也不能用 ReportEvent 代替真实停止。拒绝或失败抛出 STOP_FAILED。</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="wait_stop_confirmation" name="等待各目标真实停止确认" messageRef="TaskResult">
        <bpmn:documentation>按运行及停止请求编号持久化关联。未确认前保持占用；重复或迟到正常任务反馈不能代替停止证据。</bpmn:documentation>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="verify_physical_stop" name="核验设备状态及停止证据">
        <bpmn:documentation>未知、失败、不匹配、证据失效均抛出 STOP_FAILED。物理安全判据和处置顺序由停止策略提供。</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="stop_confirmed" name="停止已确认，本段仍失败" />
      <bpmn:sequenceFlow id="stop_start_to_request_physical_stop" sourceRef="stop_start" targetRef="request_physical_stop" />
      <bpmn:sequenceFlow id="request_physical_stop_to_wait_stop_confirmation" sourceRef="request_physical_stop" targetRef="wait_stop_confirmation" />
      <bpmn:sequenceFlow id="wait_stop_confirmation_to_verify_physical_stop" sourceRef="wait_stop_confirmation" targetRef="verify_physical_stop" />
      <bpmn:sequenceFlow id="verify_physical_stop_to_stop_confirmed" sourceRef="verify_physical_stop" targetRef="stop_confirmed" />
    </bpmn:subProcess>
    <bpmn:endEvent id="preparation_failed" name="准备失败，保留处置证据" />
    <bpmn:userTask id="manual_recovery" name="人工处置并确认现场状态">
      <bpmn:documentation>保持设备占用和失败锁存；处置、核验和资源释放由独立策略确定。不得通过点击完成把本段改为成功，也不得自动重启。</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="failure_merge_to_record_failure" sourceRef="failure_merge" targetRef="record_failure" />
    <bpmn:sequenceFlow id="record_failure_to_stop_and_confirm" sourceRef="record_failure" targetRef="stop_and_confirm" />
    <bpmn:sequenceFlow id="stop_and_confirm_to_preparation_failed" sourceRef="stop_and_confirm" targetRef="preparation_failed" />
    <bpmn:sequenceFlow id="manual_recovery_to_preparation_failed" sourceRef="manual_recovery" targetRef="preparation_failed" />
    <bpmn:boundaryEvent id="preparation_error" name="动作或资格校验失败" attachedToRef="preparation_scope" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="PreparationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="preparation_error_to_failure_merge" sourceRef="preparation_error" targetRef="failure_merge" />
    <bpmn:boundaryEvent id="preparation_interlock" name="安全联锁中断" attachedToRef="preparation_scope" cancelActivity="true">
      <bpmn:messageEventDefinition messageRef="Interlock" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="preparation_interlock_to_failure_merge" sourceRef="preparation_interlock" targetRef="failure_merge" />
    <bpmn:boundaryEvent id="preparation_qualification_lost" name="持续资格失效" attachedToRef="preparation_scope" cancelActivity="true">
      <bpmn:messageEventDefinition messageRef="QualificationLost" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="preparation_qualification_lost_to_failure_merge" sourceRef="preparation_qualification_lost" targetRef="failure_merge" />
    <bpmn:boundaryEvent id="preparation_total_timeout" name="整组/等待超时" attachedToRef="preparation_scope" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timeouts.preparation_total}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="preparation_total_timeout_to_failure_merge" sourceRef="preparation_total_timeout" targetRef="failure_merge" />
    <bpmn:boundaryEvent id="stop_error" name="停止或核验失败" attachedToRef="stop_and_confirm" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="StopFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="stop_error_to_manual_recovery" sourceRef="stop_error" targetRef="manual_recovery" />
    <bpmn:boundaryEvent id="stop_timeout" name="整组/等待超时" attachedToRef="stop_and_confirm" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timeouts.stop_confirmation}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="stop_timeout_to_manual_recovery" sourceRef="stop_timeout" targetRef="manual_recovery" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_optical_frontend_preparation" name="种子源至多程放大前期准备（设计定义）">
