      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_sync_preamp_repeat_timeout_to_action_timeout_failure" bpmnElement="sync_preamp_repeat_timeout_to_action_timeout_failure">
        <di:waypoint x="1348.0" y="618" />
        <di:waypoint x="1348.0" y="704.0" />
