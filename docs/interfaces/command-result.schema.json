{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component command result",
  "type": "object",
  "required": ["command_id", "action", "status"],
  "properties": {
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "action": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "succeeded", "failed", "interrupted", "rejected", "cancelled"]},
    "parameters": {"type": "object"},
    "key_state": {"type": ["string", "null"]},
    "reason": {"type": "string"},
    "snapshot": {"type": "object"}
  },
  "additionalProperties": true
}
