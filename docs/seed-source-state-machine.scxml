<?xml version="1.0" encoding="UTF-8"?>
<!--
  种子源分系统层级状态机 v3。
  依据《集中管控系统与分系统状态梳理清单》及 2026-10-15 用户确认口径：
  上电检查只确认本系统所辖设备是否均已上电，不执行上电操作；
  功能检查测试设备功能是否正常。上电检查通过仍处于未就绪，
  功能检查通过才进入业务就绪；业务参数配置生效后才放行专有动作。
  四组件共同资格：notReady/unchecked → notReady/powerOnOk
  → ready/functionReady → ready/parameterOk。
  动作请求、执行进度、结果及超时保存在独立任务记录中。
  datamodel 保存动作绑定、标签、确认事件和上下文；Mermaid 仅用于展示。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="notReady">
  <state id="notReady" initial="unchecked">
    <state id="unchecked" />
    <state id="powerOnOk">
      <transition event="function-check.passed" target="functionReady" />
      <transition event="function-check.failed" target="checkFailed" />
    </state>
    <state id="checkFailed">
      <transition event="function-check.passed" target="functionReady" />
      <transition event="function-check.failed" target="checkFailed" />
    </state>
    <transition event="fault.confirmed" target="fault" />
    <transition event="communication.failure-confirmed" target="fault" />
    <transition event="execution.timeout-confirmed" target="fault" />
    <transition event="power-check.passed" target="powerOnOk" />
    <transition event="power-check.failed" target="unchecked" />
    <transition event="power-check.invalidated" target="unchecked" />
  </state>
  <state id="ready" initial="functionReady">
    <state id="functionReady">
      <transition event="configuration.validated" target="parameterOk" />
      <transition event="function-check.passed" target="functionReady" />
      <transition event="function-check.failed" target="checkFailed" />
    </state>
    <state id="parameterOk">
      <transition event="configuration.invalidated" target="functionReady" />
      <transition event="configuration.reconfiguration-accepted" target="functionReady" />
      <transition event="emission.stable-confirmed" target="emitting" />
    </state>
    <transition event="qualification.invalidated" target="notReady" />
    <transition event="shutdown.completed" target="notReady" />
    <transition event="abort.completed" target="notReady" />
    <transition event="fault.confirmed" target="fault" />
    <transition event="communication.failure-confirmed" target="fault" />
    <transition event="execution.timeout-confirmed" target="fault" />
  </state>
  <state id="emitting" initial="collectIdle">
    <state id="collectIdle">
      <transition event="collection.completed" target="collectOk" />
      <transition event="collection.failed" target="collectFailed" />
    </state>
    <state id="collectOk">
      <transition event="collection.request-accepted" target="collectIdle" />
    </state>
    <state id="collectFailed">
      <transition event="collection.retry-accepted" target="collectIdle" />
    </state>
    <transition event="emission.stopped-confirmed" target="ready" />
    <transition event="emission.stopped-unready" target="notReady" />
    <transition event="shutdown.completed" target="notReady" />
    <transition event="abort.completed" target="notReady" />
    <transition event="qualification.invalidated" target="fault" />
    <transition event="fault.confirmed" target="fault" />
    <transition event="communication.failure-confirmed" target="fault" />
    <transition event="execution.timeout-confirmed" target="fault" />
  </state>
  <state id="fault" initial="faultDetected">
    <state id="faultDetected">
      <transition event="fault.locked" target="faultLock" />
      <transition event="communication.failure-confirmed" target="commFault" />
      <transition event="execution.timeout-confirmed" target="timeoutFault" />
    </state>
    <state id="faultLock" />
    <state id="commFault" />
    <state id="timeoutFault" />
    <transition event="recovery.completed" target="notReady" />
    <transition event="fault.classification-updated" target="faultDetected" />
  </state>
  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "model_id": "seed-source-hierarchical-v3",
  "model_version": 3,
  "display_name": "种子源分系统",
  "outer_labels": {
    "notReady": "未就绪",
    "ready": "就绪",
    "emitting": "出光",
    "fault": "设备异常"
  },
  "inner_labels": {
    "unchecked": "待上电检查",
    "powerOnOk": "上电检查通过，待功能检查",
    "checkFailed": "功能检查未通过",
    "functionReady": "功能正常，业务就绪",
    "parameterOk": "参数配置生效",
    "collectIdle": "尚无本次采集结果",
    "collectOk": "采集完成",
    "collectFailed": "采集失败",
    "faultDetected": "异常待分类",
    "faultLock": "故障锁定",
    "commFault": "通信异常",
    "timeoutFault": "执行超时"
  },
  "context_defaults": {
    "configuration": {
      "status": "unknown",
      "version": null
    },
    "data_qualification": "unknown",
    "faults": []
  },
  "actions": {
    "power_on_check": {
      "label": "上电检查",
      "requests": {
        "unchecked": "power-check.requested",
        "powerOnOk": "power-check.requested",
        "checkFailed": "power-check.requested"
      },
      "success_events": {
        "unchecked": "power-check.passed",
        "powerOnOk": "power-check.passed",
        "checkFailed": "power-check.passed"
      },
      "failure_events": {
        "unchecked": "power-check.failed",
        "powerOnOk": "power-check.failed",
        "checkFailed": "power-check.failed"
      },
      "success_key": "上电检查通过",
      "failure_key": "上电检查未通过"
    },
    "function_check": {
      "label": "功能检查",
      "requests": {
        "powerOnOk": "function-check.requested",
        "checkFailed": "function-check.requested",
        "functionReady": "function-check.requested"
      },
      "success_events": {
        "powerOnOk": "function-check.passed",
        "checkFailed": "function-check.passed",
        "functionReady": "function-check.passed"
      },
      "failure_events": {
        "powerOnOk": "function-check.failed",
        "checkFailed": "function-check.failed",
        "functionReady": "function-check.failed"
      },
      "success_key": "功能检查通过",
      "failure_key": "功能检查未通过",
      "success_observation": "就绪"
    },
    "parameter_dispatch": {
      "label": "参数下发",
      "requests": {
        "functionReady": "parameter-dispatch.requested",
        "parameterOk": "configuration.reconfiguration-accepted"
      },
      "success_events": {
        "functionReady": "configuration.validated",
        "parameterOk": "configuration.validated"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null
      },
      "success_key": "参数配置正常",
      "failure_key": "参数下发失败",
      "success_observation": null,
      "failure_observation": null
    },
    "seed_source_emit": {
      "label": "种子源出光",
      "requests": {
        "parameterOk": "emission.requested"
      },
      "success_events": {
        "parameterOk": "emission.stable-confirmed"
      },
      "failure_events": {
        "parameterOk": null
      },
      "success_key": "稳定出光确认",
      "failure_key": "出光失败且仍就绪",
      "success_observation": "出光",
      "failure_observation": "就绪"
    },
    "laser_parameter_collect": {
      "label": "激光参数采集",
      "requests": {
        "collectIdle": "collection.requested",
        "collectOk": "collection.request-accepted",
        "collectFailed": "collection.retry-accepted"
      },
      "success_events": {
        "collectIdle": "collection.completed",
        "collectOk": "collection.completed",
        "collectFailed": "collection.completed"
      },
      "failure_events": {
        "collectIdle": "collection.failed",
        "collectOk": "collection.failed",
        "collectFailed": "collection.failed"
      },
      "success_key": "采集完成",
      "failure_key": "采集失败",
      "success_observation": null,
      "failure_observation": null
    },
    "shutdown": {
      "label": "关机",
      "requests": {
        "functionReady": "shutdown.requested",
        "parameterOk": "shutdown.requested",
        "collectIdle": "shutdown.requested",
        "collectOk": "shutdown.requested",
        "collectFailed": "shutdown.requested"
      },
      "success_events": {
        "functionReady": "shutdown.completed",
        "parameterOk": "shutdown.completed",
        "collectIdle": "shutdown.completed",
        "collectOk": "shutdown.completed",
        "collectFailed": "shutdown.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "collectIdle": null,
        "collectOk": null,
        "collectFailed": null
      },
      "success_key": "关机完成",
      "failure_key": "关机失败",
      "success_observation": null,
      "failure_observation": null
    }
  },
  "confirmations": {
    "standby_confirmed": {
      "label": "正常关光完成且就绪确认",
      "source_outer": [
        "emitting"
      ],
      "machine_event": "emission.stopped-confirmed",
      "observation": "就绪"
    },
    "shutdown_confirmed": {
      "label": "关机完成且未就绪确认",
      "source_outer": [
        "emitting",
        "ready"
      ],
      "machine_event": "shutdown.completed",
      "observation": "未就绪"
    },
    "abort_reset_confirmed": {
      "label": "中止复位完成且未就绪确认",
      "source_outer": [
        "emitting",
        "ready"
      ],
      "machine_event": "abort.completed",
      "observation": "未就绪"
    },
    "fault_confirmed": {
      "label": "设备故障确认",
      "source_outer": [
        "emitting",
        "notReady",
        "ready"
      ],
      "machine_event": "fault.confirmed",
      "observation": "设备异常"
    },
    "communication_fault_confirmed": {
      "label": "通信异常确认",
      "source_outer": [
        "emitting",
        "notReady",
        "ready"
      ],
      "machine_event": "communication.failure-confirmed",
      "observation": "设备异常"
    },
    "timeout_confirmed": {
      "label": "执行超时确认",
      "source_outer": [
        "emitting",
        "notReady",
        "ready"
      ],
      "machine_event": "execution.timeout-confirmed",
      "observation": "设备异常"
    },
    "recovery_confirmed": {
      "label": "恢复后未就绪确认",
      "source_outer": [
        "fault"
      ],
      "machine_event": "recovery.completed",
      "observation": "未就绪"
    }
  }
}
  ]]></data>
  </datamodel>
</scxml>
