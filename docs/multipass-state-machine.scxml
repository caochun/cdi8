    },
    "recovery_confirmed": {
      "label": "恢复后未就绪确认",
      "source_outer": [
        "fault"
      ],
      "machine_event": "recovery.completed",
      "observation": "未就绪"
    }
  }
}
  ]]></data>
  </datamodel>
</scxml>
