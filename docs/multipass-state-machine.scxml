        "powerOnOk": "abort.requested"
      },
      "success_events": {
        "functionReady": "abort.completed",
        "parameterOk": "abort.completed",
        "shotReady": "abort.completed",
        "resetReady": "abort.completed",
        "collimationReady": "abort.completed",
        "powerOnOk": "abort.completed"
      },
      "failure_events": {
        "functionReady": null,
        "parameterOk": null,
        "shotReady": null,
        "resetReady": null,
        "collimationReady": null,
        "powerOnOk": null
      },
      "success_key": "异常中止复位完成",
      "failure_key": "异常中止复位失败",
      "success_observation": null,
      "failure_observation": null
    }
  },
  "confirmations": {
    "fault_confirmed": {
      "label": "设备故障确认",
      "source_outer": [
        "notReady",
        "ready",
        "collimated"
      ],
      "machine_event": "fault.confirmed",
      "observation": "设备异常"
    },
    "communication_fault_confirmed": {
      "label": "通信异常确认",
      "source_outer": [
        "notReady",
        "ready",
        "collimated"
      ],
      "machine_event": "communication.failure-confirmed",
