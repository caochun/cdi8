        "powerOnOk": "power-check.passed",
        "checkFailed": "power-check.passed",
        "shutdownNormal": "power-check.passed"
      },
      "failure_events": {
        "unchecked": "power-check.failed",
        "powerOnOk": "power-check.failed",
        "checkFailed": "power-check.failed",
        "shutdownNormal": "power-check.failed"
      },
      "success_key": "上电检查通过",
      "failure_key": "上电检查未通过"
    },
    "function_check": {
      "label": "功能检查",
      "requests": {
        "powerOnOk": "function-check.requested",
        "checkFailed": "function-check.requested",
        "functionReady": "function-check.requested",
        "resetReady": "function-check.requested"
      },
      "success_events": {
        "powerOnOk": "function-check.passed",
        "checkFailed": "function-check.passed",
        "functionReady": "function-check.passed",
        "resetReady": "function-check.passed"
      },
      "failure_events": {
        "powerOnOk": "function-check.failed",
        "checkFailed": "function-check.failed",
        "functionReady": "function-check.failed",
        "resetReady": "function-check.failed"
      },
      "success_key": "功能检查通过",
      "failure_key": "功能检查未通过",
      "success_observation": "就绪"
    },
    "parameter_dispatch": {
      "label": "参数下发",
      "requests": {
        "functionReady": "parameter-dispatch.requested",
        "resetReady": "parameter-dispatch.requested",
        "parameterOk": "parameter-dispatch.requested"
      },
      "success_events": {
        "functionReady": "configuration.validated",
        "resetReady": "configuration.validated",
        "parameterOk": "configuration.validated"
      },
      "failure_events": {
        "functionReady": null,
        "resetReady": null,
        "parameterOk": "configuration.invalidated"
      },
      "success_key": "参数配置正常",
      "failure_key": "参数下发失败",
      "success_observation": null,
      "failure_observation": null
    },
    "optical_collimation": {
      "label": "光路准直",
      "requests": {
        "parameterOk": "multipass.collimation.requested"
      },
      "success_events": {
        "parameterOk": "multipass.collimation.completed"
      },
      "failure_events": {
        "parameterOk": null
      },
      "success_key": "光路准直达标",
      "failure_key": "光路准直失败",
      "success_observation": null,
      "failure_observation": null
    },
    "enter_shot_state": {
      "label": "进入打靶状态",
      "preconditions": [
        "光束引导完成",
        "流程层安全联锁正常"
      ],
      "requests": {
        "collimationReady": "multipass.enter-shot.requested"
      },
      "success_events": {
        "collimationReady": "multipass.enter-shot.completed"
      },
      "failure_events": {
        "collimationReady": null
      },
      "success_key": "进入打靶状态完成",
      "failure_key": "进入打靶状态失败",
      "success_observation": null,
      "failure_observation": null
    },
    "standby_reset": {
      "label": "多程待机/复位",
      "requests": {
        "collimationReady": "multipass.standby.requested",
        "shotReady": "multipass.standby.requested",
        "resetReady": "multipass.standby.requested"
      },
      "success_events": {
        "collimationReady": "multipass.standby.completed",
        "shotReady": "multipass.standby.completed",
        "resetReady": "multipass.standby.completed"
      },
      "failure_events": {
        "collimationReady": null,
        "shotReady": null,
        "resetReady": null
      },
      "success_key": "复位/待机完成",
      "failure_key": "复位/待机失败",
      "success_observation": null,
      "failure_observation": null
    },
    "shutdown": {
      "label": "关机",
      "requests": {
        "functionReady": "shutdown.requested",
        "parameterOk": "shutdown.requested",
        "shotReady": "shutdown.requested",
        "resetReady": "shutdown.requested",
        "collimationReady": "shutdown.requested",
        "powerOnOk": "shutdown.requested"
      },
      "success_events": {
        "functionReady": "shutdown.completed",
        "parameterOk": "shutdown.completed",
        "shotReady": "shutdown.completed",
        "resetReady": "shutdown.completed",
