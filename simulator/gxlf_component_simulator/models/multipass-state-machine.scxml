<?xml version="1.0" encoding="UTF-8"?>
<!--
  多程放大系统状态机模型。

  模型只有一个活动叶状态。顶层复合状态表示业务语义：未就绪、就绪、准直、异常；
  叶子状态表示控制系统可确认的关键状态。请求事件只建立任务，完成反馈或设备主动
  确认事件才改变设备状态；参数重配置请求会先撤销旧参数资格，再等待新的完成反馈。

  真空度、清场、门禁和安全联锁是流程层持续守卫条件，不作为本组件内部顺序状态。
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="notReady">
  <state id="notReady" initial="unchecked">
    <state id="unchecked" />
    <state id="powerOnOk" />
    <state id="checkFailed" />
    <state id="shutdownNormal" />
    <transition event="power-check.passed" target="powerOnOk" type="internal" />
    <transition event="power-check.failed" target="unchecked" type="internal" />
    <transition event="power-check.invalidated" target="unchecked" type="internal" />
    <transition event="qualification.confirmed" target="functionReady" />
    <transition event="qualification.failed" target="checkFailed" type="internal" />
    <transition event="shutdown.confirmed" target="shutdownNormal" type="internal" />
    <transition event="abort.completed" target="unchecked" type="internal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>
  <state id="ready" initial="functionReady">
    <state id="functionReady" />
    <state id="parameterOk">
      <transition event="configuration.reconfiguration-accepted" target="functionReady" type="internal" />
      <transition event="multipass.collimation.completed" target="collimationReady" />
      <transition event="multipass.collimation.failed" target="parameterOk" type="internal" />
    </state>
    <state id="resetReady" />
    <state id="shotReady" />
    <transition event="configuration.validated" target="parameterOk" type="internal" />
    <transition event="configuration.invalidated" target="functionReady" type="internal" />
    <transition event="multipass.standby.completed" target="resetReady" type="internal" />
    <transition event="abort.completed" target="resetReady" type="internal" />
    <transition event="multipass.shot-state.invalidated" target="parameterOk" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>
  <state id="collimated" initial="collimationReady">
    <state id="collimationReady">
      <transition event="multipass.enter-shot.completed" target="shotReady" />
      <transition event="multipass.enter-shot.failed" target="collimationReady" type="internal" />
      <transition event="multipass.collimation.invalidated" target="parameterOk" />
    </state>
    <transition event="multipass.standby.completed" target="resetReady" />
    <transition event="abort.completed" target="resetReady" />
    <transition event="multipass.shot-state.invalidated" target="parameterOk" />
    <transition event="configuration.invalidated" target="functionReady" />
    <transition event="qualification.invalidated" target="checkFailed" />
    <transition event="shutdown.confirmed" target="shutdownNormal" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
  </state>
  <state id="fault" initial="faultLock">
    <state id="faultLock" />
    <state id="commFault" />
    <state id="timeoutFault" />
    <transition event="fault.confirmed" target="faultLock" />
    <transition event="communication.failure-confirmed" target="commFault" />
    <transition event="execution.timeout-confirmed" target="timeoutFault" />
    <transition event="shutdown.confirmed" target="faultLock" />
    <transition event="recovery.completed" target="unchecked" />
  </state>
  <datamodel>
    <data id="componentMetadata"><![CDATA[
{
  "model_id": "multipass-hierarchical-v3",
  "model_version": 3,
  "execution_model": "hierarchical-single-active-state",
  "configuration_valid_states": ["parameterOk", "resetReady", "collimationReady", "shotReady"],
  "display_name": "多程放大系统",
  "outer_labels": {"notReady": "未就绪", "ready": "就绪", "collimated": "准直", "fault": "异常"},
  "inner_labels": {
    "unchecked": "未上电/离线", "powerOnOk": "上电检查通过，待功能检查", "checkFailed": "功能检查未通过", "shutdownNormal": "关机正常",
    "functionReady": "业务就绪完成（具备光路准直能力）", "parameterOk": "参数配置生效", "resetReady": "复位/待机完成",
    "shotReady": "进入打靶状态完成", "collimationReady": "光路准直达标", "faultLock": "故障锁定", "commFault": "通信异常", "timeoutFault": "执行超时"
  },
  "context_defaults": {"fault_origin": null, "faults": [], "power_status": "unknown", "configuration": {"status": "unknown", "version": null}},
  "context_policy": {
    "fault_origin": "进入异常前的有效运行状态，由反馈适配层记录",
    "power_status": "unknown、on 或 off；上电检查成功后为 on，关机确认后为 off",
    "configuration": "参数资格的上下文记录，不替代当前状态",
    "faults": "所有已确认故障原因的集合；当前显示类别由 fault 下的叶子状态决定"
  },
  "actions": {
    "power_on_check": {
      "label": "上电检查",
      "requests": {"unchecked": "power-check.requested", "powerOnOk": "power-check.requested", "checkFailed": "power-check.requested", "shutdownNormal": "power-check.requested"},
      "success_events": {"unchecked": "power-check.passed", "powerOnOk": "power-check.passed", "checkFailed": "power-check.passed", "shutdownNormal": "power-check.passed"},
      "failure_events": {"unchecked": "power-check.failed", "powerOnOk": "power-check.failed", "checkFailed": "power-check.failed", "shutdownNormal": "power-check.failed"},
      "success_key": "上电检查通过", "failure_key": "上电检查未通过"
    },
    "function_check": {
      "label": "功能检查", "requests": {"powerOnOk": "function-check.requested", "checkFailed": "function-check.requested"},
      "success_events": {"powerOnOk": "qualification.confirmed", "checkFailed": "qualification.confirmed"},
      "failure_events": {"powerOnOk": "qualification.failed", "checkFailed": "qualification.failed"},
      "success_key": "功能检查通过", "failure_key": "功能检查未通过", "success_observation": "就绪"
    },
    "parameter_dispatch": {
      "label": "参数下发",
      "requests": {"functionReady": "configuration.requested", "parameterOk": "configuration.reconfiguration-accepted", "resetReady": "configuration.requested"},
      "success_events": {"functionReady": "configuration.validated", "parameterOk": "configuration.validated", "resetReady": "configuration.validated"},
      "failure_events": {"functionReady": null, "parameterOk": null, "resetReady": null},
      "success_key": "参数配置正常", "failure_key": "参数下发失败"
    },
    "optical_collimation": {
      "label": "光路准直", "requests": {"parameterOk": "multipass.collimation.requested"},
      "success_events": {"parameterOk": "multipass.collimation.completed"}, "failure_events": {"parameterOk": "multipass.collimation.failed"},
      "success_key": "光路准直达标", "failure_key": "光路准直失败"
    },
    "enter_shot_state": {
      "label": "进入打靶状态", "preconditions": ["光束引导完成", "流程层安全联锁正常"],
      "requests": {"collimationReady": "multipass.enter-shot.requested"}, "success_events": {"collimationReady": "multipass.enter-shot.completed"},
      "failure_events": {"collimationReady": "multipass.enter-shot.failed"}, "success_key": "进入打靶状态完成", "failure_key": "进入打靶状态失败"
    },
    "standby_reset": {
      "label": "多程待机/复位",
      "requests": {"functionReady": "multipass.standby.requested", "parameterOk": "multipass.standby.requested", "resetReady": "multipass.standby.requested", "shotReady": "multipass.standby.requested", "collimationReady": "multipass.standby.requested"},
      "success_events": {"functionReady": "multipass.standby.completed", "parameterOk": "multipass.standby.completed", "resetReady": "multipass.standby.completed", "shotReady": "multipass.standby.completed", "collimationReady": "multipass.standby.completed"},
      "failure_events": {"functionReady": null, "parameterOk": null, "resetReady": null, "shotReady": null, "collimationReady": null}, "success_key": "复位/待机完成", "failure_key": "复位/待机失败"
    },
    "shutdown": {
      "label": "关机",
      "requests": {"unchecked": "shutdown.requested", "powerOnOk": "shutdown.requested", "checkFailed": "shutdown.requested", "shutdownNormal": "shutdown.requested", "functionReady": "shutdown.requested", "parameterOk": "shutdown.requested", "resetReady": "shutdown.requested", "shotReady": "shutdown.requested", "collimationReady": "shutdown.requested", "faultLock": "shutdown.requested", "commFault": "shutdown.requested", "timeoutFault": "shutdown.requested"},
      "success_events": {"unchecked": "shutdown.confirmed", "powerOnOk": "shutdown.confirmed", "checkFailed": "shutdown.confirmed", "shutdownNormal": "shutdown.confirmed", "functionReady": "shutdown.confirmed", "parameterOk": "shutdown.confirmed", "resetReady": "shutdown.confirmed", "shotReady": "shutdown.confirmed", "collimationReady": "shutdown.confirmed", "faultLock": "shutdown.confirmed", "commFault": "shutdown.confirmed", "timeoutFault": "shutdown.confirmed"},
      "failure_events": {"unchecked": null, "powerOnOk": null, "checkFailed": null, "shutdownNormal": null, "functionReady": null, "parameterOk": null, "resetReady": null, "shotReady": null, "collimationReady": null, "faultLock": null, "commFault": null, "timeoutFault": null},
      "success_key": "关机正常", "failure_key": "关机失败"
    },
    "abort_reset": {
      "label": "异常中止复位",
      "requests": {"powerOnOk": "abort.requested", "functionReady": "abort.requested", "parameterOk": "abort.requested", "resetReady": "abort.requested", "shotReady": "abort.requested", "collimationReady": "abort.requested", "faultLock": "recovery.requested", "commFault": "recovery.requested", "timeoutFault": "recovery.requested"},
      "success_events": {"powerOnOk": "abort.completed", "functionReady": "abort.completed", "parameterOk": "abort.completed", "resetReady": "abort.completed", "shotReady": "abort.completed", "collimationReady": "abort.completed", "faultLock": "recovery.completed", "commFault": "recovery.completed", "timeoutFault": "recovery.completed"},
      "failure_events": {"powerOnOk": null, "functionReady": null, "parameterOk": null, "resetReady": null, "shotReady": null, "collimationReady": null, "faultLock": null, "commFault": null, "timeoutFault": null},
      "success_key": "安全复位完成", "failure_key": "安全复位失败"
    }
  },
  "confirmations": {
    "qualification_confirmed": {"label": "业务资格确认", "source_outer": ["notReady"], "machine_event": "qualification.confirmed", "observation": "就绪"},
    "qualification_invalidated": {"label": "业务资格失效确认", "source_outer": ["ready", "collimated"], "machine_event": "qualification.invalidated", "observation": "未就绪"},
    "configuration_invalidated": {"label": "参数配置失效确认", "source_outer": ["ready", "collimated"], "machine_event": "configuration.invalidated", "observation": "就绪"},
    "collimation_invalidated": {"label": "光路准直失效确认", "source_outer": ["collimated"], "machine_event": "multipass.collimation.invalidated", "observation": "就绪"},
    "shot_state_invalidated": {"label": "打靶状态失效确认", "source_outer": ["ready", "collimated"], "machine_event": "multipass.shot-state.invalidated", "observation": "就绪"},
    "shutdown_confirmed": {"label": "安全下电完成", "source_outer": ["notReady", "ready", "collimated"], "machine_event": "shutdown.confirmed", "observation": "未就绪"},
    "shutdown_while_fault_confirmed": {"label": "异常状态下安全下电完成", "source_outer": ["fault"], "machine_event": "shutdown.confirmed", "observation": "异常"},
    "fault_confirmed": {"label": "设备故障确认", "source_outer": ["notReady", "ready", "collimated", "fault"], "machine_event": "fault.confirmed", "observation": "异常"},
    "communication_fault_confirmed": {"label": "通信异常确认", "source_outer": ["notReady", "ready", "collimated", "fault"], "machine_event": "communication.failure-confirmed", "observation": "异常"},
    "timeout_confirmed": {"label": "执行超时确认", "source_outer": ["notReady", "ready", "collimated", "fault"], "machine_event": "execution.timeout-confirmed", "observation": "异常"},
    "recovery_confirmed": {"label": "异常恢复并完成安全复位", "source_outer": ["fault"], "machine_event": "recovery.completed", "observation": "未就绪"}
  }
}
    ]]></data>
  </datamodel>
</scxml>
