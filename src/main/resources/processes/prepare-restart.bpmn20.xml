        <bpmn:serviceTask id="seed_shutdown_prepare" flowable:expression="${devices.prepare(execution, 'seed_shutdown')}" name="预检所有目标" />
        <bpmn:subProcess id="seed_shutdown_instances" name="执行实例动作">
          <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${seedInstances}" flowable:elementVariable="deviceId" />
          <bpmn:startEvent id="seed_shutdown_device_start" name="开始" />
          <bpmn:serviceTask id="seed_shutdown_device_send" flowable:expression="${devices.enqueue(execution, 'seed_shutdown', deviceId)}" name="下发命令入队" />
          <bpmn:receiveTask id="seed_shutdown_device_wait" name="等待设备最终结果" />
          <bpmn:serviceTask id="seed_shutdown_device_verify" flowable:expression="${devices.verify(execution, 'seed_shutdown')}" name="验证设备结果" />
          <bpmn:endEvent id="seed_shutdown_device_end" name="完成" />
          <bpmn:sequenceFlow id="f112" sourceRef="seed_shutdown_device_start" targetRef="seed_shutdown_device_send" />
          <bpmn:sequenceFlow id="f113" sourceRef="seed_shutdown_device_send" targetRef="seed_shutdown_device_wait" />
          <bpmn:sequenceFlow id="f114" sourceRef="seed_shutdown_device_wait" targetRef="seed_shutdown_device_verify" />
          <bpmn:sequenceFlow id="f115" sourceRef="seed_shutdown_device_verify" targetRef="seed_shutdown_device_end" />
        </bpmn:subProcess>
        <bpmn:endEvent id="seed_shutdown_end" name="完成" />
        <bpmn:sequenceFlow id="f116" sourceRef="seed_shutdown_start" targetRef="seed_shutdown_prepare" />
        <bpmn:sequenceFlow id="f117" sourceRef="seed_shutdown_prepare" targetRef="seed_shutdown_instances" />
        <bpmn:sequenceFlow id="f118" sourceRef="seed_shutdown_instances" targetRef="seed_shutdown_end" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="seed_shutdown_timeout" attachedToRef="seed_shutdown" cancelActivity="true" name="执行超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT30S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="seed_shutdown_expired" name="抛出超时错误">
        <bpmn:errorEventDefinition errorRef="DeviceError" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="f119" sourceRef="seed_shutdown_timeout" targetRef="seed_shutdown_expired" />
