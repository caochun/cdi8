          <bpmn:sequenceFlow id="f123" sourceRef="shg_shutdown_device_wait" targetRef="shg_shutdown_device_verify" />
          <bpmn:sequenceFlow id="f124" sourceRef="shg_shutdown_device_verify" targetRef="shg_shutdown_device_end" />
        </bpmn:subProcess>
        <bpmn:endEvent id="shg_shutdown_end" name="完成" />
        <bpmn:sequenceFlow id="f125" sourceRef="shg_shutdown_start" targetRef="shg_shutdown_prepare" />
        <bpmn:sequenceFlow id="f126" sourceRef="shg_shutdown_prepare" targetRef="shg_shutdown_instances" />
