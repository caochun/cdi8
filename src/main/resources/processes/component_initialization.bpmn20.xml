<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:gxlf="https://cdi8.cn/bpmn/qualification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://cdi8.cn/control/v2">
  <bpmn:error id="device_error" errorCode="DEVICE_ERROR" />
  <bpmn:error id="qualification_error" errorCode="QUALIFICATION_INVALID" />
  <bpmn:message id="stop_message" name="StopWorkflow" />
  <bpmn:message id="qualification_lost_message" name="QualificationLost" />
  <bpmn:process id="component_initialization" isExecutable="true" name="组件初始化">
    <bpmn:startEvent id="start" name="开始" />
    <bpmn:subProcess id="normal" name="组件初始化">
      <bpmn:startEvent id="scope_start" name="开始" />
      <bpmn:endEvent id="scope_end" name="初始化完成" />
      <bpmn:serviceTask id="prepare_power" name="启动全体上电检查" flowable:expression="${qualification.prepare(execution, 'power_gate')}" />
      <bpmn:receiveTask id="power_gate" name="全体上电资格汇合">
        <bpmn:documentation>资格汇合网关：等待本轮全部命令成功，核验全体当前资格，并监控已取得资格失效。</bpmn:documentation>
        <bpmn:extensionElements>
          <gxlf:qualificationGateway targets="allComponents" action="power_on_check" state="powerOnOk|powerOnChecked" outer="notReady" continuationStates="notReady/powerOnOk|powerOnChecked notReady/checkFailed|qualificationInvalid ready/functionReady|qualified" timeout="${commandTimeout}" />
        </bpmn:extensionElements>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="power_gate_timeout" attachedToRef="power_gate" cancelActivity="true" name="上电资格等待超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${qualificationTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="power_timeout_reason" name="记录上电等待超时" flowable:expression="${qualification.timeout(execution, 'power_gate')}" />
      <bpmn:sequenceFlow id="power_gate_timeout__power_timeout_reason" sourceRef="power_gate_timeout" targetRef="power_timeout_reason" />
      <bpmn:sequenceFlow id="power_timeout_reason__raise_timeout" sourceRef="power_timeout_reason" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="prepare_power__power_gate" sourceRef="prepare_power" targetRef="power_gate" />
      <bpmn:sequenceFlow id="power_gate__prepare_function" sourceRef="power_gate" targetRef="prepare_function" name="全部有效">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qualificationGatePassed}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="power_gate__raise_failure" sourceRef="power_gate" targetRef="raise_failure" name="检查未通过">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!qualificationGatePassed}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="prepare_function" name="启动全体功能检查" flowable:expression="${qualification.prepare(execution, 'function_gate')}" />
      <bpmn:receiveTask id="function_gate" name="全体功能资格汇合">
        <bpmn:documentation>资格汇合网关：等待本轮全部命令成功，核验全体当前资格，并监控已取得资格失效。</bpmn:documentation>
        <bpmn:extensionElements>
          <gxlf:qualificationGateway targets="allComponents" action="function_check" state="functionReady|qualified" outer="ready" continuationStates="ready/functionReady|qualified" timeout="${commandTimeout}" />
        </bpmn:extensionElements>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="function_gate_timeout" attachedToRef="function_gate" cancelActivity="true" name="功能资格等待超时">
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${qualificationTimeout}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="function_timeout_reason" name="记录功能等待超时" flowable:expression="${qualification.timeout(execution, 'function_gate')}" />
      <bpmn:sequenceFlow id="function_gate_timeout__function_timeout_reason" sourceRef="function_gate_timeout" targetRef="function_timeout_reason" />
      <bpmn:sequenceFlow id="function_timeout_reason__raise_timeout" sourceRef="function_timeout_reason" targetRef="raise_timeout" />
      <bpmn:sequenceFlow id="prepare_function__function_gate" sourceRef="prepare_function" targetRef="function_gate" />
      <bpmn:sequenceFlow id="function_gate__finish" sourceRef="function_gate" targetRef="finish" name="全部有效">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qualificationGatePassed}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="function_gate__raise_failure" sourceRef="function_gate" targetRef="raise_failure" name="检查未通过">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!qualificationGatePassed}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="finish" name="确认初始化完成" flowable:expression="${qualification.finish(execution)}" />
      <bpmn:endEvent id="raise_failure" name="检查未通过">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:endEvent id="raise_timeout" name="等待超时">
        <bpmn:errorEventDefinition errorRef="device_error" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="scope_start__prepare_power" sourceRef="scope_start" targetRef="prepare_power" />
      <bpmn:sequenceFlow id="finish__scope_end" sourceRef="finish" targetRef="scope_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="success" name="流程成功" />
    <bpmn:serviceTask id="failure" name="记录流程失败" flowable:expression="${tango.failed(execution)}" />
    <bpmn:endEvent id="failed_end" name="流程停止">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="normal" cancelActivity="true" name="设备或动作失败">
      <bpmn:errorEventDefinition errorRef="device_error" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="error_boundary__failure" sourceRef="error_boundary" targetRef="failure" />
    <bpmn:boundaryEvent id="qualification_error_boundary" attachedToRef="normal" cancelActivity="true" name="资格核验失败">
      <bpmn:errorEventDefinition errorRef="qualification_error" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="qualification_error_boundary__failure" sourceRef="qualification_error_boundary" targetRef="failure" />
    <bpmn:boundaryEvent id="qualification_lost" attachedToRef="normal" cancelActivity="true" name="已取得资格失效">
      <bpmn:messageEventDefinition messageRef="qualification_lost_message" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="qualification_lost__failure" sourceRef="qualification_lost" targetRef="failure" />
    <bpmn:boundaryEvent id="stop_boundary" attachedToRef="normal" cancelActivity="true" name="停止流程">
      <bpmn:messageEventDefinition messageRef="stop_message" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="stop_boundary__failure" sourceRef="stop_boundary" targetRef="failure" />
    <bpmn:boundaryEvent id="workflow_timeout" attachedToRef="normal" cancelActivity="true" name="流程超时">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>${workflowTimeout}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="workflow_timeout__failure" sourceRef="workflow_timeout" targetRef="failure" />
    <bpmn:sequenceFlow id="start__normal" sourceRef="start" targetRef="normal" />
    <bpmn:sequenceFlow id="normal__success" sourceRef="normal" targetRef="success" />
    <bpmn:sequenceFlow id="failure__failed_end" sourceRef="failure" targetRef="failed_end" />
  </bpmn:process>
