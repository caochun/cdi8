        <bpmn:sequenceFlow id="multipass_power_start__send" sourceRef="multipass_power_start" targetRef="multipass_power_send"/>
        <bpmn:sequenceFlow id="multipass_power_send__wait" sourceRef="multipass_power_send" targetRef="multipass_power_wait"/>
        <bpmn:sequenceFlow id="multipass_power_wait__verify" sourceRef="multipass_power_wait" targetRef="multipass_power_verify"/>
